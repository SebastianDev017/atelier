*.json linguist-language=jsonc

# CRLF in a web asset is payload with no benefit: it added 2,283 bytes to
# base.css, which was enough on its own to push the file past theme check's
# 100,000-byte ceiling on any machine with core.autocrlf=true. Keep these LF
# in the working tree, so what gets packaged is what the repo holds.
*.css text eol=lf
*.js text eol=lf
*.liquid text eol=lf
*.json text eol=lf
