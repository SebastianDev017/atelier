{%- comment -%}
  Editorial product card. 3:4 media, second image on hover, sale +
  low-stock badges, quick add.

  @param {object} product - the product to render
  @param {string} [heading_tag] - h2/h3, default h3
  @param {boolean} [show_vendor] - overrides the global setting
  @param {boolean} [quick_add] - overrides the global setting
  @param {string} [sizes] - the image sizes attribute
  @param {number} [index] - forloop index (eager-loads the first few)
{%- endcomment -%}
{%- liquid
  assign heading_tag = heading_tag | default: 'h3'
  assign sizes = sizes | default: '(min-width: 990px) 24vw, (min-width: 750px) 32vw, 48vw'

  assign show_vendor = show_vendor | default: settings.card_show_vendor
  assign quick_add = quick_add
  if quick_add == nil
    assign quick_add = settings.card_quick_add
  endif

  assign variant = product.selected_or_first_available_variant
  assign compare_at = variant.compare_at_price | default: product.compare_at_price
  assign on_sale = false
  if compare_at and compare_at > variant.price
    assign on_sale = true
  endif

  assign primary = product.featured_media
  # Merchant-set focal point, applied as object-position so a cropped card
  # keeps the subject in frame instead of always centring.
  assign primary_focal = primary.preview_image.presentation.focal_point | default: '50% 50%'
  assign primary_focal = 'object-position: ' | append: primary_focal | append: ';'

  assign low_stock = false
  if settings.low_stock_threshold > 0 and variant.inventory_management != blank and variant.inventory_quantity > 0 and variant.inventory_quantity <= settings.low_stock_threshold
    assign low_stock = true
  endif

  assign loading = 'lazy'
  assign fetchpriority = 'auto'
  if index and index < 5
    assign fetchpriority = 'auto'
  endif

  assign quick_add_style = quick_add_style | default: 'hover'
-%}

{%- comment -%} Build the quick-add once; placed inside the media (hover mode) or after the info (always mode). {%- endcomment -%}
{%- capture quick_add_html -%}
  {%- if quick_add and product.available -%}
    {%- if product.variants.size == 1 -%}
      <product-form class="product-card__quick">
        {%- form 'product', product -%}
          <input type="hidden" name="id" value="{{ variant.id }}">
          <button type="submit" name="add" class="btn btn--small btn--full" data-add-button>
            <span data-add-label>{{ 'products.add_to_cart' | t }}</span>
          </button>
        {%- endform -%}
      </product-form>
    {%- else -%}
      <a href="{{ product.url }}" class="btn btn--small btn--full product-card__quick">
        {{- 'products.choose_options' | t -}}
      </a>
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

<div class="product-card product-card--atc-{{ quick_add_style }}" data-product-card data-swatch-root data-reveal>
  <div class="product-card__media">
    <div class="product-card__pan" data-card-pan>
    {%- comment -%} Filters are not allowed inside a filter argument: `alt: x | default: y` applies
      `default` to the whole image_tag output, so the fallback never ran and an image with no alt
      text lost the attribute entirely. The alt is resolved first. {%- endcomment -%}
    {%- assign primary_alt = primary.alt | default: product.title -%}
    {%- if primary -%}
      {{
        primary
        | image_url: width: 800
        | image_tag:
          loading: loading,
          fetchpriority: fetchpriority,
          widths: '200, 300, 400, 500, 600, 700, 800',
          sizes: sizes,
          class: 'product-card__image product-card__primary-img',
          style: primary_focal,
          alt: primary_alt
      }}
      {%- comment -%} Hover image renders only when a 2nd image exists, so single-image
        cards never fade their primary out (the :has() guards in base.css depend on this).
        The merchant toggle still applies; `!= false` keeps it on by default. {%- endcomment -%}
      {%- if settings.card_show_secondary_image != false and product.images.size > 1 -%}
        {%- assign hover_focal = product.images[1].presentation.focal_point | default: '50% 50%' -%}
        <img
          class="product-card__hover-img"
          src="{{ product.images[1] | image_url: width: 600 }}"
          alt="{{ product.images[1].alt | escape }}"
          loading="lazy"
          width="600"
          height="800"
          style="object-position: {{ hover_focal }};"
          aria-hidden="true"
        >
      {%- endif -%}
    {%- else -%}
      <span class="product-card__image product-card__primary-img product-card__image--only placeholder">
        {{- 'product-1' | placeholder_svg_tag: 'placeholder' -}}
      </span>
    {%- endif -%}
    </div>

    <div class="product-card__badges">
      {%- if on_sale -%}
        <span class="badge badge--sale">{{ 'products.on_sale' | t }}</span>
      {%- endif -%}
      {%- if low_stock -%}
        <span class="badge badge--stock">{{ 'products.low_stock_count' | t: count: variant.inventory_quantity }}</span>
      {%- endif -%}
      {%- unless product.available -%}
        <span class="badge badge--sold-out">{{ 'products.sold_out' | t }}</span>
      {%- endunless -%}
    </div>

    {%- comment -%}
      Quick buy (assets/quick-buy.js opens the product in a modal). Top-right
      of the image, above the whole-card link. Revealed on hover / keyboard
      focus where the device can hover, always shown on touch.
    {%- endcomment -%}
    {%- if settings.card_quick_buy != false -%}
      <div class="product-card__actions">
        <button
          type="button"
          class="product-card__action"
          data-quick-buy="{{ product.url }}"
          aria-haspopup="dialog"
          aria-label="{{ 'products.quick_buy_label' | t: title: product.title | escape }}"
          data-tooltip="{{ 'products.quick_buy' | t | escape }}"
        >
          {%- render 'icon', name: 'bag' -%}
        </button>
      </div>
    {%- endif -%}

    {%- comment -%} Hover mode: quick-add centered in an overlay revealed on hover. {%- endcomment -%}
    {%- if quick_add_style != 'always' and quick_add and product.available -%}
      <div class="product-card__overlay">{{ quick_add_html }}</div>
    {%- endif -%}
  </div>

  <div class="product-card__info">
    {%- if show_vendor and product.vendor != blank -%}
      <span class="product-card__vendor">{{ product.vendor | escape }}</span>
    {%- endif -%}

    <{{ heading_tag }} class="product-card__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </{{ heading_tag }}>

    {%- if product.metafields.custom.edition_number != blank -%}
      <span class="product-card__edition">{{ 'products.edition_number' | t: number: product.metafields.custom.edition_number }}</span>
    {%- endif -%}

    {%- if settings.card_show_rating and product.metafields.reviews.rating.value != blank -%}
      {%- assign rating = product.metafields.reviews.rating.value -%}
      <span class="product-card__rating" role="img" aria-label="{{ 'accessibility.star_rating_html' | t: rating: rating.rating, scale: rating.scale_max }}">
        {%- assign rounded = rating.rating | round -%}
        {%- for i in (1..5) -%}
          {%- if i <= rounded -%}{% render 'icon', name: 'star' %}{%- else -%}{% render 'icon', name: 'star-outline' %}{%- endif -%}
        {%- endfor -%}
        {%- if product.metafields.reviews.rating_count -%}
          <span class="caption">({{ product.metafields.reviews.rating_count }})</span>
        {%- endif -%}
      </span>
    {%- endif -%}

    {%- comment -%}
      Colour swatches. Each is a real link to that colour's variant, above the
      whole-card link (which is a sibling, so nothing is nested). Hovering or
      focusing one previews the variant's own image on the card
      (assets/product-card.js); a colour with no image of its own keeps the
      product image. Only values with swatch data from admin render.
    {%- endcomment -%}
    {%- liquid
      assign color_option = nil
      for opt in product.options_with_values
        assign opt_key = opt.name | downcase | strip
        if opt_key == 'color' or opt_key == 'colour'
          assign color_option = opt
          break
        endif
      endfor
    -%}
    {%- if color_option -%}
      {%- capture swatch_links -%}
        {%- for value in color_option.values -%}
          {%- if value.swatch -%}
            {%- liquid
              assign sw_variant = value.variant
              assign sw_url = product.url
              assign sw_media = nil
              if sw_variant
                assign sw_url = sw_variant.url
                assign sw_media = sw_variant.featured_media
              endif
            -%}
            <a
              class="product-card__swatch"
              href="{{ sw_url }}"
              aria-label="{{ color_option.name | escape }}: {{ value | escape }}"
              {%- if sw_media %}
                data-swatch-image="{{ sw_media | image_url: width: 800 }}"
                data-swatch-srcset="{{ sw_media | image_url: width: 400 }} 400w, {{ sw_media | image_url: width: 600 }} 600w, {{ sw_media | image_url: width: 800 }} 800w"
              {%- endif %}
            >
              {%- render 'swatch', value: value -%}
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if swatch_links != blank -%}
        <div class="product-card__swatches" data-swatch-group role="group" aria-label="{{ 'products.available_colors' | t }}">{{ swatch_links }}</div>
      {%- endif -%}
    {%- endif -%}

    {% render 'price', product: product, show_from: true %}
  </div>

  {%- comment -%} Whole-card click target. A real anchor (not a title ::after — the
    blur-reveal's will-change:filter on the h3 title makes its ::after only cover the
    heading). Decorative: the title <a> stays the accessible/keyboard link; the
    quick-add and title sit above this via z-index. {%- endcomment -%}
  <a class="product-card__link" href="{{ product.url }}" aria-label="{{ product.title | escape }}" tabindex="-1" aria-hidden="true"></a>

  {%- comment -%} Always mode: full-width button below the info. {%- endcomment -%}
  {%- if quick_add_style == 'always' -%}{{ quick_add_html }}{%- endif -%}
</div>
