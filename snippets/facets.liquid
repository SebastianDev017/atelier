{%- comment -%}
  Filter + sort form for collection and search results. Wrapped in
  <facet-form> which auto-submits on change (real submit buttons remain
  for JS-off). Keeps facets visible (not collapsed) per the brief.

  @param {object} results - collection or search object
  @param {string} context - 'collection' or 'search'
  @param {boolean} [enable_sorting]
  @param {boolean} [enable_filtering] - defaults to true when not passed
{%- endcomment -%}
{%- liquid
  assign active_count = 0
  for filter in results.filters
    assign active_count = active_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_count = active_count | plus: 1
      endif
    endif
  endfor
-%}
<facet-form class="facets-panel">
  <form data-facet-form>
    {%- if context == 'search' -%}
      <input type="hidden" name="q" value="{{ results.terms | escape }}">
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
    {%- endif -%}

    {%- if enable_sorting and context == 'collection' -%}
      {%- assign sort_by = results.sort_by | default: results.default_sort_by -%}
      <div class="facets-panel__sort field">
        <label class="field__label" for="SortBy">{{ 'collections.sort_by' | t }}</label>
        <div class="select">
          <select name="sort_by" id="SortBy">
            {%- for option in results.sort_options -%}
              <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
            {%- endfor -%}
          </select>
          {% render 'icon', name: 'chevron-down' %}
        </div>
      </div>
    {%- endif -%}

    {%- if active_count > 0 -%}
      <div class="facets-panel__active">
        <span class="eyebrow">{{ 'collections.filters' | t }}</span>
        <a class="link-underline facets-panel__clear" href="{{ results.url | default: request.path }}{% if context == 'search' %}?q={{ results.terms | url_encode }}&type=product{% endif %}">{{ 'collections.clear_all' | t }}</a>
      </div>
    {%- endif -%}

    {%- comment -%}
      enable_filtering is opt-out: callers that do not pass it (search) keep
      rendering filters. Comparing against false rather than using `default`,
      which treats false as blank.
    {%- endcomment -%}
    {%- unless enable_filtering == false -%}
    {%- for filter in results.filters -%}
      <details class="facets__group" open>
        <summary class="facets__summary">
          <span>{{ filter.label | escape }}</span>
          {% render 'icon', name: 'chevron-down' %}
        </summary>

        {%- case filter.type -%}
          {%- when 'boolean', 'list' -%}
            {%- comment -%}
              A Color filter (Search & Discovery, set to show swatches) arrives as
              presentation 'swatch' -- or 'image' for image swatches. Each value
              then shows as colour circles (below), from the same swatch data as
              the product pills. Shopify only lists values some
              product in the current results actually has.
            {%- endcomment -%}
            {%- liquid
              assign swatch_filter = false
              if filter.presentation == 'swatch' or filter.presentation == 'image'
                assign swatch_filter = true
              endif
            -%}
            {%- if swatch_filter -%}
              {%- comment -%}
                Swatch display: one circle per value, in the same 36px icon-button
                language as the grid/list view toggle. Each circle IS the value's
                checkbox (transparent, laid over the circle) so the facet form, the
                keyboard (Tab + Space) and the floating tooltip -- the colour name
                and count on hover and focus -- all work unchanged. Checked = the
                ring. A value Shopify gives no swatch data for keeps a text chip of
                the same height: a guessed colour is worse than a colour name.
              {%- endcomment -%}
              <ul class="facets__swatches" role="list">
                {%- for value in filter.values -%}
                  {%- liquid
                    assign value_name = value.label | escape
                    assign value_text = value.label | append: ' (' | append: value.count | append: ')' | escape
                    assign has_visual = false
                    if filter.presentation == 'swatch'
                      if value.swatch.color != blank or value.swatch.image != blank
                        assign has_visual = true
                      endif
                    elsif value.image != blank
                      assign has_visual = true
                    endif
                  -%}
                  <li>
                    <label class="facets__swatch-option{% unless has_visual %} facets__swatch-option--text{% endunless %}{% if value.active %} is-active{% endif %}{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                      <input
                        type="checkbox"
                        name="{{ value.param_name }}"
                        value="{{ value.value }}"
                        aria-label="{{ value_text }}"
                        {% if has_visual %}data-tooltip="{{ value_text }}"{% endif %}
                        {% if value.active %}checked{% endif %}
                        {% if value.count == 0 and value.active == false %}disabled{% endif %}
                      >
                      {%- if has_visual -%}
                        {%- if filter.presentation == 'image' -%}
                          {{ value.image | image_url: width: 64 | image_tag: alt: '', class: 'swatch', loading: 'lazy', decoding: 'async' }}
                        {%- else -%}
                          {% render 'swatch', value: value %}
                        {%- endif -%}
                      {%- else -%}
                        <span aria-hidden="true">{{ value_name }}</span>
                      {%- endif -%}
                    </label>
                  </li>
                {%- endfor -%}
              </ul>
            {%- else -%}
            <ul class="facets__list">
              {%- for value in filter.values -%}
                <li>
                  <label class="facets__option{% if value.active %} facets__option--active{% endif %}">
                    <input
                      type="checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      {% if value.active %}checked{% endif %}
                      {% if value.count == 0 and value.active == false %}disabled{% endif %}
                    >
                    <span>{{ value.label | escape }} ({{ value.count }})</span>
                  </label>
                </li>
              {%- endfor -%}
            </ul>
            {%- endif -%}

          {%- when 'price_range' -%}
            <div class="facets__price">
              <div class="field">
                <label class="field__label" for="Filter-{{ filter.label | handle }}-min">{{ 'collections.filter_min' | t }}</label>
                <input
                  class="input"
                  type="number"
                  inputmode="decimal"
                  id="Filter-{{ filter.label | handle }}-min"
                  name="{{ filter.min_value.param_name }}"
                  value="{%- if filter.min_value.value != nil -%}{%- render 'facet-price-value', cents: filter.min_value.value -%}{%- endif -%}"
                  placeholder="0"
                  min="0"
                  max="{%- render 'facet-price-value', cents: filter.range_max -%}"
                  step="0.01"
                >
              </div>
              <span class="facets__price-sep" aria-hidden="true">–</span>
              <div class="field">
                <label class="field__label" for="Filter-{{ filter.label | handle }}-max">{{ 'collections.filter_max' | t }}</label>
                <input
                  class="input"
                  type="number"
                  inputmode="decimal"
                  id="Filter-{{ filter.label | handle }}-max"
                  name="{{ filter.max_value.param_name }}"
                  value="{%- if filter.max_value.value != nil -%}{%- render 'facet-price-value', cents: filter.max_value.value -%}{%- endif -%}"
                  placeholder="{%- render 'facet-price-value', cents: filter.range_max -%}"
                  min="0"
                  max="{%- render 'facet-price-value', cents: filter.range_max -%}"
                  step="0.01"
                >
              </div>
            </div>
        {%- endcase -%}
      </details>
    {%- endfor -%}
    {%- endunless -%}

    <noscript>
      <button type="submit" class="btn btn--small btn--full">{{ 'collections.apply' | t }}</button>
    </noscript>
  </form>
</facet-form>

{% stylesheet %}
  .facets-panel { display: flex; flex-direction: column; gap: var(--space-4); }
  .facets-panel__sort { margin-bottom: var(--space-2); }
  .facets-panel__active { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .facets__price { display: flex; align-items: flex-end; gap: var(--space-3); padding-bottom: var(--space-4); }
  .facets__price .field { flex: 1; }
  .facets__price-sep { padding-bottom: 0.8em; }
{% endstylesheet %}
