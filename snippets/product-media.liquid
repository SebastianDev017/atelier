{%- comment -%}
  Product media gallery. Main stage with one active media + a thumbnail
  strip. <product-media-gallery> (product.js) switches the active media
  on thumbnail click and on variant change.

  @param {object} product
  @param {object} section

  B4 -- image fit. The stage used to crop EVERY image to 3:4 with object-fit:
  cover, and the theme has no zoom or lightbox, so a product photo of any other
  shape could never be seen whole: a 3:2 shot lost half its width, a panorama
  about 80% (Theme Store: "All product images must be displayed and viewable").
  "adapt" (default) sizes the stage to the FIRST media's own ratio and shows
  every image whole (contain). One ratio for the whole stage, not one per image,
  so switching media never changes the stage height and the thumbnails never
  jump under the pointer. The ratio is clamped to 1:2 .. 1.6:1 so a freak upload
  cannot turn the stage into a sliver or a tower; beyond the clamp the image is
  letterboxed, still whole. "crop" is the old 3:4 fill, with the focal point.
{%- endcomment -%}
{%- liquid
  assign media_fit = section.settings.media_fit | default: 'adapt'

  # QW1 -- the media shown first, decided ONCE and used by both the stage and the
  # thumbnail strip. The stage followed the selected variant's image while the
  # thumbnails highlighted forloop.first, so on load the highlighted thumb and
  # the big photo disagreed on 3 of 4 multi-photo products until a variant was
  # clicked.
  assign active_media_id = product.media.first.id
  if product.selected_or_first_available_variant.featured_media
    assign active_media_id = product.selected_or_first_available_variant.featured_media.id
  endif
  assign gallery_ratio = 0.75
  if media_fit == 'adapt' and product.media.size > 0
    assign gallery_ratio = product.media.first.preview_image.aspect_ratio | default: 0.75 | at_least: 0.5 | at_most: 1.6
  endif
-%}
<product-media-gallery
  class="product-media product-media--{{ media_fit }}"
  data-product-media
  style="--gallery-ratio: {{ gallery_ratio }};"
>
  <div class="product-media__stage">
    {%- if product.media.size > 0 -%}
      {%- for media in product.media -%}
        {%- liquid
          assign is_active = false
          if media.id == active_media_id
            assign is_active = true
          endif

          if forloop.first
            assign img_loading = 'eager'
            assign img_priority = 'high'
          else
            assign img_loading = 'lazy'
            assign img_priority = 'auto'
          endif

          assign media_alt = media.alt | default: product.title | escape
        -%}
        <div
          class="product-media__item{% if is_active %} is-active{% endif %}"
          data-media-id="{{ media.id }}"
        >
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {%- comment -%}
                The focal point is a crop hint. A whole (contained) image has nothing
                cropped, and a focal point would only push it off-centre inside its
                letterbox, so it is applied in crop mode only.
              {%- endcomment -%}
              {%- assign media_focal_style = '' -%}
              {%- if media_fit == 'crop' -%}
                {%- assign media_focal = media.preview_image.presentation.focal_point | default: '50% 50%' -%}
                {%- assign media_focal_style = 'object-position: ' | append: media_focal | append: ';' -%}
              {%- endif -%}
              {{
                media
                | image_url: width: 1500
                | image_tag:
                  loading: img_loading,
                  fetchpriority: img_priority,
                  widths: '400, 600, 800, 1000, 1200, 1500',
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  alt: media_alt,
                  class: 'product-media__image',
                  style: media_focal_style
              }}
            {%- when 'video' -%}
              {{ media | video_tag: image_size: '1000x', controls: true, loop: false, class: 'product-media__video' }}
            {%- when 'external_video' -%}
              {{ media | external_video_tag: class: 'product-media__video', loading: 'lazy' }}
            {%- when 'model' -%}
              {{ media | model_viewer_tag: image_size: '1000x', reveal: 'interaction', toggleable: true }}
            {%- else -%}
              {{ media | media_tag: image_size: '1000x' }}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="product-media__item is-active media media--product">
        {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
      </div>
    {%- endif -%}
  </div>

  {%- if product.media.size > 1 -%}
    <div class="product-media__thumbs" role="group" aria-label="{{ 'accessibility.product_media' | t }}">
      {%- for media in product.media -%}
        <button
          type="button"
          class="product-media__thumb{% if media.id == active_media_id %} is-active{% endif %}"
          {% if media.id == active_media_id %}aria-current="true"{% endif %}
          data-media-thumb="{{ media.id }}"
          aria-label="{{ media.alt | default: product.title | escape }} — {{ forloop.index }}"
        >
          {{
            media.preview_image
            | image_url: width: 200
            | image_tag:
              loading: 'lazy',
              widths: '100, 160, 200',
              sizes: '80px',
              alt: '',
              class: 'product-media__thumb-image'
          }}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</product-media-gallery>

{% stylesheet %}
  .product-media { display: flex; flex-direction: column; gap: var(--space-3); }
  .product-media__stage { position: relative; }
  .product-media__item { display: none; aspect-ratio: var(--ratio-product); overflow: hidden; background-color: var(--color-subtle); }
  .product-media__item.is-active { display: block; }
  .product-media__image { width: 100%; height: 100%; object-fit: cover; }
  /* adapt: the stage takes the first image's shape; every image is shown whole.
     max-height keeps a tall first image inside the viewport. The explicit width
     matters: without it max-height is carried through aspect-ratio into a max
     WIDTH, and the stage shrank to a narrow column hugging the left edge. With it
     the stage keeps the column width and the image is letterboxed, never cut. */
  .product-media--adapt .product-media__item { width: 100%; aspect-ratio: var(--gallery-ratio, 0.75); max-height: 85vh; }
  .product-media--adapt .product-media__image { object-fit: contain; }
  /* CRIT2 -- in the single-column layout the photo sits ABOVE the buy box, so its
     height is the price of reaching Add to cart. Uncapped, a 4:5 photo filled 409px
     of a 375x812 phone and a 9:16 one 580px, and nothing purchasable was on the first
     screen. Capped at 40% of the small viewport on phones (50% on tablets). In
     "Show whole image" mode the photo is still shown WHOLE -- a taller photo is
     letterboxed inside the capped stage (object-fit: contain), never cut -- so the
     B4 principle holds; only the stage gets shorter. The explicit width keeps
     max-height from being carried through aspect-ratio into a narrow column. */
  @media (max-width: 989px) {
    .product-media__item { width: 100%; max-height: 50svh; }
    .product-media--adapt .product-media__item { max-height: 50svh; }
  }
  @media (max-width: 767px) {
    .product-media__item,
    .product-media--adapt .product-media__item { max-height: 40svh; }
  }
  .product-media__video { width: 100%; height: 100%; object-fit: contain; background-color: var(--color-black); }

  .product-media__thumbs {
    display: grid;
    /* 52px on phones: five thumbnails a row at 375px instead of four, 17px less
       height between the photo and the title. 750+ keeps 80px. */
    grid-template-columns: repeat(auto-fill, minmax(52px, 1fr));
    gap: var(--space-2);
  }
  .product-media__thumb {
    aspect-ratio: var(--ratio-square);
    overflow: hidden;
    border: 1px solid transparent;
    background-color: var(--color-subtle);
    transition: border-color var(--duration-fast) var(--ease-editorial);
  }
  .product-media__thumb-image { width: 100%; height: 100%; object-fit: cover; }
  .product-media__thumb.is-active { border-color: var(--color-text); }

  @media (min-width: 750px) {
    .product-media__thumbs { grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); }
  }
{% endstylesheet %}
