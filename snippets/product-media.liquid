{%- comment -%}
  Product media gallery. Main stage with one active media + a thumbnail
  strip. <product-media-gallery> (product.js) switches the active media
  on thumbnail click and on variant change.

  @param {object} product
  @param {object} section
  @param {string} [desktop_size] - the width the stage is drawn at from 990px
    up, for the image sizes attribute. Defaults to 50vw, the product page's
    column. The quick-buy modal passes its own fixed width.

  B4 -- image fit. The stage used to crop EVERY image to 3:4 with object-fit:
  cover, and the theme has no zoom or lightbox, so a product photo of any other
  shape could never be seen whole: a 3:2 shot lost half its width, a panorama
  about 80% (Theme Store: "All product images must be displayed and viewable").
  "adapt" (default) sizes the stage to the FIRST media's own ratio and shows
  every image whole (contain). One ratio for the whole stage, not one per image,
  so switching media never changes the stage height and the thumbnails never
  jump under the pointer. The ratio is clamped to 1:2 .. 1.6:1 so a freak upload
  cannot turn the stage into a sliver or a tower; beyond the clamp the image is
  letterboxed, still whole. "crop" is the old 3:4 fill, with the focal point.
{%- endcomment -%}
{%- liquid
  assign media_fit = section.settings.media_fit | default: 'adapt'

  # QW1 -- the media shown first, decided ONCE and used by both the stage and the
  # thumbnail strip. The stage followed the selected variant's image while the
  # thumbnails highlighted forloop.first, so on load the highlighted thumb and
  # the big photo disagreed on 3 of 4 multi-photo products until a variant was
  # clicked.
  assign active_media_id = product.media.first.id
  if product.selected_or_first_available_variant.featured_media
    assign active_media_id = product.selected_or_first_available_variant.featured_media.id
  endif
  # Loading priority follows the section's position, per Shopify's section.index
  # guidance. On the product page this gallery is the LCP element and loads
  # eagerly at high priority. The featured-product section renders the same
  # snippet, and mid-homepage (Annex: section 7 of 10) it is far below the fold
  # -- there it has to load lazily, at normal priority, or it competes with the
  # hero. Below the fold is tested as a positive "index > 2" so that nil falls
  # to the eager side: nil is the theme editor, and the Section Rendering API
  # that fills the quick-buy modal, where this image is the thing just asked for.
  assign gallery_below_fold = false
  if section.index > 2
    assign gallery_below_fold = true
  endif
  assign desktop_size = desktop_size | default: '50vw'

  assign gallery_ratio = 0.75
  if media_fit == 'adapt' and product.media.size > 0
    assign gallery_ratio = product.media.first.preview_image.aspect_ratio | default: 0.75 | at_least: 0.5 | at_most: 1.6
  endif
-%}
<product-media-gallery
  class="product-media product-media--{{ media_fit }}"
  data-product-media
  style="--gallery-ratio: {{ gallery_ratio }};"
>
  <div class="product-media__stage">
    {%- if product.media.size > 0 -%}
      {%- for media in product.media -%}
        {%- liquid
          assign is_active = false
          if media.id == active_media_id
            assign is_active = true
          endif

          # The image on screen at load is the LCP element: it gets the eager load
          # and the high fetch priority. That is the ACTIVE media (the selected
          # variant's photo since QW1), not necessarily the first one -- keying this
          # on forloop.first left the visible photo lazy and pushed mobile LCP to ~6s.
          if is_active and gallery_below_fold == false
            assign img_loading = 'eager'
            assign img_priority = 'high'
          else
            assign img_loading = 'lazy'
            assign img_priority = 'auto'
          endif

          assign media_alt = media.alt | default: product.title | escape
        -%}
        <div
          class="product-media__item{% if is_active %} is-active{% endif %}"
          data-media-id="{{ media.id }}"
          data-media-type="{{ media.media_type }}"
        >
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {%- comment -%}
                The focal point is a crop hint. A whole (contained) image has nothing
                cropped, and a focal point would only push it off-centre inside its
                letterbox, so it is applied in crop mode only.
              {%- endcomment -%}
              {%- assign media_focal_style = '' -%}
              {%- if media_fit == 'crop' -%}
                {%- assign media_focal = media.preview_image.presentation.focal_point | default: '50% 50%' -%}
                {%- assign media_focal_style = 'object-position: ' | append: media_focal | append: ';' -%}
              {%- endif -%}
              {%- comment -%}
                sizes = the width the photo is really drawn at, so a phone does not
                download a desktop file. Below 990px the stage is capped at 50svh
                (40svh under 768px) and in adapt mode the photo is contained, so it
                is drawn at min(column width, cap x its own aspect ratio): a 4:5
                photo on a phone is ~260px wide, not 100vw. Crop mode fills the
                stage, so there the column width is the answer.
              {%- endcomment -%}
              {%- liquid
                assign media_sizes = '(min-width: 990px) ' | append: desktop_size | append: ', 100vw'
                if media_fit == 'adapt'
                  assign media_ar = media.preview_image.aspect_ratio | default: 1 | round: 3
                  assign media_sizes = '(min-width: 990px) ' | append: desktop_size | append: ', (min-width: 768px) min(100vw, calc(50vh * ' | append: media_ar | append: ')), min(100vw, calc(40vh * ' | append: media_ar | append: '))'
                endif
              -%}
              {{
                media
                | image_url: width: 1500
                | image_tag:
                  loading: img_loading,
                  fetchpriority: img_priority,
                  widths: '400, 600, 800, 1000, 1200, 1500',
                  sizes: media_sizes,
                  alt: media_alt,
                  class: 'product-media__image',
                  style: media_focal_style
              }}
            {%- when 'video' -%}
              {{ media | video_tag: image_size: '1000x', controls: true, loop: false, class: 'product-media__video' }}
            {%- when 'external_video' -%}
              {{ media | external_video_tag: class: 'product-media__video', loading: 'lazy', decoding: 'async' }}
            {%- when 'model' -%}
              {{ media | model_viewer_tag: image_size: '1000x', reveal: 'interaction', toggleable: true }}
              {%- comment -%}
                "View in your space". The Shopify-XR library scans the DOM for
                [data-shopify-xr] and attaches the launcher itself; until it has
                run and confirmed the device can open AR, data-shopify-xr-hidden
                keeps the button off the page -- which is why it appears on a
                phone and not on a desktop. One button per model, inside that
                model's own slot, so it is only on screen while the model is.
              {%- endcomment -%}
              <button
                type="button"
                class="product-media__xr"
                data-shopify-xr
                data-shopify-model3d-id="{{ media.id }}"
                data-shopify-title="{{ product.title | escape }}"
                data-shopify-xr-hidden
              >
                {%- render 'icon', name: 'cube' -%}
                <span>{{ 'products.view_in_space' | t }}</span>
              </button>
            {%- else -%}
              {{ media | media_tag: image_size: '1000x' }}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="product-media__item is-active media media--product">
        {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
      </div>
    {%- endif -%}
  </div>

  {%- liquid
    assign product_models = product.media | where: 'media_type', 'model'
  -%}
  {%- if product_models.size > 0 -%}
    {%- comment -%}
      ShopifyXR.addModels() needs the model media objects themselves. product.js
      reads this when the gallery connects, which is also how the copy injected
      into the quick-buy modal registers its models -- a <script> inside fetched
      markup never executes, but a custom element still upgrades.
    {%- endcomment -%}
    <script type="application/json" data-product-models>
      {{ product_models | json }}
    </script>
  {%- endif -%}

  {%- if product.media.size > 1 -%}
    <div class="product-media__thumbs" role="group" aria-label="{{ 'accessibility.product_media' | t }}">
      {%- for media in product.media -%}
        <button
          type="button"
          class="product-media__thumb{% if media.id == active_media_id %} is-active{% endif %}"
          {% if media.id == active_media_id %}aria-current="true"{% endif %}
          data-media-thumb="{{ media.id }}"
          aria-label="{{ media.alt | default: product.title | escape }} — {{ forloop.index }}"
        >
          {{
            media.preview_image
            | image_url: width: 200
            | image_tag:
              loading: 'lazy', decoding: 'async',
              fetchpriority: 'low',
              widths: '100, 160, 200',
              sizes: '80px',
              alt: '',
              class: 'product-media__thumb-image'
          }}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</product-media-gallery>

{% stylesheet %}
  .product-media { display: flex; flex-direction: column; gap: var(--space-3); }
  .product-media__stage { position: relative; }
  .product-media__item { display: none; position: relative; aspect-ratio: var(--ratio-product); overflow: hidden; background-color: var(--color-subtle); }
  .product-media__item.is-active { display: block; }
  .product-media__image { width: 100%; height: 100%; object-fit: cover; }
  /* adapt: the stage takes the first image's shape; every image is shown whole.
     max-height keeps a tall first image inside the viewport. The explicit width
     matters: without it max-height is carried through aspect-ratio into a max
     WIDTH, and the stage shrank to a narrow column hugging the left edge. With it
     the stage keeps the column width and the image is letterboxed, never cut. */
  .product-media--adapt .product-media__item { width: 100%; aspect-ratio: var(--gallery-ratio, 0.75); max-height: 85vh; }
  .product-media--adapt .product-media__image { object-fit: contain; }
  /* CRIT2 -- in the single-column layout the photo sits ABOVE the buy box, so its
     height is the price of reaching Add to cart. Uncapped, a 4:5 photo filled 409px
     of a 375x812 phone and a 9:16 one 580px, and nothing purchasable was on the first
     screen. Capped at 40% of the small viewport on phones (50% on tablets). In
     "Show whole image" mode the photo is still shown WHOLE -- a taller photo is
     letterboxed inside the capped stage (object-fit: contain), never cut -- so the
     B4 principle holds; only the stage gets shorter. The explicit width keeps
     max-height from being carried through aspect-ratio into a narrow column. */
  @media (max-width: 989px) {
    .product-media__item { width: 100%; max-height: 50svh; }
    .product-media--adapt .product-media__item { max-height: 50svh; }
  }
  @media (max-width: 767px) {
    .product-media__item,
    .product-media--adapt .product-media__item { max-height: 40svh; }
  }
  .product-media__video { width: 100%; height: 100%; object-fit: contain; background-color: var(--color-black); }
  /* external_video_tag returns an iframe and model_viewer_tag a <model-viewer>;
     neither obeys object-fit, so each fills its slot, and the slot already
     carries the stage's ratio. */
  .product-media__item iframe,
  .product-media__item model-viewer { display: block; width: 100%; height: 100%; border: 0; background-color: var(--color-subtle); }
  /* Shopify.ModelViewerUI moves the viewer into a wrapper of its own whose CSS
     is `position: relative; display: inline-block` and nothing else -- measured
     at 0x0, which collapsed the viewer with it, because Shopify leaves the
     sizing to the theme. Two classes deep so it outranks that stylesheet, which
     is injected at runtime and therefore lands after this one. */
  .product-media__item .shopify-model-viewer-ui { display: block; width: 100%; height: 100%; }

  /* AR. Ships hidden: Shopify-XR removes data-shopify-xr-hidden only on a
     device that can actually launch AR, so this one rule is the whole
     show/hide decision -- nothing in the theme guesses at device support. */
  .product-media__xr[data-shopify-xr-hidden] { display: none; }
  .product-media__xr {
    position: absolute;
    left: 50%;
    bottom: var(--space-3);
    transform: translateX(-50%);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    /* 44px: the tap target minimum every other control in this theme holds to. */
    min-height: 44px;
    padding-inline: var(--space-4);
    border: 1px solid var(--color-text);
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .product-media__xr .icon { width: 16px; height: 16px; flex-shrink: 0; }

  .product-media__thumbs {
    display: grid;
    /* 52px on phones: five thumbnails a row at 375px instead of four, 17px less
       height between the photo and the title. 750+ keeps 80px. */
    grid-template-columns: repeat(auto-fill, minmax(52px, 1fr));
    gap: var(--space-2);
  }
  .product-media__thumb {
    aspect-ratio: var(--ratio-square);
    overflow: hidden;
    border: 1px solid transparent;
    background-color: var(--color-subtle);
    transition: border-color var(--duration-fast) var(--ease-editorial);
  }
  .product-media__thumb-image { width: 100%; height: 100%; object-fit: cover; }
  .product-media__thumb.is-active { border-color: var(--color-text); }

  @media (min-width: 750px) {
    .product-media__thumbs { grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); }
  }
{% endstylesheet %}
