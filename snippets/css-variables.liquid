{%- comment -%}
  Bridges theme settings to the CSS custom properties consumed by base.css
  and every section. Fonts are loaded with the font_face filter (never
  font_url) and guarded so a missing font never breaks the cascade.
  Also emits the Animations & Experience, per-level heading size, and link
  colour variables (STEP 4).
{%- endcomment -%}
{%- liquid
  assign heading_font = settings.heading_font
  assign body_font = settings.body_font
  assign body_medium = body_font | font_modify: 'weight', '500'
  assign body_semibold = body_font | font_modify: 'weight', '600'
  assign body_italic = body_font | font_modify: 'style', 'italic'
  comment
    Clamp the heading weight into the editorial 300-400 range so a heavier
    font_picker choice can never break the austere identity.
  endcomment
  assign heading_weight = heading_font.weight | at_most: 400 | at_least: 300
  if settings.animation_speed == 'fast'
    assign speed_mult = 0.5
  elsif settings.animation_speed == 'slow'
    assign speed_mult = 1.5
  else
    assign speed_mult = 1
  endif
-%}
{% style %}
  {% if heading_font.family != blank %}
    {{ heading_font | font_face: font_display: 'swap' }}
  {% endif %}
  {% if body_font.family != blank %}
    {{ body_font | font_face: font_display: 'swap' }}
    {% if body_medium %}{{ body_medium | font_face: font_display: 'swap' }}{% endif %}
    {% if body_semibold %}{{ body_semibold | font_face: font_display: 'swap' }}{% endif %}
    {% if body_italic %}{{ body_italic | font_face: font_display: 'swap' }}{% endif %}
  {% endif %}

  :root {
    {%- comment -%}
      No `| json` here. Shopify's font drop already returns multi-word family
      names pre-quoted, so json double-wrapped them into "\"EB Garamond\"" --
      invalid CSS, which silently fell back to the generic family. The bug was
      masked while base.css won the cascade; it is live now that these
      declarations do.
    {%- endcomment -%}
    {% if heading_font.family != blank %}
      --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      --font-heading-weight: {{ heading_weight }};
    {% endif %}
    {% if body_font.family != blank %}
      --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
      --font-body-weight: {{ body_font.weight }};
    {% endif %}

    {%- comment -%}
      Page-level palette: the Background scheme (id background-1, else the
      first scheme). Everything outside a section -- the body, drawers,
      dialogs, the account sheet -- reads these, so it matches the scheme most
      sections use. Each value keeps an explicit blank check: a Color drop that
      is unset is not treated as blank by `| default`.
    {%- endcomment -%}
    {%- liquid
      assign page_scheme = null
      for scheme in settings.color_schemes
        if forloop.first
          assign page_scheme = scheme
        endif
        if scheme.id == 'background-1'
          assign page_scheme = scheme
          break
        endif
      endfor
      assign ps = page_scheme.settings
    -%}
    --color-background: {% if ps.background != blank %}{{ ps.background }}{% else %}#FAF7F2{% endif %};
    --color-foreground: {% if ps.text != blank %}{{ ps.text }}{% else %}#2C1810{% endif %};
    --color-accent: {% if ps.accent != blank %}{{ ps.accent }}{% else %}#766356{% endif %};
    --color-heading: {% if ps.text != blank %}{{ ps.text }}{% else %}#2C1810{% endif %};
    --color-body: {% if ps.body != blank %}{{ ps.body }}{% else %}#5C3D2E{% endif %};
    --color-muted: {% if ps.muted != blank %}{{ ps.muted }}{% else %}#766356{% endif %};
    {% if ps.border != blank %}--color-border-setting: {{ ps.border }};{% endif %}
    {% if ps.button != blank %}--color-button: {{ ps.button }};{% endif %}
    {% if ps.button_label != blank %}--color-button-text: {{ ps.button_label }};{% endif %}

    --page-width: {{ settings.page_width }}px;
    --page-margin: {{ settings.page_margin }}px;
    --header-height: {{ settings.header_height }}px;
    --sidebar-width: {{ settings.sidebar_width }}px;
    --sidebar-width-expanded: {{ settings.sidebar_width }}px;
    --section-spacing: {{ settings.section_spacing }}px;
    --radius-inputs: {{ settings.input_corner_radius }}px;

    --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
    --body-scale: {{ settings.body_scale | divided_by: 100.0 }};

    --uppercase-headings: {% if settings.uppercase_headings %}uppercase{% else %}none{% endif %};
    --uppercase-nav: {% if settings.uppercase_nav %}uppercase{% else %}none{% endif %};
    --uppercase-buttons: {% if settings.uppercase_buttons %}uppercase{% else %}none{% endif %};

    {%- comment -%} Per-level heading sizes compound with the global --heading-scale; tracking + link colours + experience toggles. {%- endcomment -%}
    --h1-scale: {{ settings.h1_scale | default: 100 | divided_by: 100.0 }};
    --h2-scale: {{ settings.h2_scale | default: 100 | divided_by: 100.0 }};
    --h3-scale: {{ settings.h3_scale | default: 100 | divided_by: 100.0 }};
    {%- comment -%}
      Emitted only when the merchant has moved this off its default (-2). The
      heading classes below carry their own designed tracking as the var's
      fallback, so emitting it unconditionally would flatten the whole type
      scale to a single value.
    {%- endcomment -%}
    {%- if settings.letter_spacing_headings != -2 -%}
      --heading-letter-spacing: {{ settings.letter_spacing_headings | times: 0.01 }}em;
    {%- endif -%}

    {%- comment -%} Links are the scheme's text; the hover fades toward the ground (same rule as every scheme below). {%- endcomment -%}
    --color-link: var(--color-foreground);
    --color-link-hover: color-mix(in srgb, var(--color-foreground) 70%, var(--color-background));

    --animation-speed: {{ speed_mult }};
    /* Scale the motion tokens by the chosen speed. --animation-speed alone was
       read nowhere, so the control had no effect at all. Computed in Liquid so
       the values stay plain durations for anything that parses them. */
    --duration-fast: {{ 250 | times: speed_mult | round }}ms;
    --duration-base: {{ 300 | times: speed_mult | round }}ms;
    --duration-slow: {{ 400 | times: speed_mult | round }}ms;
    --duration-slower: {{ 600 | times: speed_mult | round }}ms;
    --grain-opacity: {{ settings.grain_opacity | default: 4 | divided_by: 100.0 }};
    --grain-display: {% if settings.enable_grain_texture == false %}none{% else %}block{% endif %};

    {%- case settings.cursor_size -%}
      {%- when 'sm' -%}{%- assign cursor_px = 8 -%}
      {%- when 'lg' -%}{%- assign cursor_px = 16 -%}
      {%- else -%}{%- assign cursor_px = 12 -%}
    {%- endcase -%}
    --cursor-size: {{ cursor_px }}px;
    --image-radius: {{ settings.image_border_radius | default: 0 }}px;
    --image-border: {% if settings.image_border_enable %}{{ settings.image_border_width | default: 1 }}px solid {% if settings.image_border_color != blank %}{{ settings.image_border_color }}{% else %}#E5DDD0{% endif %}{% else %}none{% endif %};
  }

  {%- comment -%}
    Color schemes (settings_schema.json > Colors, a color_scheme_group). Every
    section's color_scheme setting is a scheme id, rendered as
    .color-scheme--<id>; each preset supplies its own values for the same six
    ids (background-1, background-2, background-3, surface, inverse,
    accent-1), so "Change theme style" swaps real colours, not labels.

    Tokens a scheme does not store are derived here, from its own colours,
    so they always track the scheme they sit in -- --color-border-strong,
    --color-subtle and --color-media used to be computed once on :root and
    stayed espresso-based inside the dark scheme. The sale red and the link
    hover use Liquid's color_brightness to stay legible on any ground:
    dark grounds mix the red toward the light text, mid-tone grounds (Maison's
    gold) fall back to the text colour itself, and light grounds keep the red.
  {%- endcomment -%}
  {%- for scheme in settings.color_schemes -%}
    {%- liquid
      assign s = scheme.settings
      assign ground = s.background | color_brightness
      if ground < 110
        assign sale = '#B23A2E' | color_mix: s.text, 70
        assign link_hover = s.text | color_mix: s.background, 70
      elsif ground < 190
        assign sale = s.text
        assign link_hover = s.text
      elsif ground < 225
        assign sale = '#B23A2E' | color_mix: s.text, 85
        assign link_hover = s.text | color_mix: s.background, 70
      else
        assign sale = '#B23A2E'
        assign link_hover = s.text | color_mix: s.background, 70
      endif
    -%}
    .color-scheme--{{ scheme.id }} {
      --color-bg: {{ s.background }};
      --color-text: {{ s.text }};
      --color-heading: {{ s.text }};
      --color-body: {{ s.body }};
      --color-muted: {{ s.muted }};
      --color-accent-local: {{ s.accent }};
      --color-border: {{ s.border }};
      --color-border-strong: {{ s.text | color_mix: s.background, 50 }};
      --color-subtle: {{ s.text | color_mix: s.background, 6 }};
      --color-media: {{ s.text | color_mix: s.background, 5 }};
      --color-button: {{ s.button }};
      --color-button-text: {{ s.button_label }};
      --color-link: {{ s.text }};
      --color-link-hover: {{ link_hover }};
      --color-sale: {{ sale }};
      background-color: var(--color-bg);
      color: var(--color-text);
    }
    {%- if ground < 110 %}
      {%- comment -%} Dark grounds: badges invert (was .color-scheme--invert only). {%- endcomment %}
      .color-scheme--{{ scheme.id }} .badge--sale { background-color: var(--color-text); color: var(--color-bg); }
      .color-scheme--{{ scheme.id }} .badge--stock { background-color: transparent; color: var(--color-text); border-color: var(--color-text); }
    {%- endif %}
  {%- endfor %}
{% endstyle %}
