{%- comment -%}
  Reviews: install Judge.me (free) from the Shopify App Store.
  After installing, add the Judge.me app block to this template
  via Online Store → Themes → Customize → Product page.
{%- endcomment -%}
{%- liquid
  assign scheme = section.settings.color_scheme | default: 'cream'
  assign product = product
  assign selected_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
-%}

<style>
  #shopify-section-{{ section.id }} {
    --product-media-width: {{ section.settings.media_width }}%;
  }
</style>

<product-info
  class="product section-wrapper color-scheme--{{ scheme }}"
  style="--pt: {{ section.settings.padding_top | default: 64 }}px; --pb: {{ section.settings.padding_bottom | default: 64 }}px;"
  data-product-info
  data-section-id="{{ section.id }}"
  data-url="{{ product.url }}"
  data-update-url="{{ section.settings.update_url }}"
  data-add-text="{{ 'products.add_to_cart' | t | escape }}"
  data-sold-out-text="{{ 'products.sold_out' | t | escape }}"
  data-unavailable-text="{{ 'products.unavailable' | t | escape }}"
>
  <div class="product__grid section__inner">
    <div class="product__media-col">
      {% render 'product-media', product: product, section: section %}
    </div>

    <div class="product__details-col">
      <div class="product__details">
        {% render 'breadcrumbs', current: product.title %}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'vendor' -%}
              {%- if product.vendor != blank -%}
                <p class="product__vendor eyebrow" {{ block.shopify_attributes }}>{{ product.vendor | escape }}</p>
              {%- endif -%}

            {%- when 'title' -%}
              <h1 class="product__title h2" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

            {%- when 'price' -%}
              <div class="product__price" {{ block.shopify_attributes }}>
                <div data-price-target aria-live="polite">
                  {% render 'price', product: product, variant: selected_variant, class: 'price--large' %}
                </div>
                {%- comment -%}
                  R10 — cart.taxes_included is true when the merchant's prices already
                  include tax, which changes what the price above means. Shopify
                  requires it on both product and cart pages.
                {%- endcomment -%}
                {%- if cart.taxes_included -%}
                  <p class="product__taxes caption">{{ 'general.taxes_included' | t }}</p>
                {%- endif -%}
                <p class="product__taxes caption">{{ 'cart.taxes_and_shipping_at_checkout' | t }}</p>

                {%- comment -%}
                  R6 — Shop Pay Installments. B3 found this never rendered: it applied
                  payment_terms to a PRICE, and the filter "requires the form object
                  from the Liquid product form or cart form" (shopify.dev, Shop Pay
                  Installments). The price block sits outside the buy-buttons form, so
                  this follows the documented pattern for that case: a second product
                  form beside the price, holding a hidden input[name="id"] for the
                  selected variant.

                  It stays OUTSIDE <product-form>, which finds its form with
                  querySelector('form') -- nested inside, Add to cart would submit this
                  one. product.js re-renders [data-payment-terms] from the Section
                  Rendering response on every variant change, so the banner is rebuilt
                  for the new variant rather than relying on the web component noticing
                  a programmatic value change. Renders nothing when the shop has no
                  installments provider.
                {%- endcomment -%}
                {%- assign installments_form_id = 'ProductInstallments-' | append: section.id -%}
                <div class="product__payment-terms" data-payment-terms>
                  {%- form 'product', product, id: installments_form_id, class: 'product__installments-form' -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    {{ form | payment_terms }}
                  {%- endform -%}
                </div>
              </div>

            {%- when 'inventory' -%}
              {%- liquid
                assign show_inventory = false
                if settings.low_stock_threshold > 0 and selected_variant.inventory_management != blank and selected_variant.inventory_quantity > 0 and selected_variant.inventory_quantity <= settings.low_stock_threshold
                  assign show_inventory = true
                endif
              -%}
              <p class="product__inventory caption" data-inventory-target {{ block.shopify_attributes }}>
                {%- if show_inventory -%}{{ 'products.low_stock_count' | t: count: selected_variant.inventory_quantity }}{%- endif -%}
              </p>

            {%- when 'rating' -%}
              {%- if product.metafields.reviews.rating.value != blank -%}
                {%- assign rating = product.metafields.reviews.rating.value -%}
                <div class="product__rating" {{ block.shopify_attributes }}>
                  <span class="product-card__rating" role="img" aria-label="{{ 'accessibility.star_rating_html' | t: rating: rating.rating, scale: rating.scale_max }}">
                    {%- assign rounded = rating.rating | round -%}
                    {%- for i in (1..5) -%}
                      {%- if i <= rounded -%}{% render 'icon', name: 'star' %}{%- else -%}{% render 'icon', name: 'star-outline' %}{%- endif -%}
                    {%- endfor -%}
                  </span>
                  {%- if product.metafields.reviews.rating_count -%}
                    <span class="caption">{{ product.metafields.reviews.rating_count }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="product__description rte prose" {{ block.shopify_attributes }}>{{ product.description }}</div>
              {%- endif -%}

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="variant-picker" data-variant-picker {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    <fieldset class="variant-option" data-option-position="{{ option.position }}">
                      <legend class="variant-option__label">
                        <span class="label">{{ option.name | escape }}</span>
                        <span class="variant-option__selected" data-option-selected>{{ option.selected_value | escape }}</span>
                      </legend>
                      <div class="variant-option__values">
                        {%- liquid
                          # 0-based index of this option inside variant.options
                          assign opt_index = option.position | minus: 1
                          # Colour options render swatches; everything else keeps the
                          # text pill unchanged. Matched case-insensitively, and
                          # "colour" is accepted alongside "color".
                          assign option_key = option.name | downcase | strip
                          assign is_color_option = false
                          if option_key == 'color' or option_key == 'colour'
                            assign is_color_option = true
                          endif
                        -%}
                        {%- for value in option.values -%}
                          {%- liquid
                            # A value is unavailable when no purchasable variant
                            # carries it at this option position. That test does not
                            # depend on what the other options are set to, so the
                            # rendered state is always correct.
                            assign value_available = false
                            for variant in product.variants
                              if variant.available and variant.options[opt_index] == value
                                assign value_available = true
                                break
                              endif
                            endfor
                          -%}
                          <label class="variant-option__value{% if is_color_option and value.swatch %} variant-option__value--swatch{% endif %}{% unless value_available %} variant-option__value--unavailable{% endunless %}">
                            <input
                              type="radio"
                              name="option-{{ option.position }}"
                              value="{{ value | escape }}"
                              data-option-input
                              {% if option.selected_value == value %}checked{% endif %}
                              {% unless value_available %}disabled{% endunless %}
                              {% if is_color_option and value.swatch %}aria-label="{{ value | escape }}"{% endif %}
                            >
                            {%- if is_color_option and value.swatch -%}
                              {% render 'swatch', value: value %}
                            {%- else -%}
                              <span>{{ value | escape }}</span>
                            {%- endif -%}
                            {%- unless value_available -%}
                              <span class="visually-hidden">{{ 'products.unavailable' | t }}</span>
                            {%- endunless -%}
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                </div>
              {%- endunless -%}
              {%- comment -%} R5 — local pickup, directly below the variant selector. {%- endcomment -%}
              {% render 'pickup-availability', product: product, variant: selected_variant %}

            {%- when 'buy_buttons' -%}
              <div class="product__buy-area" {{ block.shopify_attributes }}>
                <product-form data-product-form>
                  {%- form 'product', product, id: form_id, novalidate: 'novalidate', class: 'product-form' -%}
                    <input
                      type="hidden"
                      name="id"
                      value="{{ selected_variant.id }}"
                      data-variant-id
                      {% unless selected_variant.available %}disabled{% endunless %}
                    >

                    <div class="product__purchase">
                      {%- if block.settings.show_quantity -%}
                        <div class="product__quantity">
                          <label class="label" for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
                          <quantity-input class="quantity">
                            <button type="button" class="quantity__button" data-quantity-action="decrease" aria-label="{{ 'accessibility.decrease_quantity' | t }}">{% render 'icon', name: 'minus' %}</button>
                            <input class="quantity__input" id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
                            <button type="button" class="quantity__button" data-quantity-action="increase" aria-label="{{ 'accessibility.increase_quantity' | t }}">{% render 'icon', name: 'plus' %}</button>
                          </quantity-input>
                        </div>
                      {%- endif -%}

                      <div class="product__submit" data-buy-button aria-live="polite">
                        <button
                          type="submit"
                          name="add"
                          class="btn btn--full btn--large"
                          data-add-button
                          {% unless selected_variant.available %}disabled{% endunless %}
                        >
                          <span data-add-label>
                            {%- if selected_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
                          </span>
                        </button>
                      </div>
                    </div>

                    {%- comment -%} Hide the dynamic "Buy it now" button on sold-out products; the notify_me block takes over. {%- endcomment -%}
                    {%- if block.settings.show_dynamic_checkout and product.available -%}
                      {{ form | payment_button }}
                    {%- endif -%}

                    {%- comment -%}
                      R8 — Follow on Shop. login_button renders the Shop follow control
                      and outputs nothing when the shop is not eligible, so it is safe
                      to render unconditionally.
                    {%- endcomment -%}
                    <div class="product__shop-follow">
                      {{ shop | login_button: action: 'follow' }}
                    </div>

                    {%- if block.settings.show_shipping_note and block.settings.shipping_note != blank -%}
                      <p class="product__shipping-note caption">{{ block.settings.shipping_note | escape }}</p>
                    {%- endif -%}

                    <div class="product-form__error" role="alert" data-form-error data-default-error="{{ 'products.add_error' | t | escape }}" hidden></div>
                  {%- endform -%}
                </product-form>
              </div>

              <div class="product-bundle-wrap">
                {% render 'bundle', current_product: product %}
              </div>

            {%- when 'notify_me' -%}
              {%- unless product.available -%}
                <div {{ block.shopify_attributes }}>
                  {%- render 'notify-me', product: product, block: block -%}
                </div>
              {%- endunless -%}

            {%- when 'trust_badges' -%}
              {% render 'trust-badges', block: block %}

            {%- when 'share' -%}
              <share-button class="product__share" data-share-url="{{ shop.url }}{{ product.url }}" {{ block.shopify_attributes }}>
                <button type="button" class="link-underline" data-share-trigger>
                  {% render 'icon', name: 'share' %}
                  <span>{{ 'general.share' | t }}</span>
                </button>
                <span class="product__share-copied caption" data-share-copied role="status" hidden>{{ 'general.copied' | t }}</span>
              </share-button>

            {%- when 'collapsible' -%}
              <details class="product__collapsible" {{ block.shopify_attributes }}>
                <summary class="product__collapsible-summary">
                  <span class="label">{{ block.settings.heading | escape }}</span>
                  {% render 'icon', name: 'chevron-down' %}
                </summary>
                <div class="product__collapsible-body prose">{{ block.settings.content }}</div>
              </details>

            {%- when 'custom_liquid' -%}
              <div class="product__custom" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-variant-json>
    {{ product.variants | json }}
  </script>

  {%- comment -%} Floating sticky add-to-cart — appears when the main ATC scrolls out of view (product.js IntersectionObserver). {%- endcomment -%}
  {%- if section.settings.show_floating_atc -%}
  <div class="product__sticky" data-product-sticky>
    <div class="product__sticky-inner page-width">
      <div class="product__sticky-info">
        <span class="product__sticky-title">{{ product.title | escape }}</span>
        <div data-price-target aria-hidden="true">{% render 'price', product: product, variant: selected_variant %}</div>
      </div>
      <button
        type="submit"
        form="{{ form_id }}"
        name="add"
        class="btn"
        data-add-button
        {% unless selected_variant.available %}disabled{% endunless %}
      >
        <span data-add-label>{%- if selected_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}</span>
      </button>
    </div>
  </div>
  {%- endif -%}
</product-info>

<script src="{{ 'product.js' | asset_url }}" defer></script>

{% stylesheet %}
  /* Section padding: the merchant's padding_top/bottom arrive as --pt/--pb set
     inline on <product-info> itself, so they still win without inheritance or a
     cache dependency -- and a variable (unlike an inline padding) lets the
     single-column layout scale the top value down (CRIT2, below). */
  product-info.product { padding-top: var(--pt, 64px); padding-bottom: var(--pb, 64px); }
  .product__grid { display: grid; gap: var(--space-8); align-items: start; }
  /* min-width:0 lets each column shrink to its track instead of growing to fit
     wide min-content (long title word, breadcrumb, variant value), which would
     push the two-column total past the content width and overflow the right edge. */
  .product__media-col, .product__details-col { min-width: 0; }
  /* With the columns pinned to their track, a very long title / SKU / word breaks
     onto the next line instead of overflowing the info panel to the right. */
  .product__title, .product__details { overflow-wrap: break-word; }
  .product__details { display: flex; flex-direction: column; gap: var(--space-5); }
  .product__title { letter-spacing: var(--tracking-tight); }
  .product__price { display: flex; flex-direction: column; gap: var(--space-1); }
  .product__inventory { color: var(--color-muted); letter-spacing: var(--tracking-wide); }
  .product__inventory:empty { display: none; }
  .product__rating { display: inline-flex; align-items: center; gap: var(--space-2); }
  .product__description { color: var(--color-muted); }

  .variant-picker { display: flex; flex-direction: column; gap: var(--space-5); }
  .variant-option { border: 0; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .variant-option__label { display: flex; gap: var(--space-2); padding: 0; }
  .variant-option__selected { font-size: var(--text-xs); letter-spacing: var(--tracking-wide); color: var(--color-muted); text-transform: none; }
  .variant-option__values { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .variant-option__value { position: relative; }
  .variant-option__value input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .variant-option__value span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border-strong);
    font-size: var(--text-sm);
    transition: border-color var(--duration-fast) var(--ease-editorial), background-color var(--duration-fast) var(--ease-editorial), color var(--duration-fast) var(--ease-editorial);
  }
  /* H1 -- an unselected pill had a transition declared but no :hover rule to
     drive it, so hovering a variant did nothing. The hover deliberately reads
     as "reachable" (border darkens + faint fill), not as "selected" (solid
     fill), so the two states stay distinguishable.
     The hover hangs off the LABEL, not the span: the radio is absolutely
     positioned over the whole control (opacity 0, inset 0), so it wins the hit
     test and `span:hover` can never match -- confirmed in the browser. */
  .variant-option__value:hover input:not(:checked):not(:disabled) + span { border-color: var(--color-text); background-color: var(--color-subtle); }
  .variant-option__value input:checked + span { border-color: var(--color-text); background-color: var(--color-text); color: var(--color-bg); }
  .variant-option__value:hover input:checked + span { background-color: var(--color-accent-local); border-color: var(--color-accent-local); }
  .variant-option__value input:focus-visible + span { outline: 2px solid var(--color-text); outline-offset: 2px; }
  /* Unavailable values: struck through with a dashed edge rather than dimmed,
     so the state is legible without dropping text contrast below 4.5:1. The
     input is genuinely disabled, so it is neither clickable nor focusable. */
  .variant-option__value--unavailable span { border-style: dashed; text-decoration: line-through; }
  .variant-option__value input:disabled { cursor: not-allowed; }
  /* ---- Colour swatches ----
     The circle is 28px but the label keeps the 44x44 hit target the text pills
     have. .swatch overrides the generic `.variant-option__value span` pill rule,
     which would otherwise give it pill padding and a rectangular border. */
  .variant-option__value--swatch { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; }
  .variant-option__value--swatch .swatch {
    display: block;
    width: 28px;
    height: 28px;
    min-width: 0;
    min-height: 0;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--color-border-strong);
    background-size: cover;
    background-position: center;
    transition: box-shadow var(--duration-fast) var(--ease-editorial);
  }
  /* Swatches take the same affordance as a ring, one step lighter than the
     checked ring so hovered and selected never look the same. */
  .variant-option__value--swatch:hover input:not(:checked):not(:disabled) + .swatch { box-shadow: 0 0 0 2px var(--color-bg), 0 0 0 3px var(--color-border-strong); }
  .variant-option__value--swatch input:checked + .swatch { box-shadow: 0 0 0 2px var(--color-bg), 0 0 0 3px var(--color-text); }
  .variant-option__value--swatch input:focus-visible + .swatch { outline: 2px solid var(--color-text); outline-offset: 3px; }
  /* A strikethrough cannot read on a circle, so unavailable swatches take a
     diagonal bar. The visually-hidden "Unavailable" text carries it for AT. */
  .variant-option__value--swatch.variant-option__value--unavailable .swatch { position: relative; opacity: 0.55; }
  .variant-option__value--swatch.variant-option__value--unavailable .swatch::after {
    content: ""; position: absolute; inset: -1px;
    background: linear-gradient(to top left, transparent calc(50% - 1px), var(--color-text) calc(50% - 1px), var(--color-text) calc(50% + 1px), transparent calc(50% + 1px));
    border-radius: 50%;
  }


  .product__purchase { display: flex; flex-direction: column; gap: var(--space-3); }
  /* Left-aligned, content-width quantity selector (the wrapper used to stretch
     full-width as a flex-column item). Scoped to the product page so the shared
     base.css .quantity used by the cart drawer is untouched. */
  .product__quantity { display: flex; align-items: center; gap: 0.75rem; width: fit-content; }
  /* 44px, not 40px: the 1px border on each side left the stepper buttons at
     40x38, just under the tap-target floor. 44 makes them 42 tall. */
  .product__quantity .quantity { height: 44px; width: fit-content; }
  .product__quantity .quantity__button { width: 40px; flex-shrink: 0; }
  .product__quantity .quantity__input {
    width: 48px;
    font-size: 13px;
    border-left: 1px solid var(--color-border);
    border-right: 1px solid var(--color-border);
  }
  .product-form__error { color: var(--color-sale); font-size: var(--text-sm); margin-top: var(--space-2); }
  .shopify-payment-button { margin-top: var(--space-2); }
  /* Match the dynamic-checkout ("Buy it now") button to the editorial Add-to-cart
     button: espresso fill, zero radius, uppercase 11px mono label (the theme's
     button voice). !important is required to beat Shopify's injected styles. */
  .shopify-payment-button__button--unbranded {
    /* Was #2C1810 / #FAF7F2 hardcoded, so the dynamic-checkout button kept the
       espresso-on-cream palette while the surrounding panel inverted or used a
       Studio/Maison scheme. These tokens are already in scope here. */
    background-color: var(--color-text) !important;
    color: var(--color-bg) !important;
    border-radius: 0 !important;
    min-height: 48px !important;
    padding: 0.85em 2em !important;
    font-family: var(--font-mono) !important;
    font-size: 11px !important;
    font-weight: 400 !important;
    letter-spacing: var(--tracking-label) !important;
    text-transform: uppercase !important;
    transition: background-color var(--duration-fast) var(--ease-editorial) !important;
  }
  .shopify-payment-button__button--unbranded:hover:not([disabled]) {
    background-color: var(--color-accent-local, #766356) !important;
  }
  .product__shipping-note { color: var(--color-muted); margin-top: var(--space-1); text-align: center; }
  .product__payment-terms:empty { display: none; }
  .product__payment-terms { margin-top: var(--space-2); }
  .product__shop-follow:empty { display: none; }
  .product__shop-follow { margin-top: var(--space-2); }

  .product__share { display: inline-flex; align-items: center; gap: var(--space-3); }
  .product__collapsible { border-top: 1px solid var(--color-border); }
  /* H1 -- accordion rows are controls; only the chevron responded, and only
     once already open. */
  .product__collapsible-summary { display: flex; align-items: center; justify-content: space-between; padding: var(--space-4) 0; min-height: 44px; transition: color var(--duration-fast) var(--ease-editorial); }
  .product__collapsible-summary:hover { color: var(--color-accent-local); }
  .product__collapsible[open] .product__collapsible-summary .icon { transform: rotate(180deg); }
  .product__collapsible-summary .icon { transition: transform var(--duration-fast) var(--ease-editorial); }
  .product__collapsible-body { padding-bottom: var(--space-4); color: var(--color-muted); }

  .product__sticky {
    position: fixed;
    /* Offset by the left navigation column so the bar (and its price) clears the
       fixed sidebar. Binds to the live --sidebar-width var (settings.sidebar_width,
       180-300px) — not a hardcoded value. Reset to 0 below the 768px breakpoint. */
    left: var(--sidebar-width, 220px); right: 0; bottom: 0;
    z-index: var(--z-sticky);
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-3);
    transform: translateY(100%);
    /* Off-screen but still focusable would give keyboard users a second,
       invisible Add to cart button. Hide it from the tab order until shown. */
    visibility: hidden;
    transition: transform var(--duration-base) var(--ease-editorial), visibility 0s linear var(--duration-base);
  }
  .product__sticky.is-visible {
    transform: translateY(0);
    visibility: visible;
    transition: transform var(--duration-base) var(--ease-editorial), visibility 0s;
  }
  .product__sticky-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .product__sticky-info { display: flex; flex-direction: column; min-width: 0; }
  .product__sticky-title { font-size: var(--text-sm); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* At the sidebar's collapse breakpoint the grid becomes a single column and the
     sidebar is an off-canvas drawer, so the bar spans the full viewport again. */
  @media (max-width: 768px) {
    .product__sticky { left: 0; }
  }

  /* At 375px the bar is 179px of title/price + a 132px button, and "ADD TO CART"
     wrapped to two lines inside it. The button is NOT widened: F5 established
     the title is already truncated there (scrollWidth 202 vs clientWidth 179),
     so taking width from the info column to give it to the button would eat
     further into the product name. Tightening the label's own tracking buys the
     room instead -- the type stays at --text-xs, so nothing gets smaller to
     read. nowrap makes the single line a guarantee rather than a calculation
     that holds until someone translates the string. */
  @media (max-width: 480px) {
    .product__sticky .btn {
      white-space: nowrap;
      letter-spacing: 0.06em;
      padding-inline: var(--space-3);
    }
  }

  /* CRIT2 -- in the single-column layout the gallery, 64px of padding and a
     two-line breadcrumb used to fill the whole first phone screen: title, price
     and Add to cart all sat below 812px on 4 of 5 products. Here the top padding
     is capped at 16px (a merchant's smaller value still wins), the column gap
     tightens, the breadcrumb drops its last crumb -- the product name, which the
     h1 repeats a line later -- so it stays one line, and the vendor tucks up
     against the title as its eyebrow. The gallery cap lives in
     snippets/product-media.liquid; the sticky bar in product.js. */
  @media (max-width: 989px) {
    product-info.product { padding-top: min(var(--pt, 64px), var(--space-4)); }
    .product__grid { gap: var(--space-5); }
    .product__details .breadcrumbs__current,
    .product__details .breadcrumbs__sep:has(+ .breadcrumbs__current) { display: none; }
    .product__details .breadcrumbs__link { white-space: nowrap; }
    .product__details .breadcrumbs + * { margin-top: calc(var(--space-3) * -1); }
    .product__vendor + .product__title { margin-top: calc(var(--space-2) - var(--space-5)); }
  }

  @media (min-width: 990px) {
    .product__grid { grid-template-columns: var(--product-media-width, 55%) 1fr; gap: var(--space-16); }
    .product__media-col { position: relative; }
    /* Phase H — the floating bar shows on desktop too (slim bottom bar). */
    .product__sticky-info { flex-direction: row; align-items: baseline; gap: var(--space-4); }
    .product__sticky .btn { min-width: 220px; }
  }
{% endstylesheet %}

