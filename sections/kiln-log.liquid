{%- comment -%}
  Kiln log — what came out of the last firings, in the order it happened.

  A studio that fires in batches has news a catalogue cannot carry: this
  glaze broke differently this week, that batch came out darker than the one
  before, these twelve bowls exist and then they do not. A log says the shop
  is a working studio rather than a warehouse, and it is the one section on
  the page that is allowed to be out of date, because a date is the point.

  The date is a plain text field, not a date picker: a studio writes "Firing
  09 — March" or "Week 11" or "第三窯", and a picker would force all of that
  into one machine format for no reader's benefit. Entries are blocks, so the
  newest one is a drag to the top.
{%- endcomment -%}
{%- liquid
  assign scheme = section.settings.color_scheme.id | default: 'background-1'
  assign heading_tag = section.settings.heading_tag | default: 'h2'

  # Entry titles sit one level below whatever the section heading is, so the
  # outline of the page stays in order however the merchant sets it.
  case heading_tag
    when 'h2'
      assign entry_tag = 'h3'
    when 'h3'
      assign entry_tag = 'h4'
    else
      assign entry_tag = 'p'
  endcase
-%}

<style>
  #shopify-section-{{ section.id }} {
    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;
    --klog-ratio: {% case section.settings.image_ratio %}{% when 'portrait' %}4 / 5{% when 'landscape' %}4 / 3{% else %}1 / 1{% endcase %};
  }
</style>

<div class="kilnlog color-scheme--{{ scheme }}">
  <div class="kilnlog__inner page-width">
    <div class="kilnlog__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow" data-animate>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="section-heading heading--lg kilnlog__heading" data-animate>
          {{ section.settings.heading | escape }}
        </{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="lead kilnlog__text" data-animate>{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ol class="kilnlog__list">
        {%- for block in section.blocks -%}
          <li class="kilnlog__entry" data-animate data-animate-delay="{{ forloop.index | modulo: 5 | plus: 1 }}" {{ block.shopify_attributes }}>
            {%- if block.settings.date != blank -%}
              <p class="kilnlog__date label">{{ block.settings.date | escape }}</p>
            {%- endif -%}

            <div class="kilnlog__body">
              {%- if block.settings.title != blank -%}
                <{{ entry_tag }} class="kilnlog__title">
                  {%- if block.settings.link != blank -%}
                    <a class="kilnlog__title-link" href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>
                  {%- else -%}
                    {{ block.settings.title | escape }}
                  {%- endif -%}
                </{{ entry_tag }}>
              {%- endif -%}
              {%- if block.settings.note != blank -%}
                <div class="kilnlog__note prose">{{ block.settings.note }}</div>
              {%- endif -%}
              {%- if block.settings.status != blank -%}
                <p class="kilnlog__status label">{{ block.settings.status | escape }}</p>
              {%- endif -%}
            </div>

            {%- if section.settings.show_images -%}
              <div class="kilnlog__media">
                {%- if block.settings.image != blank -%}
                  {%- assign kiln_alt = block.settings.image.alt | default: block.settings.title -%}
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      decoding: 'async',
                      widths: '200, 300, 400, 600, 800',
                      sizes: '(min-width: 990px) 14vw, 38vw',
                      alt: kiln_alt,
                      class: 'kilnlog__img'
                  }}
                {%- endif -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- else -%}
      <p class="caption">{{ 'sections.kiln-log.onboarding' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .kilnlog { padding-block: var(--pt, 96px) var(--pb, 96px); }
  .kilnlog__heading { margin-top: var(--space-2); }
  .kilnlog__text { max-width: 48ch; margin-top: var(--space-3); color: var(--color-muted); }

  .kilnlog__list { margin-top: var(--space-10, 3rem); }

  /* A ruled ledger: the date in its own column, the entry beside it, the
     photograph last so a log with no pictures still reads as a log. */
  .kilnlog__entry {
    display: grid;
    gap: var(--space-3) clamp(1.5rem, 4vw, 3rem);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .kilnlog__entry:last-child { border-bottom: 1px solid var(--color-border); }

  .kilnlog__date { color: var(--color-muted); white-space: nowrap; }
  .kilnlog__title { font-family: var(--font-heading); font-size: var(--text-xl); line-height: 1.2; color: var(--color-heading, var(--color-text)); }
  .kilnlog__title-link { color: inherit; text-decoration: none; }
  .kilnlog__title-link:hover { text-decoration: underline; text-underline-offset: 0.16em; text-decoration-thickness: 1px; }
  .kilnlog__title-link:focus-visible { outline: 2px solid var(--color-text); outline-offset: 3px; }
  .kilnlog__note { margin-top: var(--space-3); max-width: 58ch; color: var(--color-muted); }
  .kilnlog__status { margin-top: var(--space-3); color: var(--color-text); }

  .kilnlog__media { aspect-ratio: var(--klog-ratio, 1 / 1); overflow: hidden; background-color: var(--color-subtle); }
  .kilnlog__media:empty { display: none; }
  .kilnlog__img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--duration-slower) var(--ease-editorial); }
  .kilnlog__entry:hover .kilnlog__img { transform: scale(1.03); }

  @media (min-width: 750px) {
    .kilnlog__entry { grid-template-columns: minmax(6rem, 8rem) minmax(0, 1fr) minmax(0, 14rem); align-items: start; }
  }
  @media (max-width: 749px) {
    .kilnlog__media { max-width: 60%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kilnlog__img { transition: none; }
    .kilnlog__entry:hover .kilnlog__img { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.kiln-log.name",
  "tag": "section",
  "class": "shopify-section",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.kiln-log.settings.eyebrow.label", "default": "From the kiln" },
    { "type": "text", "id": "heading", "label": "t:sections.kiln-log.settings.heading.label", "default": "What came out this month" },
    {
      "type": "select", "id": "heading_tag", "label": "t:sections.kiln-log.settings.heading_tag.label",
      "options": [
        { "value": "h2", "label": "t:sections.kiln-log.settings.heading_tag.options__1.label" },
        { "value": "h3", "label": "t:sections.kiln-log.settings.heading_tag.options__2.label" },
        { "value": "p", "label": "t:sections.kiln-log.settings.heading_tag.options__3.label" }
      ],
      "default": "h2"
    },
    { "type": "text", "id": "text", "label": "t:sections.kiln-log.settings.text.label" },
    { "type": "checkbox", "id": "show_images", "label": "t:sections.kiln-log.settings.show_images.label", "default": true },
    {
      "type": "select", "id": "image_ratio", "label": "t:sections.kiln-log.settings.image_ratio.label",
      "options": [
        { "value": "square", "label": "t:sections.kiln-log.settings.image_ratio.options__1.label" },
        { "value": "portrait", "label": "t:sections.kiln-log.settings.image_ratio.options__2.label" },
        { "value": "landscape", "label": "t:sections.kiln-log.settings.image_ratio.options__3.label" }
      ],
      "default": "square"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.kiln-log.settings.color_scheme.label", "default": "background-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.kiln-log.settings.padding_top.label", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.kiln-log.settings.padding_bottom.label", "default": 96 }
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "t:sections.kiln-log.blocks.entry.name",
      "settings": [
        { "type": "text", "id": "date", "label": "t:sections.kiln-log.blocks.entry.settings.date.label", "info": "t:sections.kiln-log.blocks.entry.settings.date.info", "default": "Firing 09" },
        { "type": "text", "id": "title", "label": "t:sections.kiln-log.blocks.entry.settings.title.label", "default": "What came out" },
        { "type": "richtext", "id": "note", "label": "t:sections.kiln-log.blocks.entry.settings.note.label", "default": "<p>Say what happened in the kiln and what it means for the pieces.</p>" },
        { "type": "text", "id": "status", "label": "t:sections.kiln-log.blocks.entry.settings.status.label", "info": "t:sections.kiln-log.blocks.entry.settings.status.info" },
        { "type": "image_picker", "id": "image", "label": "t:sections.kiln-log.blocks.entry.settings.image.label" },
        { "type": "url", "id": "link", "label": "t:sections.kiln-log.blocks.entry.settings.link.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.kiln-log.presets.name",
      "blocks": [{ "type": "entry" }, { "type": "entry" }, { "type": "entry" }]
    }
  ]
}
{% endschema %}
