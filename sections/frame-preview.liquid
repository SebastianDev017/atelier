{%- comment -%}
  Frame preview — the same work, in each frame the shop sells.

  "Ships framed and ready to hang" is a promise a sentence cannot keep. What
  a buyer wants to know is what oak does to it, what black does to it, and
  how much mat there is. Those are three facts about presentation and they
  are answered by showing them.

  The frame and the mat are drawn, not photographed: a border and a padded
  ground, both taken from the block's own colour settings, so a merchant adds
  a framing option by naming it and picking two colours rather than by
  commissioning another photograph of every work. One copy of the artwork is
  in the page and the frame around it changes.

  The options are native radio inputs in a fieldset, so they arrow-key like
  any other radio group and each one carries its name and price note as text.
  Colour is never the only thing distinguishing one option from another. With
  JavaScript absent the first frame is drawn and every option still reads as
  a labelled list of what the shop offers.
{%- endcomment -%}
{%- liquid
  assign scheme = section.settings.color_scheme.id | default: 'background-1'
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign first = section.blocks.first
-%}

<style>
  #shopify-section-{{ section.id }} {
    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;
    --fp-ratio: {% case section.settings.image_ratio %}{% when 'square' %}1 / 1{% when 'landscape' %}4 / 3{% else %}4 / 5{% endcase %};
  }
</style>

<div class="frmprev color-scheme--{{ scheme }}">
  <div class="frmprev__inner page-width frmprev__inner--media-{{ section.settings.media_position | default: 'left' }}">
    <div
      class="frmprev__stage"
      data-frmprev-stage
      {% if first %}
        style="--fp-frame: {{ first.settings.frame_color | default: '#2b2b2b' }}; --fp-frame-w: {{ first.settings.frame_width | default: 14 }}px; --fp-mat: {{ first.settings.mat_color | default: '#f4f1ea' }}; --fp-mat-w: {{ first.settings.mat_width | default: 32 }}px;"
      {% endif %}
    >
      <div class="frmprev__frame">
        <div class="frmprev__mat">
          {%- if section.settings.image != blank -%}
            {%- assign frmprev_alt = section.settings.image.alt | default: section.settings.heading -%}
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                decoding: 'async',
                widths: '400, 600, 800, 1000, 1200',
                sizes: '(min-width: 990px) 45vw, 90vw',
                alt: frmprev_alt,
                class: 'frmprev__art'
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'frmprev__art placeholder' }}
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="frmprev__panel">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow" data-animate>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="section-heading heading--md frmprev__heading" data-animate>
          {{ section.settings.heading | escape }}
        </{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="prose frmprev__text" data-animate>{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <fieldset class="frmprev__options" data-frmprev-options>
          <legend class="label frmprev__legend">{{ section.settings.options_label | default: 'Frame' | escape }}</legend>
          {%- for block in section.blocks -%}
            <div class="frmprev__option" {{ block.shopify_attributes }}>
              <input
                class="frmprev__radio visually-hidden"
                type="radio"
                name="frmprev-{{ section.id }}"
                id="frmprev-{{ section.id }}-{{ forloop.index0 }}"
                value="{{ forloop.index0 }}"
                {% if forloop.first %}checked{% endif %}
                data-fp-frame="{{ block.settings.frame_color | default: '#2b2b2b' }}"
                data-fp-frame-w="{{ block.settings.frame_width | default: 14 }}"
                data-fp-mat="{{ block.settings.mat_color | default: '#f4f1ea' }}"
                data-fp-mat-w="{{ block.settings.mat_width | default: 32 }}"
              >
              <label class="frmprev__label" for="frmprev-{{ section.id }}-{{ forloop.index0 }}">
                <span
                  class="frmprev__swatch"
                  style="--fp-sw-frame: {{ block.settings.frame_color | default: '#2b2b2b' }}; --fp-sw-mat: {{ block.settings.mat_color | default: '#f4f1ea' }};"
                  aria-hidden="true"
                ></span>
                <span class="frmprev__label-text">
                  <span class="frmprev__name">{{ block.settings.label | escape }}</span>
                  {%- if block.settings.note != blank -%}
                    <span class="frmprev__note">{{ block.settings.note | escape }}</span>
                  {%- endif -%}
                </span>
              </label>
            </div>
          {%- endfor -%}
        </fieldset>
      {%- else -%}
        <p class="caption">{{ 'sections.frame-preview.onboarding' | t }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
        <a class="btn btn--outline frmprev__cta" href="{{ section.settings.cta_link }}">
          {{ section.settings.cta_label | escape }}
        </a>
      {%- endif -%}

      {%- if section.settings.footnote != blank -%}
        <p class="caption frmprev__foot">{{ section.settings.footnote | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

<script src="{{ 'frame-preview.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .frmprev { padding-block: var(--pt, 96px) var(--pb, 96px); }
  .frmprev__inner { display: grid; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }

  .frmprev__stage { display: flex; justify-content: center; }
  /* Frame and mat are two boxes, both sized from the checked option, so the
     change is one custom property away and the artwork never reloads. */
  .frmprev__frame {
    width: 100%;
    border: var(--fp-frame-w, 14px) solid var(--fp-frame, #2b2b2b);
    background-color: var(--fp-mat, #f4f1ea);
    box-shadow: 0 18px 44px rgb(0 0 0 / 0.14);
    transition: border-color var(--duration-base) var(--ease-editorial), border-width var(--duration-base) var(--ease-editorial), background-color var(--duration-base) var(--ease-editorial);
  }
  .frmprev__mat { padding: var(--fp-mat-w, 32px); transition: padding var(--duration-base) var(--ease-editorial); }
  .frmprev__art { display: block; width: 100%; aspect-ratio: var(--fp-ratio, 4 / 5); object-fit: cover; }

  .frmprev__heading { margin-top: var(--space-2); }
  .frmprev__text { margin-top: var(--space-4); max-width: 46ch; color: var(--color-muted); }

  .frmprev__options { margin-top: var(--space-6); border: 0; padding: 0; }
  .frmprev__legend { padding: 0; color: var(--color-muted); }
  .frmprev__option + .frmprev__option { border-top: 1px solid var(--color-border); }
  .frmprev__label {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-3);
    min-height: 44px;
    cursor: pointer;
  }
  .frmprev__swatch {
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border: 4px solid var(--fp-sw-frame, #2b2b2b);
    background-color: var(--fp-sw-mat, #f4f1ea);
  }
  .frmprev__name { display: block; font-family: var(--font-heading); font-size: var(--text-base); color: var(--color-heading, var(--color-text)); }
  .frmprev__note { display: block; margin-top: 0.15rem; font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--tracking-label); color: var(--color-muted); }

  /* Chosen is said twice: a rule under the name and a ring on the swatch.
     Neither of them is the swatch colour itself. */
  .frmprev__label:hover .frmprev__name { text-decoration: underline; text-underline-offset: 0.16em; text-decoration-thickness: 1px; }
  .frmprev__radio:checked + .frmprev__label .frmprev__name { text-decoration: underline; text-underline-offset: 0.16em; text-decoration-thickness: 2px; }
  .frmprev__radio:checked + .frmprev__label .frmprev__swatch { outline: 1px solid var(--color-text); outline-offset: 3px; }
  .frmprev__radio:focus-visible + .frmprev__label { outline: 2px solid var(--color-text); outline-offset: 2px; }

  .frmprev__cta { margin-top: var(--space-6); }
  .frmprev__foot { margin-top: var(--space-4); max-width: 42ch; }

  @media (min-width: 990px) {
    .frmprev__inner { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); }
    .frmprev__inner--media-right .frmprev__stage { order: 2; }
  }
  @media (prefers-reduced-motion: reduce) {
    .frmprev__frame, .frmprev__mat { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.frame-preview.name",
  "tag": "section",
  "class": "shopify-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.frame-preview.settings.eyebrow.label", "default": "Framing" },
    { "type": "text", "id": "heading", "label": "t:sections.frame-preview.settings.heading.label", "default": "Choose how it hangs" },
    {
      "type": "select", "id": "heading_tag", "label": "t:sections.frame-preview.settings.heading_tag.label",
      "options": [
        { "value": "h2", "label": "t:sections.frame-preview.settings.heading_tag.options__1.label" },
        { "value": "h3", "label": "t:sections.frame-preview.settings.heading_tag.options__2.label" },
        { "value": "p", "label": "t:sections.frame-preview.settings.heading_tag.options__3.label" }
      ],
      "default": "h2"
    },
    { "type": "richtext", "id": "text", "label": "t:sections.frame-preview.settings.text.label" },
    { "type": "image_picker", "id": "image", "label": "t:sections.frame-preview.settings.image.label", "info": "t:sections.frame-preview.settings.image.info" },
    {
      "type": "select", "id": "image_ratio", "label": "t:sections.frame-preview.settings.image_ratio.label",
      "options": [
        { "value": "portrait", "label": "t:sections.frame-preview.settings.image_ratio.options__1.label" },
        { "value": "square", "label": "t:sections.frame-preview.settings.image_ratio.options__2.label" },
        { "value": "landscape", "label": "t:sections.frame-preview.settings.image_ratio.options__3.label" }
      ],
      "default": "portrait"
    },
    {
      "type": "select", "id": "media_position", "label": "t:sections.frame-preview.settings.media_position.label",
      "options": [
        { "value": "left", "label": "t:sections.frame-preview.settings.media_position.options__1.label" },
        { "value": "right", "label": "t:sections.frame-preview.settings.media_position.options__2.label" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "options_label", "label": "t:sections.frame-preview.settings.options_label.label", "default": "Frame" },
    { "type": "url", "id": "cta_link", "label": "t:sections.frame-preview.settings.cta_link.label" },
    { "type": "text", "id": "cta_label", "label": "t:sections.frame-preview.settings.cta_label.label", "default": "Shop the editions" },
    { "type": "text", "id": "footnote", "label": "t:sections.frame-preview.settings.footnote.label", "info": "t:sections.frame-preview.settings.footnote.info" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.frame-preview.settings.color_scheme.label", "default": "background-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.frame-preview.settings.padding_top.label", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.frame-preview.settings.padding_bottom.label", "default": 96 }
  ],
  "blocks": [
    {
      "type": "frame",
      "name": "t:sections.frame-preview.blocks.frame.name",
      "settings": [
        { "type": "text", "id": "label", "label": "t:sections.frame-preview.blocks.frame.settings.label.label", "default": "Oak" },
        { "type": "text", "id": "note", "label": "t:sections.frame-preview.blocks.frame.settings.note.label", "info": "t:sections.frame-preview.blocks.frame.settings.note.info" },
        { "type": "color", "id": "frame_color", "label": "t:sections.frame-preview.blocks.frame.settings.frame_color.label", "default": "#b08b57" },
        { "type": "range", "id": "frame_width", "min": 2, "max": 40, "step": 2, "unit": "px", "label": "t:sections.frame-preview.blocks.frame.settings.frame_width.label", "default": 14 },
        { "type": "color", "id": "mat_color", "label": "t:sections.frame-preview.blocks.frame.settings.mat_color.label", "default": "#f4f1ea" },
        { "type": "range", "id": "mat_width", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "t:sections.frame-preview.blocks.frame.settings.mat_width.label", "default": 32 }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.frame-preview.presets.name",
      "blocks": [{ "type": "frame" }, { "type": "frame" }, { "type": "frame" }]
    }
  ]
}
{% endschema %}
