{%- comment -%}
  Wall comparison — the same wall before and after the work is hung, revealed by
  dragging a handle across the photograph. It answers the question that stops an
  art purchase: how big does this actually read on a wall?

  Each block is one pairing, with an optional product link and a dimension line
  ("70 x 100 cm, framed"). The control is a native range input, so mouse, touch,
  arrow keys, Home and End all work with no custom key handling.
{%- endcomment -%}
{%- liquid
  assign scheme = section.settings.color_scheme.id | default: 'background-1'
  assign heading_tag = section.settings.heading_tag | default: 'h2'
-%}

<style>
  #shopify-section-{{ section.id }} {
    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;
  }
</style>

<div class="wall-cmp color-scheme--{{ scheme }}">
  <div class="wall-cmp__inner page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subtext != blank -%}
      <div class="wall-cmp__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow" data-animate>{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <{{ heading_tag }} class="section-heading heading--lg" data-animate>{{ section.settings.heading | escape }}</{{ heading_tag }}>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="caption wall-cmp__subtext" data-animate data-animate-delay="2">{{ section.settings.subtext | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="wall-cmp__grid wall-cmp__grid--{{ section.settings.columns_desktop }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign product = block.settings.product
          assign title = block.settings.heading
          if title == blank and product != blank
            assign title = product.title
          endif
          assign before_alt = block.settings.image_before.alt | default: 'sections.wall-comparison.before_alt' | t
          assign after_alt = block.settings.image_after.alt
          if after_alt == blank
            assign after_alt = 'sections.wall-comparison.after_alt' | t: title: title
          endif
        -%}
        <figure class="wall-cmp__item" data-animate {{ block.shopify_attributes }}>
          <div
            class="wall-cmp__frame"
            data-compare
            data-compare-hint="{% if forloop.first %}true{% else %}false{% endif %}"
            style="--reveal: {{ block.settings.start_position }}%;"
          >
            <div class="wall-cmp__stage" data-compare-frame>
              {%- if block.settings.image_before != blank -%}
                {{
                  block.settings.image_before
                  | image_url: width: 1600
                  | image_tag:
                    loading: 'lazy',
                    widths: '500, 700, 900, 1200, 1600',
                    sizes: '(min-width: 990px) 48vw, 100vw',
                    alt: before_alt,
                    class: 'wall-cmp__img wall-cmp__img--before'
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'wall-cmp__img wall-cmp__img--before placeholder' }}
              {%- endif -%}

              <div class="wall-cmp__after" aria-hidden="true">
                {%- if block.settings.image_after != blank -%}
                  {{
                    block.settings.image_after
                    | image_url: width: 1600
                    | image_tag:
                      loading: 'lazy',
                      widths: '500, 700, 900, 1200, 1600',
                      sizes: '(min-width: 990px) 48vw, 100vw',
                      alt: '',
                      class: 'wall-cmp__img wall-cmp__img--after'
                  }}
                {%- else -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'wall-cmp__img wall-cmp__img--after placeholder' }}
                {%- endif -%}
              </div>

              <span class="wall-cmp__line" aria-hidden="true">
                <span class="wall-cmp__grip">{% render 'icon', name: 'chevron-left' %}{% render 'icon', name: 'chevron-right' %}</span>
              </span>

              <input
                class="wall-cmp__input"
                type="range"
                min="0"
                max="100"
                step="1"
                value="{{ block.settings.start_position }}"
                data-compare-input
                aria-label="{{ 'sections.wall-comparison.slider_label' | t: title: title }}"
              >
            </div>

            {%- if block.settings.image_after != blank -%}
              {%- comment -%} The revealed image is decorative inside the widget, so its
                description lives here where a screen reader reaches it in reading order. {%- endcomment -%}
              <p class="visually-hidden">{{ after_alt }}</p>
            {%- endif -%}
          </div>

          <figcaption class="wall-cmp__caption">
            {%- if title != blank -%}
              {%- if product != blank -%}
                <a class="wall-cmp__title link-underline" href="{{ product.url }}">{{ title | escape }}</a>
              {%- else -%}
                <span class="wall-cmp__title">{{ title | escape }}</span>
              {%- endif -%}
            {%- endif -%}
            {%- if block.settings.dimensions != blank -%}
              <span class="wall-cmp__dims">{{ block.settings.dimensions | escape }}</span>
            {%- endif -%}
            {%- if product != blank and section.settings.show_price -%}
              <span class="wall-cmp__price">{% render 'price', product: product %}</span>
            {%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .wall-cmp { padding-block: var(--pt, 96px) var(--pb, 96px); }
  .wall-cmp__head { margin-bottom: clamp(2.5rem, 5vw, 4rem); display: flex; flex-direction: column; gap: var(--space-2); }
  .wall-cmp__subtext { max-width: 60ch; }
  .wall-cmp__grid { display: grid; gap: clamp(2rem, 4vw, 3.5rem); }
  .wall-cmp__grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  /* A single comparison is the point of the section, not a footnote: it gets
     most of the content width so the wall reads at something like scale. */
  .wall-cmp__grid--1 { grid-template-columns: minmax(0, 1fr); max-width: 76rem; margin-inline: auto; }

  .wall-cmp__stage { position: relative; overflow: hidden; background-color: var(--color-subtle); touch-action: pan-y; }
  .wall-cmp__img { width: 100%; display: block; aspect-ratio: 4 / 3; object-fit: cover; }
  /* The "after" photograph is clipped to the handle position. inset-inline-end
     keeps it correct in a right-to-left locale without a second rule. */
  .wall-cmp__after { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--reveal, 50%)) 0 0); }
  .wall-cmp__after .wall-cmp__img { height: 100%; }

  .wall-cmp__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--reveal, 50%);
    width: 2px;
    margin-left: -1px;
    background-color: var(--color-bg);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.18);
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .wall-cmp__grip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--color-bg);
    color: var(--color-text);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.22);
  }
  .wall-cmp__grip .icon { width: 14px; height: 14px; }

  /* The range input covers the frame: it is the drag surface and the focus
     target, painted only as the focus ring (the visible handle is the grip). */
  .wall-cmp__input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background: transparent;
    appearance: none;
    -webkit-appearance: none;
    cursor: ew-resize;
  }
  .wall-cmp__input::-webkit-slider-thumb { -webkit-appearance: none; width: 44px; height: 100%; background: transparent; cursor: ew-resize; }
  .wall-cmp__input::-moz-range-thumb { width: 44px; height: 100%; border: 0; background: transparent; cursor: ew-resize; }
  .wall-cmp__input::-moz-range-track { background: transparent; }
  .wall-cmp__input:focus-visible { outline: 2px solid var(--color-text); outline-offset: -4px; }

  .wall-cmp__caption { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-4); padding-top: var(--space-4); }
  .wall-cmp__title { font-family: var(--font-heading); font-size: var(--text-md); font-weight: var(--font-heading-weight); }
  .wall-cmp__dims, .wall-cmp__price { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--tracking-label); color: var(--color-muted); }

  @media (prefers-reduced-motion: no-preference) {
    .wall-cmp__frame.is-hinting .wall-cmp__after { animation: wall-cmp-hint 1.4s var(--ease-editorial, ease-out); }
    .wall-cmp__frame.is-hinting .wall-cmp__line { animation: wall-cmp-hint-line 1.4s var(--ease-editorial, ease-out); }
    @keyframes wall-cmp-hint {
      35% { clip-path: inset(0 calc(100% - var(--reveal, 50%) - 6%) 0 0); }
      70% { clip-path: inset(0 calc(100% - var(--reveal, 50%) + 4%) 0 0); }
    }
    @keyframes wall-cmp-hint-line {
      35% { transform: translateX(6%); }
      70% { transform: translateX(-4%); }
    }
  }

  @media (max-width: 749px) {
    .wall-cmp__grid--2 { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.wall-comparison.name",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.wall-comparison.settings.eyebrow.label" },
    { "type": "text", "id": "heading", "label": "t:sections.wall-comparison.settings.heading.label", "default": "See it on the wall" },
    {
      "type": "select", "id": "heading_tag", "label": "t:sections.wall-comparison.settings.heading_tag.label",
      "options": [
        { "value": "h2", "label": "t:sections.wall-comparison.settings.heading_tag.options__1.label" },
        { "value": "h3", "label": "t:sections.wall-comparison.settings.heading_tag.options__2.label" },
        { "value": "p", "label": "t:sections.wall-comparison.settings.heading_tag.options__3.label" }
      ],
      "default": "h2"
    },
    { "type": "text", "id": "subtext", "label": "t:sections.wall-comparison.settings.subtext.label", "default": "Drag to see the same wall with the work in place." },
    {
      "type": "select", "id": "columns_desktop", "label": "t:sections.wall-comparison.settings.columns_desktop.label",
      "options": [
        { "value": "1", "label": "t:sections.wall-comparison.settings.columns_desktop.options__1.label" },
        { "value": "2", "label": "t:sections.wall-comparison.settings.columns_desktop.options__2.label" }
      ],
      "default": "2"
    },
    { "type": "checkbox", "id": "show_price", "label": "t:sections.wall-comparison.settings.show_price.label", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.wall-comparison.settings.color_scheme.label", "default": "background-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.wall-comparison.settings.padding_top.label", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.wall-comparison.settings.padding_bottom.label", "default": 96 }
  ],
  "blocks": [
    {
      "type": "pair",
      "name": "t:sections.wall-comparison.blocks.pair.name",
      "settings": [
        { "type": "product", "id": "product", "label": "t:sections.wall-comparison.blocks.pair.settings.product.label" },
        { "type": "text", "id": "heading", "label": "t:sections.wall-comparison.blocks.pair.settings.heading.label", "info": "t:sections.wall-comparison.blocks.pair.settings.heading.info" },
        { "type": "image_picker", "id": "image_before", "label": "t:sections.wall-comparison.blocks.pair.settings.image_before.label" },
        { "type": "image_picker", "id": "image_after", "label": "t:sections.wall-comparison.blocks.pair.settings.image_after.label" },
        { "type": "text", "id": "dimensions", "label": "t:sections.wall-comparison.blocks.pair.settings.dimensions.label", "info": "t:sections.wall-comparison.blocks.pair.settings.dimensions.info" },
        { "type": "range", "id": "start_position", "min": 10, "max": 90, "step": 5, "unit": "%", "label": "t:sections.wall-comparison.blocks.pair.settings.start_position.label", "default": 50 }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.wall-comparison.presets.name",
      "blocks": [ { "type": "pair" }, { "type": "pair" } ]
    }
  ]
}
{% endschema %}
