{%- comment -%}
  Tabs — content or collections behind one strip of labels, switched without a
  page reload (assets/tabs.js owns the ARIA pattern and the keyboard).

  Two block types mix freely in any order: `content` (heading, text, optional
  image) and `collection` (the existing product-card grid for a chosen
  collection). Every panel is server-rendered, so the content is in the HTML
  for crawlers and for a visitor whose JavaScript never arrives: with no JS,
  panels stay visible and the page reads as stacked sections.
{%- endcomment -%}
{%- liquid
  assign scheme = section.settings.color_scheme.id | default: 'background-1'
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  # The panels sit one level under the section heading, or take the top
  # level themselves when the section prints no heading.
  assign panel_tag = 'h2'
  if section.settings.heading != blank
    if heading_tag == 'h1'
      assign panel_tag = 'h2'
    elsif heading_tag == 'h2'
      assign panel_tag = 'h3'
    elsif heading_tag == 'h3'
      assign panel_tag = 'h4'
    endif
  endif
  assign heading_size = section.settings.heading_size | default: 'lg'
-%}

<style>
  #shopify-section-{{ section.id }} {
    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;
    --grid-columns: {{ section.settings.columns_desktop }};
    --grid-columns-mobile: {{ section.settings.columns_mobile }};
  }
</style>

<div class="tabs-section color-scheme--{{ scheme }}">
  <div class="tabs-section__inner page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="tabs-section__head tabs-section__head--{{ section.settings.text_alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow" data-animate>{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <{{ heading_tag }} class="section-heading heading--{{ heading_size }}" data-animate>{{ section.settings.heading | escape }}</{{ heading_tag }}>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="tabs" data-tabs>
        <div class="tabs__list-wrap">
          <div
            class="tabs__list tabs__list--{{ section.settings.tab_alignment }}"
            role="tablist"
            aria-label="{{ section.settings.heading | default: section.settings.tablist_label | escape }}"
            data-tabs-list
          >
            {%- for block in section.blocks -%}
              {%- liquid
                assign label = block.settings.label
                if label == blank
                  if block.type == 'collection' and block.settings.collection != blank
                    assign label = block.settings.collection.title
                  else
                    assign label = 'tabs.untitled' | t
                  endif
                endif
              -%}
              <button
                type="button"
                class="tabs__tab"
                role="tab"
                id="Tab-{{ section.id }}-{{ block.id }}"
                aria-controls="Panel-{{ section.id }}-{{ block.id }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{- label | escape -}}
              </button>
            {%- endfor -%}
          </div>
        </div>

        <div class="tabs__panels">
          {%- for block in section.blocks -%}
            <div
              class="tabs__panel"
              role="tabpanel"
              id="Panel-{{ section.id }}-{{ block.id }}"
              aria-labelledby="Tab-{{ section.id }}-{{ block.id }}"
              tabindex="0"
            >
              {%- case block.type -%}
                {%- when 'content' -%}
                  <div class="tabs-content tabs-content--{{ block.settings.image_position }}{% if block.settings.image == blank %} tabs-content--text-only{% endif %}">
                    {%- if block.settings.image != blank -%}
                      <div class="tabs-content__media">
                        {%- assign tab_alt = block.settings.image.alt | default: block.settings.heading -%}
                        {{
                          block.settings.image
                          | image_url: width: 1200
                          | image_tag:
                            loading: 'lazy',
                            widths: '400, 600, 800, 1000, 1200',
                            sizes: '(min-width: 990px) 45vw, 100vw',
                            alt: tab_alt,
                            class: 'tabs-content__img'
                        }}
                      </div>
                    {%- endif -%}
                    <div class="tabs-content__body">
                      {%- if block.settings.heading != blank -%}
                        <{{ panel_tag }} class="tabs-content__heading">{{ block.settings.heading | escape }}</{{ panel_tag }}>
                      {%- endif -%}
                      {%- if block.settings.text != blank -%}
                        <div class="tabs-content__text prose">{{ block.settings.text }}</div>
                      {%- endif -%}
                      {%- if block.settings.cta_label != blank and block.settings.cta_url != blank -%}
                        <a class="btn btn--outline tabs-content__cta" href="{{ block.settings.cta_url }}">{{ block.settings.cta_label | escape }}</a>
                      {%- endif -%}
                    </div>
                  </div>

                {%- when 'collection' -%}
                  {%- liquid
                    assign tab_collection = block.settings.collection
                    assign tab_limit = block.settings.products_to_show
                  -%}
                  {%- if tab_collection != blank and tab_collection.products_count > 0 -%}
                    <div class="product-grid">
                      {%- for product in tab_collection.products limit: tab_limit -%}
                        {% render 'product-card',
                          product: product,
                          show_vendor: section.settings.show_vendor,
                          heading_tag: panel_tag,
                          quick_add_style: section.settings.quick_add_style
                        %}
                      {%- endfor -%}
                    </div>
                    {%- if block.settings.show_view_all and tab_collection.url != blank -%}
                      <div class="tabs__view-all">
                        <a class="link-underline" href="{{ tab_collection.url }}">
                          {{- 'tabs.view_all' | t: collection: tab_collection.title -}}
                        </a>
                      </div>
                    {%- endif -%}
                  {%- else -%}
                    {%- comment -%} Same onboarding placeholder the other grids use, so the editor preview looks complete before a collection is chosen. {%- endcomment -%}
                    <div class="product-grid">
                      {%- for i in (1..4) -%}
                        <div class="tabs__placeholder">
                          <span class="media media--product placeholder">
                            {{- 'product-1' | placeholder_svg_tag: 'placeholder' -}}
                          </span>
                          <div class="tabs__placeholder-info">
                            <span class="tabs__placeholder-line"></span>
                            <span class="tabs__placeholder-line tabs__placeholder-line--short"></span>
                          </div>
                        </div>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .tabs-section { padding-block: var(--pt, 96px) var(--pb, 96px); }
  .tabs-section__head { margin-bottom: var(--space-8); display: flex; flex-direction: column; gap: var(--space-2); }
  .tabs-section__head--center { align-items: center; text-align: center; }

  /* The strip scrolls on narrow screens instead of wrapping into a block of
     buttons; the rule under it keeps the row reading as one line of labels. */
  .tabs__list-wrap { border-bottom: 1px solid var(--color-border); margin-bottom: var(--space-8); }
  .tabs__list {
    display: flex;
    gap: var(--space-6);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .tabs__list::-webkit-scrollbar { display: none; }
  .tabs__list--center { justify-content: center; }
  .tabs__list--end { justify-content: flex-end; }

  .tabs__tab {
    position: relative;
    flex: 0 0 auto;
    padding: 0 0 var(--space-3);
    background: none;
    border: 0;
    cursor: pointer;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
    min-height: 44px;
    transition: color var(--duration-fast) var(--ease-editorial);
  }
  .tabs__tab::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-editorial);
  }
  .tabs__tab:hover { color: var(--color-text); }
  .tabs__tab[aria-selected="true"] { color: var(--color-text); }
  .tabs__tab[aria-selected="true"]::after { transform: scaleX(1); }
  .tabs__tab:focus-visible { outline: 2px solid var(--color-text); outline-offset: 4px; }

  .tabs__panel:focus-visible { outline: 2px solid var(--color-text); outline-offset: 6px; }
  /* Entrance is opt-in (tabs.js adds is-entered); with motion off the panel is
     painted at its final state, never left mid-fade. */
  .tabs__panel { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .tabs__panel { opacity: 0; transform: translateY(8px); transition: opacity var(--duration-base) var(--ease-editorial), transform var(--duration-base) var(--ease-editorial); }
    .tabs__panel.is-entered { opacity: 1; transform: none; }
  }

  .tabs-content { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: center; grid-template-columns: 1fr 1fr; }
  .tabs-content--right .tabs-content__media { order: 2; }
  .tabs-content--text-only { grid-template-columns: minmax(0, 68ch); justify-content: center; }
  .tabs-content__img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; border-radius: var(--image-radius, 0); }
  .tabs-content__heading { font-family: var(--font-heading); font-size: var(--text-xl); font-weight: var(--font-heading-weight); margin-bottom: var(--space-4); }
  .tabs-content__text { color: var(--color-muted); }
  .tabs-content__cta { margin-top: var(--space-6); }
  .tabs__view-all { margin-top: var(--space-8); text-align: center; }

  .tabs__placeholder { display: flex; flex-direction: column; }
  .tabs__placeholder-info { display: flex; flex-direction: column; gap: var(--space-2); margin-top: var(--space-4); }
  .tabs__placeholder-line { display: block; height: var(--text-base); width: 70%; background-color: var(--color-border); }
  .tabs__placeholder-line--short { width: 35%; }

  @media (max-width: 749px) {
    .tabs-content { grid-template-columns: 1fr; }
    .tabs-content--right .tabs-content__media { order: 0; }
    .tabs__list { gap: var(--space-5); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.tabs.name",
  "tag": "section",
  "class": "shopify-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.tabs.settings.eyebrow.label" },
    { "type": "text", "id": "heading", "label": "t:sections.tabs.settings.heading.label", "default": "Explore" },
    {
      "type": "select", "id": "heading_tag", "label": "t:sections.tabs.settings.heading_tag.label",
      "options": [
        { "value": "h1", "label": "t:sections.tabs.settings.heading_tag.options__1.label" },
        { "value": "h2", "label": "t:sections.tabs.settings.heading_tag.options__2.label" },
        { "value": "h3", "label": "t:sections.tabs.settings.heading_tag.options__3.label" },
        { "value": "p", "label": "t:sections.tabs.settings.heading_tag.options__4.label" }
      ],
      "default": "h2"
    },
    {
      "type": "select", "id": "heading_size", "label": "t:sections.tabs.settings.heading_size.label",
      "options": [
        { "value": "xl", "label": "t:sections.tabs.settings.heading_size.options__1.label" },
        { "value": "lg", "label": "t:sections.tabs.settings.heading_size.options__2.label" },
        { "value": "md", "label": "t:sections.tabs.settings.heading_size.options__3.label" }
      ],
      "default": "lg"
    },
    {
      "type": "select", "id": "text_alignment", "label": "t:sections.tabs.settings.text_alignment.label",
      "options": [
        { "value": "start", "label": "t:sections.tabs.settings.text_alignment.options__1.label" },
        { "value": "center", "label": "t:sections.tabs.settings.text_alignment.options__2.label" }
      ],
      "default": "start"
    },
    {
      "type": "select", "id": "tab_alignment", "label": "t:sections.tabs.settings.tab_alignment.label",
      "options": [
        { "value": "start", "label": "t:sections.tabs.settings.tab_alignment.options__1.label" },
        { "value": "center", "label": "t:sections.tabs.settings.tab_alignment.options__2.label" },
        { "value": "end", "label": "t:sections.tabs.settings.tab_alignment.options__3.label" }
      ],
      "default": "start"
    },
    { "type": "text", "id": "tablist_label", "label": "t:sections.tabs.settings.tablist_label.label", "info": "t:sections.tabs.settings.tablist_label.info", "default": "Content tabs" },
    { "type": "header", "content": "t:sections.tabs.settings.header__grid.content" },
    {
      "type": "select", "id": "columns_desktop", "label": "t:sections.tabs.settings.columns_desktop.label",
      "options": [
        { "value": "2", "label": "t:sections.tabs.settings.columns_desktop.options__1.label" },
        { "value": "3", "label": "t:sections.tabs.settings.columns_desktop.options__2.label" },
        { "value": "4", "label": "t:sections.tabs.settings.columns_desktop.options__3.label" }
      ],
      "default": "4"
    },
    {
      "type": "select", "id": "columns_mobile", "label": "t:sections.tabs.settings.columns_mobile.label",
      "options": [
        { "value": "1", "label": "t:sections.tabs.settings.columns_mobile.options__1.label" },
        { "value": "2", "label": "t:sections.tabs.settings.columns_mobile.options__2.label" }
      ],
      "default": "2"
    },
    { "type": "checkbox", "id": "show_vendor", "label": "t:sections.tabs.settings.show_vendor.label", "default": false },
    {
      "type": "select", "id": "quick_add_style", "label": "t:sections.tabs.settings.quick_add_style.label",
      "options": [
        { "value": "hover", "label": "t:sections.tabs.settings.quick_add_style.options__1.label" },
        { "value": "always", "label": "t:sections.tabs.settings.quick_add_style.options__2.label" }
      ],
      "default": "hover"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.tabs.settings.color_scheme.label", "default": "background-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.tabs.settings.padding_top.label", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.tabs.settings.padding_bottom.label", "default": 96 }
  ],
  "blocks": [
    {
      "type": "content",
      "name": "t:sections.tabs.blocks.content.name",
      "settings": [
        { "type": "text", "id": "label", "label": "t:sections.tabs.blocks.content.settings.label.label", "default": "Story" },
        { "type": "text", "id": "heading", "label": "t:sections.tabs.blocks.content.settings.heading.label" },
        { "type": "richtext", "id": "text", "label": "t:sections.tabs.blocks.content.settings.text.label", "default": "<p>Use this tab for anything a shopper reads rather than buys: how a piece is made, what it is made of, how to care for it.</p>" },
        { "type": "image_picker", "id": "image", "label": "t:sections.tabs.blocks.content.settings.image.label" },
        {
          "type": "select", "id": "image_position", "label": "t:sections.tabs.blocks.content.settings.image_position.label",
          "options": [
            { "value": "left", "label": "t:sections.tabs.blocks.content.settings.image_position.options__1.label" },
            { "value": "right", "label": "t:sections.tabs.blocks.content.settings.image_position.options__2.label" }
          ],
          "default": "left"
        },
        { "type": "text", "id": "cta_label", "label": "t:sections.tabs.blocks.content.settings.cta_label.label" },
        { "type": "url", "id": "cta_url", "label": "t:sections.tabs.blocks.content.settings.cta_url.label" }
      ]
    },
    {
      "type": "collection",
      "name": "t:sections.tabs.blocks.collection.name",
      "settings": [
        { "type": "text", "id": "label", "label": "t:sections.tabs.blocks.collection.settings.label.label", "info": "t:sections.tabs.blocks.collection.settings.label.info" },
        { "type": "collection", "id": "collection", "label": "t:sections.tabs.blocks.collection.settings.collection.label" },
        { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "t:sections.tabs.blocks.collection.settings.products_to_show.label", "default": 4 },
        { "type": "checkbox", "id": "show_view_all", "label": "t:sections.tabs.blocks.collection.settings.show_view_all.label", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.tabs.presets.name",
      "blocks": [
        { "type": "content" },
        { "type": "content" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
