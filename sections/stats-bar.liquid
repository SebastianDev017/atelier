{%- comment -%}
  Stats bar — a horizontal band of 3-4 figures that count up on scroll enter
  (data-counter, handled by initCounters in gsap-animations.js). The number is
  rendered as its final value so reduced-motion / no-JS shows the real figure;
  data-counter holds the comma-stripped numeric for the animation.

  The figures are the merchant's own claims, so none ships with a number: the
  presets used to install an object count, a star rating and a recycled
  share on every store, none of them true for the merchant. A figure shows
  once it has a number; with none the section renders nothing on the
  storefront and an editor-only hint (the featured-product empty state),
  rather than an empty band.
{%- endcomment -%}
{%- liquid
  assign scheme = section.settings.color_scheme.id | default: 'background-1'
  # Reserve one track per filled stat. A fixed repeat(4) left dead columns when
  # a merchant entered fewer than four, squashing them against one edge.
  assign stats_count = 0
  for i in (1..4)
    assign k = 'stat_' | append: i | append: '_number'
    if section.settings[k] != blank
      assign stats_count = stats_count | plus: 1
    endif
  endfor
  assign filled_stats = stats_count
  assign stats_count = stats_count | at_least: 1
-%}

{%- if filled_stats == 0 -%}
  {%- if request.design_mode -%}
    <div class="section-wrapper color-scheme--{{ scheme }}">
      <p class="stats-bar__empty section__inner">{{ 'general.stats_empty' | t }}</p>
    </div>
  {%- endif -%}
{%- else -%}
<style>
  #shopify-section-{{ section.id }} { --pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --stats-count: {{ stats_count }}; }
</style>

<div class="section-wrapper color-scheme--{{ scheme }}">
  <dl class="stats-bar section__inner">
    {%- for i in (1..4) -%}
      {%- liquid
        assign num_key = 'stat_' | append: i | append: '_number'
        assign suf_key = 'stat_' | append: i | append: '_suffix'
        assign lab_key = 'stat_' | append: i | append: '_label'
        assign number = section.settings[num_key]
        assign suffix = section.settings[suf_key]
        assign label = section.settings[lab_key]
        assign counter_val = number | remove: ','
      -%}
      {%- if number != blank -%}
        <div class="stat">
          <dt class="stat__value">
            <span class="stat__num" data-counter="{{ counter_val }}">{{ number | escape }}</span>
            {%- if suffix != blank -%}<span class="stat__suffix">{{ suffix | escape }}</span>{%- endif -%}
          </dt>
          <dd class="stat__label">{{ label | escape }}</dd>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </dl>
</div>
{%- endif -%}

{% stylesheet %}
  .stats-bar {
    display: grid;
    grid-template-columns: repeat(var(--stats-count, 4), 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-block: var(--pt, 80px) var(--pb, 80px);
    margin: 0;
    text-align: center;
  }
  .stats-bar__empty { margin: 0; padding-block: var(--space-12); text-align: center; color: var(--color-muted); }
  .stat__value { display: flex; align-items: baseline; justify-content: center; gap: 0.05em; margin: 0; }
  .stat__num, .stat__suffix {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat__label {
    margin: var(--space-3) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  @media (max-width: 749px) {
    .stats-bar { grid-template-columns: repeat(2, 1fr); gap: var(--space-7) var(--space-4); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.stats-bar.name",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    { "type": "paragraph", "content": "t:sections.stats-bar.settings.paragraph__1.content" },
    { "type": "text", "id": "stat_1_number", "label": "t:sections.stats-bar.settings.stat_1_number.label" },
    { "type": "text", "id": "stat_1_suffix", "label": "t:sections.stats-bar.settings.stat_1_suffix.label", "default": "+" },
    { "type": "text", "id": "stat_1_label", "label": "t:sections.stats-bar.settings.stat_1_label.label", "default": "Objects" },
    { "type": "text", "id": "stat_2_number", "label": "t:sections.stats-bar.settings.stat_2_number.label" },
    { "type": "text", "id": "stat_2_suffix", "label": "t:sections.stats-bar.settings.stat_2_suffix.label" },
    { "type": "text", "id": "stat_2_label", "label": "t:sections.stats-bar.settings.stat_2_label.label", "default": "Makers" },
    { "type": "text", "id": "stat_3_number", "label": "t:sections.stats-bar.settings.stat_3_number.label" },
    { "type": "text", "id": "stat_3_suffix", "label": "t:sections.stats-bar.settings.stat_3_suffix.label", "default": "%" },
    { "type": "text", "id": "stat_3_label", "label": "t:sections.stats-bar.settings.stat_3_label.label", "default": "Recycled or natural" },
    { "type": "text", "id": "stat_4_number", "label": "t:sections.stats-bar.settings.stat_4_number.label" },
    { "type": "text", "id": "stat_4_suffix", "label": "t:sections.stats-bar.settings.stat_4_suffix.label" },
    { "type": "text", "id": "stat_4_label", "label": "t:sections.stats-bar.settings.stat_4_label.label", "default": "Average rating" },
    {"type": "color_scheme", "id": "color_scheme", "label": "t:sections.stats-bar.settings.color_scheme.label", "default": "background-2"},
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.stats-bar.settings.padding_top.label", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.stats-bar.settings.padding_bottom.label", "default": 80 }
  ],
  "presets": [ { "name": "t:sections.stats-bar.presets.name" } ]
}
{% endschema %}
