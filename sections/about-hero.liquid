{%- comment -%}
  About hero — an opening image with the page's heading and one short statement.
  Usable on any page, not only About: the heading falls back to the page title
  so dropping it on a new page already reads correctly.

  Two layouts: `stacked` puts the heading over a full-bleed image (the image
  carries an overlay so the type keeps its contrast), `beside` sets the image
  next to the text with no overlay needed.
{%- endcomment -%}
{%- liquid
  assign scheme = section.settings.color_scheme.id | default: 'background-1'
  assign heading = section.settings.heading | default: page.title
  assign layout = section.settings.layout | default: 'stacked'
  assign heading_tag = section.settings.heading_tag | default: 'h1'
-%}

<style>
  #shopify-section-{{ section.id }} {
    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;
    --about-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --about-hero-min: {{ section.settings.image_height }}vh;
  }
</style>

<div class="about-hero-s about-hero-s--{{ layout }} color-scheme--{{ scheme }}">
  <div class="about-hero-s__inner{% if layout == 'beside' %} page-width{% endif %}">

    {%- if layout == 'stacked' -%}
      <div class="about-hero-s__media" data-animate>
        {%- if section.settings.image != blank -%}
          {%- assign hero_alt = section.settings.image.alt | default: heading -%}
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '600, 900, 1200, 1600, 2000, 2400',
              sizes: '100vw',
              alt: hero_alt,
              class: 'about-hero-s__img'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'about-hero-s__img placeholder' }}
        {%- endif -%}
        <div class="about-hero-s__scrim" aria-hidden="true"></div>
        <div class="about-hero-s__over page-width">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow about-hero-s__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <{{ heading_tag }} class="about-hero-s__title">{{ heading | escape }}</{{ heading_tag }}>
        </div>
      </div>
      {%- if section.settings.statement != blank -%}
        <div class="about-hero-s__statement page-width" data-animate>
          <p class="about-hero-s__statement-text">{{ section.settings.statement }}</p>
        </div>
      {%- endif -%}

    {%- else -%}
      <div class="about-hero-s__grid">
        <div class="about-hero-s__body" data-animate>
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <{{ heading_tag }} class="about-hero-s__title about-hero-s__title--beside">{{ heading | escape }}</{{ heading_tag }}>
          {%- if section.settings.statement != blank -%}
            <p class="about-hero-s__statement-text">{{ section.settings.statement }}</p>
          {%- endif -%}
        </div>
        <div class="about-hero-s__media about-hero-s__media--beside" data-animate data-animate-delay="2">
          {%- if section.settings.image != blank -%}
            {%- assign hero_alt = section.settings.image.alt | default: heading -%}
            {{
              section.settings.image
              | image_url: width: 1400
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                widths: '500, 700, 900, 1200, 1400',
                sizes: '(min-width: 990px) 50vw, 100vw',
                alt: hero_alt,
                class: 'about-hero-s__img'
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'about-hero-s__img placeholder' }}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
  .about-hero-s { padding-block: var(--pt, 0) var(--pb, 64px); }
  .about-hero-s__media { position: relative; overflow: hidden; }
  .about-hero-s__img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .about-hero-s--stacked .about-hero-s__media { min-height: var(--about-hero-min, 60vh); display: grid; }
  .about-hero-s--stacked .about-hero-s__img { grid-area: 1 / 1; min-height: var(--about-hero-min, 60vh); }
  .about-hero-s__scrim {
    grid-area: 1 / 1;
    background: linear-gradient(to top, rgb(0 0 0 / var(--about-hero-overlay, 0.35)), rgb(0 0 0 / calc(var(--about-hero-overlay, 0.35) * 0.35)));
  }
  .about-hero-s__over {
    grid-area: 1 / 1;
    align-self: end;
    padding-block: clamp(2rem, 5vw, 4rem);
    color: var(--color-overlay-text, #fff);
    position: relative;
  }
  .about-hero-s__over .about-hero-s__eyebrow { color: inherit; opacity: 0.85; }

  .about-hero-s__title {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: clamp(2.75rem, 7vw, 6rem);
    line-height: 0.95;
    letter-spacing: var(--heading-letter-spacing, -0.02em);
    text-wrap: balance;
    margin-top: var(--space-3);
  }
  .about-hero-s__title--beside { font-size: clamp(2.5rem, 5vw, 4.5rem); }

  .about-hero-s__statement { margin-top: clamp(2rem, 5vw, 4rem); }
  .about-hero-s__statement-text {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.4vw, 2rem);
    font-weight: var(--font-heading-weight);
    line-height: 1.35;
    max-width: 46ch;
    margin-top: var(--space-5);
  }

  .about-hero-s__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .about-hero-s__media--beside .about-hero-s__img { aspect-ratio: 4 / 5; }

  @media (max-width: 749px) {
    .about-hero-s__grid { grid-template-columns: 1fr; }
    .about-hero-s--stacked .about-hero-s__media,
    .about-hero-s--stacked .about-hero-s__img { min-height: min(var(--about-hero-min, 60vh), 70svh); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.about-hero.name",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    {
      "type": "select", "id": "layout", "label": "t:sections.about-hero.settings.layout.label",
      "options": [
        { "value": "stacked", "label": "t:sections.about-hero.settings.layout.options__1.label" },
        { "value": "beside", "label": "t:sections.about-hero.settings.layout.options__2.label" }
      ],
      "default": "stacked"
    },
    { "type": "image_picker", "id": "image", "label": "t:sections.about-hero.settings.image.label" },
    { "type": "range", "id": "image_height", "min": 30, "max": 90, "step": 5, "unit": "%", "label": "t:sections.about-hero.settings.image_height.label", "default": 60 },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 70, "step": 5, "unit": "%", "label": "t:sections.about-hero.settings.overlay_opacity.label", "default": 35 },
    { "type": "text", "id": "eyebrow", "label": "t:sections.about-hero.settings.eyebrow.label" },
    { "type": "text", "id": "heading", "label": "t:sections.about-hero.settings.heading.label", "info": "t:sections.about-hero.settings.heading.info" },
    {
      "type": "select", "id": "heading_tag", "label": "t:sections.about-hero.settings.heading_tag.label",
      "options": [
        { "value": "h1", "label": "t:sections.about-hero.settings.heading_tag.options__1.label" },
        { "value": "h2", "label": "t:sections.about-hero.settings.heading_tag.options__2.label" }
      ],
      "default": "h1"
    },
    { "type": "textarea", "id": "statement", "label": "t:sections.about-hero.settings.statement.label" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.about-hero.settings.color_scheme.label", "default": "background-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.about-hero.settings.padding_top.label", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.about-hero.settings.padding_bottom.label", "default": 64 }
  ],
  "presets": [ { "name": "t:sections.about-hero.presets.name" } ]
}
{% endschema %}
