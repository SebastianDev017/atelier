{%- comment -%}
  Full-bleed image — edge-to-edge (no horizontal padding), selectable height,
  optional caption rendered bottom-left over the image, and an optional dark
  overlay. Mirrors the theme pattern: inline <style> for per-instance values,
  {% stylesheet %} for component CSS with no Liquid.
{%- endcomment -%}
{%- liquid
  assign image = section.settings.image
  assign overlay = section.settings.overlay_opacity | divided_by: 100.0

  assign fbi_height = '55svh'
  case section.settings.image_height
    when 'compact'
      assign fbi_height = '40svh'
    when 'medium'
      assign fbi_height = '55svh'
    when 'large'
      assign fbi_height = '70svh'
    when 'cinematic'
      assign fbi_height = '85svh'
  endcase

  assign fbi_alt = image.alt | default: section.settings.caption | escape

  # The caption is painted in --color-overlay-text, the light-on-photo colour.
  # With no image there is no photo under it, only the placeholder on the
  # scheme's own ground -- 2.26:1 on the Maison install state, which ships with
  # this section imageless. Same shape as .hero--no-image and
  # .about-hero-s--no-image: take the scheme's ink and drop the overlay.
  assign fbi_has_image = false
  if image != blank
    assign fbi_has_image = true
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    --fbi-height: {{ fbi_height }};
    --fbi-overlay: {{ overlay }};
  }
</style>

<div class="full-bleed-image section--full-bleed{% unless fbi_has_image %} full-bleed-image--no-image{% endunless %}">
  <div class="full-bleed-image__media">
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 3000
        | image_tag:
          loading: 'lazy', decoding: 'async',
          widths: '750, 1100, 1500, 2000, 2600, 3000',
          sizes: '100vw',
          alt: fbi_alt,
          class: 'full-bleed-image__img'
      }}
    {%- else -%}
      <div class="full-bleed-image__placeholder">
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
      </div>
    {%- endif -%}

    {%- if section.settings.overlay_opacity > 0 and fbi_has_image -%}
      <div class="full-bleed-image__overlay" aria-hidden="true"></div>
    {%- endif -%}

    {%- if section.settings.caption != blank -%}
      <p class="full-bleed-image__caption">{{ section.settings.caption | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .full-bleed-image__media {
    position: relative;
    width: 100%;
    height: var(--fbi-height, 55svh);
    overflow: hidden;
    background-color: var(--color-subtle);
  }
  .full-bleed-image__img,
  .full-bleed-image__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .full-bleed-image__placeholder svg { width: 100%; height: 100%; object-fit: cover; }
  .full-bleed-image__overlay {
    position: absolute;
    inset: 0;
    background-color: #0A0705;
    opacity: var(--fbi-overlay, 0);
  }
  .full-bleed-image--no-image { --color-overlay-text: var(--color-text); }
  .full-bleed-image__caption {
    position: absolute;
    left: var(--page-margin, 1.5rem);
    bottom: var(--page-margin, 1.5rem);
    z-index: 2;
    margin: 0;
    color: var(--color-overlay-text, #FAF7F2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.full-bleed-image.name",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.full-bleed-image.settings.image.label"
    },
    {
      "type": "select",
      "id": "image_height",
      "label": "t:sections.full-bleed-image.settings.image_height.label",
      "options": [
        { "value": "compact", "label": "t:sections.full-bleed-image.settings.image_height.options__1.label" },
        { "value": "medium", "label": "t:sections.full-bleed-image.settings.image_height.options__2.label" },
        { "value": "large", "label": "t:sections.full-bleed-image.settings.image_height.options__3.label" },
        { "value": "cinematic", "label": "t:sections.full-bleed-image.settings.image_height.options__4.label" }
      ],
      "default": "medium"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "t:sections.full-bleed-image.settings.caption.label",
      "info": "t:sections.full-bleed-image.settings.caption.info"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "t:sections.full-bleed-image.settings.overlay_opacity.label",
      "default": 0
    }
  ],
  "presets": [
    { "name": "t:sections.full-bleed-image.presets.name" }
  ]
}
{% endschema %}
