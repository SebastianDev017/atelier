{%- comment -%}
  Complementary recommendations — "Frequently bought with".

  Shopify treats `intent=complementary` as a distinct recommendation type from
  `intent=related`: complementary comes from the merchant's Search & Discovery
  product relationships, related is algorithmic similarity. They answer different
  questions, so this is a separate request rather than a variation of the
  related-products section.

  Reuses the <product-recommendations> element already implemented in
  product.js, which lazy-loads on intersection and swaps the fetched markup in.
  Renders nothing until that fetch returns, so a shop with no complementary
  relationships set up shows no empty heading.
{%- endcomment -%}
{%- liquid
  assign scheme = section.settings.color_scheme.id | default: 'background-1'
  assign limit = section.settings.products_to_show
-%}

<style>
  #shopify-section-{{ section.id }} {
    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;
    --grid-columns: {{ section.settings.columns_desktop }};
    --grid-columns-mobile: 2;
  }
</style>

<product-recommendations
  class="complementary color-scheme--{{ scheme }}"
  data-section-id="{{ section.id }}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}&intent=complementary"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      <div class="section-header">
        <h2 class="h4" data-animate>{{ section.settings.heading | escape }}</h2>
      </div>
      <div class="product-grid">
        {%- for product in recommendations.products limit: limit -%}
          <div data-animate data-animate-delay="{{ forloop.index | modulo: 5 | plus: 1 }}">
            {% render 'product-card', product: product, quick_add_style: section.settings.quick_add_style %}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</product-recommendations>

{% stylesheet %}
  .complementary { padding-block: var(--pt, var(--space-12)) var(--pb, var(--space-12)); }
  /* Renders empty until the lazy fetch returns, and stays empty when the shop
     has no complementary relationships set up -- so it must collapse. */
  .complementary:empty { display: none; }
  .complementary .section-header { margin-bottom: var(--space-6); }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.complementary-products.name",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.complementary-products.settings.heading.label", "default": "Frequently bought with" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 6, "step": 1, "label": "t:sections.complementary-products.settings.products_to_show.label", "default": 3 },
    {
      "type": "select",
      "id": "quick_add_style",
      "label": "t:sections.complementary-products.settings.quick_add_style.label",
      "options": [
        { "value": "hover", "label": "t:sections.complementary-products.settings.quick_add_style.options__1.label" },
        { "value": "always", "label": "t:sections.complementary-products.settings.quick_add_style.options__2.label" }
      ],
      "default": "hover"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:sections.complementary-products.settings.columns_desktop.label",
      "options": [
        { "value": "2", "label": "t:sections.complementary-products.settings.columns_desktop.options__1.label" },
        { "value": "3", "label": "t:sections.complementary-products.settings.columns_desktop.options__2.label" },
        { "value": "4", "label": "t:sections.complementary-products.settings.columns_desktop.options__3.label" }
      ],
      "default": "3"
    },
    {"type": "color_scheme", "id": "color_scheme", "label": "t:sections.complementary-products.settings.color_scheme.label", "default": "background-1"},
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "t:sections.complementary-products.settings.padding_top.label", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "t:sections.complementary-products.settings.padding_bottom.label", "default": 48 }
  ],
  "presets": [{ "name": "t:sections.complementary-products.presets.name" }]
}
{% endschema %}
