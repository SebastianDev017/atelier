{%- comment -%}
  FAQ ledger — the questions a considered purchase actually stalls on.

  Furniture is not abandoned because the photograph was wrong. It is abandoned
  at "when would it arrive", "can I get it up the stairs", "what happens when
  a leg breaks in four years". Those answers belong on the page where the
  decision is being made, not two clicks away in a policy page.

  Built on <details>, so it opens with a click, a tap, Enter or Space, reads
  correctly to a screen reader, is findable by the browser's own find-on-page
  in browsers that expand closed details, and needs no JavaScript at all. The
  heading column is sticky beside the list on a wide screen and simply sits
  above it on a narrow one.
{%- endcomment -%}
{%- liquid
  assign scheme = section.settings.color_scheme.id | default: 'background-1'
  assign heading_tag = section.settings.heading_tag | default: 'h2'
-%}

<style>
  #shopify-section-{{ section.id }} {
    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;
  }
</style>

<div class="faqled color-scheme--{{ scheme }}">
  <div class="faqled__inner page-width">
    <div class="faqled__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow" data-animate>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="section-heading heading--lg faqled__heading" data-animate>
          {{ section.settings.heading | escape }}
        </{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="prose faqled__text" data-animate>{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a class="btn btn--link faqled__link" href="{{ section.settings.link }}" data-animate>
          {{ section.settings.link_label | escape }}
          {% render 'icon', name: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="faqled__list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign n = forloop.index
            assign n_padded = n
            if n < 10
              assign n_padded = n | prepend: '0'
            endif
          -%}
          <details
            class="faqled__item"
            {% if block.settings.open_by_default %}open{% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="faqled__summary">
              <span class="faqled__num label" aria-hidden="true">{{ n_padded }}</span>
              <span class="faqled__q">{{ block.settings.question | escape }}</span>
              <span class="faqled__mark" aria-hidden="true">
                {% render 'icon', name: 'plus' %}
                {% render 'icon', name: 'minus' %}
              </span>
            </summary>
            <div class="faqled__a prose">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="faqled__list">
        <p class="caption">{{ 'sections.faq-ledger.onboarding' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .faqled { padding-block: var(--pt, 96px) var(--pb, 96px); }
  .faqled__inner { display: grid; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .faqled__heading { margin-top: var(--space-2); }
  .faqled__text { margin-top: var(--space-4); color: var(--color-muted); max-width: 40ch; }
  .faqled__link { margin-top: var(--space-5); }

  /* A ruled ledger: one hairline per question, the last one closing the set. */
  .faqled__item { border-top: 1px solid var(--color-border); }
  .faqled__item:last-child { border-bottom: 1px solid var(--color-border); }

  .faqled__summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-4);
    min-height: 44px;
    cursor: pointer;
    list-style: none;
  }
  .faqled__summary::-webkit-details-marker { display: none; }
  .faqled__summary:focus-visible { outline: 2px solid var(--color-text); outline-offset: 2px; }

  .faqled__num { color: var(--color-muted); }
  .faqled__q {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    line-height: 1.3;
    color: var(--color-heading, var(--color-text));
  }
  /* Underline on hover, never a colour change: the accent fails contrast on
     some schemes and a rule does not depend on it. */
  .faqled__summary:hover .faqled__q { text-decoration: underline; text-underline-offset: 0.16em; text-decoration-thickness: 1px; }

  /* Plus becomes minus. Both glyphs ship; open state decides which shows, so
     the state is never carried by rotation alone. */
  .faqled__mark { position: relative; align-self: center; width: 14px; height: 14px; color: var(--color-muted); }
  .faqled__mark .icon { position: absolute; inset: 0; width: 14px; height: 14px; transition: opacity var(--duration-fast) var(--ease-editorial); }
  .faqled__mark .icon:last-child { opacity: 0; }
  .faqled__item[open] .faqled__mark .icon:first-child { opacity: 0; }
  .faqled__item[open] .faqled__mark .icon:last-child { opacity: 1; }

  .faqled__a { padding-inline-start: calc(2ch + var(--space-4)); padding-bottom: var(--space-5); max-width: 62ch; color: var(--color-muted); }

  @media (min-width: 990px) {
    .faqled__inner { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
    .faqled__intro { position: sticky; top: var(--space-10, 4rem); }
  }
  @media (max-width: 749px) {
    .faqled__summary { gap: var(--space-3); }
    .faqled__q { font-size: var(--text-base); }
    .faqled__a { padding-inline-start: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.faq-ledger.name",
  "tag": "section",
  "class": "shopify-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.faq-ledger.settings.eyebrow.label", "default": "Before you order" },
    { "type": "text", "id": "heading", "label": "t:sections.faq-ledger.settings.heading.label", "default": "Questions, answered" },
    {
      "type": "select", "id": "heading_tag", "label": "t:sections.faq-ledger.settings.heading_tag.label",
      "options": [
        { "value": "h2", "label": "t:sections.faq-ledger.settings.heading_tag.options__1.label" },
        { "value": "h3", "label": "t:sections.faq-ledger.settings.heading_tag.options__2.label" },
        { "value": "p", "label": "t:sections.faq-ledger.settings.heading_tag.options__3.label" }
      ],
      "default": "h2"
    },
    { "type": "richtext", "id": "text", "label": "t:sections.faq-ledger.settings.text.label" },
    { "type": "url", "id": "link", "label": "t:sections.faq-ledger.settings.link.label" },
    { "type": "text", "id": "link_label", "label": "t:sections.faq-ledger.settings.link_label.label" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.faq-ledger.settings.color_scheme.label", "default": "background-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.faq-ledger.settings.padding_top.label", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.faq-ledger.settings.padding_bottom.label", "default": 96 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.faq-ledger.blocks.question.name",
      "settings": [
        { "type": "text", "id": "question", "label": "t:sections.faq-ledger.blocks.question.settings.question.label", "default": "When will it arrive?" },
        { "type": "richtext", "id": "answer", "label": "t:sections.faq-ledger.blocks.question.settings.answer.label", "default": "<p>Write the answer a customer would get if they emailed you.</p>" },
        { "type": "checkbox", "id": "open_by_default", "label": "t:sections.faq-ledger.blocks.question.settings.open_by_default.label", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq-ledger.presets.name",
      "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
