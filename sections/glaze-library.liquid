{%- comment -%}
  Glaze library — the studio's palette, named, with what each one does.

  A pottery is not browsed the way a warehouse is. People come back for the
  celadon, or they will not have the iron black on the table, and the glaze
  is the thing they are choosing long before they have chosen a bowl. A
  catalogue sorted by shape cannot answer that; a wall of named specimens can.

  A glaze is a colour and a sentence, so that is what a block is: a colour
  the merchant picks, a name, and a line about how it behaves. A photograph
  is optional and takes over the tile when it is set, because a glaze with
  real depth or speckle is better shown than mixed. Every tile is a link, and
  the name is always text, so the colour is never the only thing telling two
  glazes apart.
{%- endcomment -%}
{%- liquid
  assign scheme = section.settings.color_scheme.id | default: 'background-1'
  assign heading_tag = section.settings.heading_tag | default: 'h2'
-%}

<style>
  #shopify-section-{{ section.id }} {
    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;
    --glz-cols: {{ section.settings.columns | default: 4 }};
    --glz-radius: {% if section.settings.swatch_shape == 'circle' %}50%{% else %}0{% endif %};
  }
</style>

<div class="glzlib color-scheme--{{ scheme }}">
  <div class="glzlib__inner page-width">
    <div class="glzlib__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow" data-animate>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="section-heading heading--lg glzlib__heading" data-animate>
          {{ section.settings.heading | escape }}
        </{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="prose glzlib__text" data-animate>{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
        <a class="btn btn--link glzlib__cta" href="{{ section.settings.cta_link }}" data-animate>
          {{ section.settings.cta_label | escape }}
          {% render 'icon', name: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="glzlib__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign n = forloop.index
            assign n_padded = n
            if n < 10
              assign n_padded = n | prepend: '0'
            endif
          -%}
          <li class="glzlib__item" data-animate data-animate-delay="{{ forloop.index | modulo: 5 | plus: 1 }}" {{ block.shopify_attributes }}>
            <a class="glzlib__tile" href="{{ block.settings.link | default: '#' }}">
              <span class="glzlib__swatch" style="--glz-color: {{ block.settings.color | default: '#cfc7b8' }};">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      decoding: 'async',
                      widths: '200, 300, 400, 600',
                      sizes: '(min-width: 990px) 16vw, 44vw',
                      alt: '',
                      class: 'glzlib__img'
                  }}
                {%- endif -%}
              </span>
              <span class="glzlib__meta">
                <span class="glzlib__num label" aria-hidden="true">{{ n_padded }}</span>
                <span class="glzlib__name">{{ block.settings.name | escape }}</span>
                {%- if section.settings.show_notes and block.settings.note != blank -%}
                  <span class="glzlib__note">{{ block.settings.note | escape }}</span>
                {%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="caption">{{ 'sections.glaze-library.onboarding' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .glzlib { padding-block: var(--pt, 96px) var(--pb, 96px); }
  .glzlib__inner { display: grid; gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .glzlib__heading { margin-top: var(--space-2); }
  .glzlib__text { margin-top: var(--space-4); max-width: 38ch; color: var(--color-muted); }
  .glzlib__cta { margin-top: var(--space-5); }

  /* A specimen wall: tiles tight together, the names doing the sorting. */
  .glzlib__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5) var(--space-4); }
  .glzlib__tile { display: block; text-decoration: none; color: inherit; }
  .glzlib__swatch {
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: var(--glz-radius, 0);
    background-color: var(--glz-color, #cfc7b8);
    overflow: hidden;
    position: relative;
    transition: transform var(--duration-base) var(--ease-editorial);
  }
  .glzlib__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .glzlib__tile:hover .glzlib__swatch { transform: scale(1.02); }

  .glzlib__meta { display: block; margin-top: var(--space-3); }
  .glzlib__num { color: var(--color-muted); }
  .glzlib__name { display: block; margin-top: 0.15rem; font-family: var(--font-heading); font-size: var(--text-base); line-height: 1.25; color: var(--color-heading, var(--color-text)); }
  /* Underline, not a tint: the swatch is the only coloured thing here and it
     is decoration, so the hover signal cannot be a colour. */
  .glzlib__tile:hover .glzlib__name { text-decoration: underline; text-underline-offset: 0.16em; text-decoration-thickness: 1px; }
  .glzlib__tile:focus-visible { outline: 2px solid var(--color-text); outline-offset: 4px; }
  .glzlib__note { display: block; margin-top: 0.35rem; font-family: var(--font-mono); font-size: var(--text-xs); line-height: 1.6; color: var(--color-muted); }

  @media (min-width: 750px) {
    .glzlib__grid { grid-template-columns: repeat(var(--glz-cols, 4), minmax(0, 1fr)); }
  }
  @media (min-width: 990px) {
    .glzlib__inner { grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.45fr); }
    .glzlib__intro { position: sticky; top: var(--space-10, 4rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .glzlib__swatch { transition: none; }
    .glzlib__tile:hover .glzlib__swatch { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.glaze-library.name",
  "tag": "section",
  "class": "shopify-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.glaze-library.settings.eyebrow.label", "default": "The glazes" },
    { "type": "text", "id": "heading", "label": "t:sections.glaze-library.settings.heading.label", "default": "Mixed in the studio" },
    {
      "type": "select", "id": "heading_tag", "label": "t:sections.glaze-library.settings.heading_tag.label",
      "options": [
        { "value": "h2", "label": "t:sections.glaze-library.settings.heading_tag.options__1.label" },
        { "value": "h3", "label": "t:sections.glaze-library.settings.heading_tag.options__2.label" },
        { "value": "p", "label": "t:sections.glaze-library.settings.heading_tag.options__3.label" }
      ],
      "default": "h2"
    },
    { "type": "richtext", "id": "text", "label": "t:sections.glaze-library.settings.text.label" },
    { "type": "url", "id": "cta_link", "label": "t:sections.glaze-library.settings.cta_link.label" },
    { "type": "text", "id": "cta_label", "label": "t:sections.glaze-library.settings.cta_label.label" },
    { "type": "range", "id": "columns", "min": 2, "max": 6, "step": 1, "label": "t:sections.glaze-library.settings.columns.label", "default": 4 },
    {
      "type": "select", "id": "swatch_shape", "label": "t:sections.glaze-library.settings.swatch_shape.label",
      "options": [
        { "value": "square", "label": "t:sections.glaze-library.settings.swatch_shape.options__1.label" },
        { "value": "circle", "label": "t:sections.glaze-library.settings.swatch_shape.options__2.label" }
      ],
      "default": "square"
    },
    { "type": "checkbox", "id": "show_notes", "label": "t:sections.glaze-library.settings.show_notes.label", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.glaze-library.settings.color_scheme.label", "default": "background-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.glaze-library.settings.padding_top.label", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.glaze-library.settings.padding_bottom.label", "default": 96 }
  ],
  "blocks": [
    {
      "type": "glaze",
      "name": "t:sections.glaze-library.blocks.glaze.name",
      "settings": [
        { "type": "text", "id": "name", "label": "t:sections.glaze-library.blocks.glaze.settings.name.label", "default": "Celadon" },
        { "type": "color", "id": "color", "label": "t:sections.glaze-library.blocks.glaze.settings.color.label", "default": "#b9c4bb" },
        { "type": "image_picker", "id": "image", "label": "t:sections.glaze-library.blocks.glaze.settings.image.label", "info": "t:sections.glaze-library.blocks.glaze.settings.image.info" },
        { "type": "text", "id": "note", "label": "t:sections.glaze-library.blocks.glaze.settings.note.label", "info": "t:sections.glaze-library.blocks.glaze.settings.note.info" },
        { "type": "url", "id": "link", "label": "t:sections.glaze-library.blocks.glaze.settings.link.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.glaze-library.presets.name",
      "blocks": [{ "type": "glaze" }, { "type": "glaze" }, { "type": "glaze" }, { "type": "glaze" }]
    }
  ]
}
{% endschema %}
