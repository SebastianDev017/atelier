{%- comment -%}
  Process timeline — the making, in order: throwing, glazing, firing, finishing.
  The sequence is the content here, so the steps are numbered and connected by a
  rule; on a phone the same rule runs vertically down the left.

  Extends the maker-spotlight language (mono micro-labels, unadorned photography,
  no cards) rather than introducing a second visual system for the same subject.
{%- endcomment -%}
{%- liquid
  assign scheme = section.settings.color_scheme.id | default: 'background-2'
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign count = section.blocks.size | at_least: 1
  comment
    A step is legible as a number and a label alone, so the photograph row
    appears only when the process is photographed. Mixing the two leaves
    onboarding placeholders standing beside real pictures.
  endcomment
  assign has_media = false
  for b in section.blocks
    if b.settings.image != blank
      assign has_media = true
      break
    endif
  endfor
-%}

<style>
  #shopify-section-{{ section.id }} {
    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;
    --steps: {{ count }};
  }
</style>

<div class="ptl color-scheme--{{ scheme }}">
  <div class="ptl__inner page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subtext != blank -%}
      <div class="ptl__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow" data-animate>{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <{{ heading_tag }} class="section-heading heading--lg" data-animate>{{ section.settings.heading | escape }}</{{ heading_tag }}>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="caption ptl__subtext" data-animate data-animate-delay="2">{{ section.settings.subtext | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ol class="ptl__steps">
        {%- for block in section.blocks -%}
          <li class="ptl__step" data-animate data-animate-delay="{{ forloop.index | modulo: 5 | plus: 1 }}" {{ block.shopify_attributes }}>
            {%- if has_media -%}
              <div class="ptl__media media media--square">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 450, 600, 900',
                      sizes: '(min-width: 990px) 22vw, 70vw',
                      alt: block.settings.image.alt | default: block.settings.label,
                      class: 'ptl__img'
                  }}
                {%- else -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
                {%- endif -%}
              </div>
            {%- endif -%}
            <div class="ptl__marker" aria-hidden="true">
              <span class="ptl__num">{{ forloop.index }}</span>
            </div>
            <div class="ptl__body">
              {%- if block.settings.label != blank -%}
                <h3 class="ptl__label">{{ block.settings.label | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.duration != blank -%}
                <span class="ptl__duration">{{ block.settings.duration | escape }}</span>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="ptl__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
      <div class="ptl__actions" data-animate>
        <a class="btn btn--outline" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ptl { padding-block: var(--pt, 96px) var(--pb, 96px); }
  .ptl__head { margin-bottom: clamp(2.5rem, 5vw, 4rem); display: flex; flex-direction: column; gap: var(--space-2); }
  .ptl__subtext { max-width: 60ch; }

  .ptl__steps {
    display: grid;
    grid-template-columns: repeat(var(--steps, 4), minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    list-style: none;
    counter-reset: none;
  }
  .ptl__step { display: flex; flex-direction: column; position: relative; }
  /* The ratio lives on the wrapper so a photograph and a placeholder occupy
     the same box and every step starts its text on the same line. */
  .ptl__media { border-radius: var(--image-radius, 0); overflow: hidden; }

  /* Unphotographed: the number carries the step, so give it more room. */
  .ptl__step:not(:has(.ptl__media)) .ptl__marker { padding-block: 0 var(--space-4); }

  /* The rule that ties the steps together, drawn from the marker outwards so it
     never crosses the photograph. */
  .ptl__marker { position: relative; display: flex; align-items: center; padding-block: var(--space-5) var(--space-4); }
  .ptl__marker::before,
  .ptl__marker::after {
    content: "";
    position: absolute;
    top: 50%;
    height: 1px;
    background-color: var(--color-border);
  }
  .ptl__marker::before { inset-inline-start: 0; width: calc(50% - 1.35rem); }
  .ptl__marker::after { inset-inline-end: 0; width: calc(50% - 1.35rem); }
  .ptl__step:first-child .ptl__marker::before,
  .ptl__step:last-child .ptl__marker::after { display: none; }
  .ptl__num {
    position: relative;
    margin-inline: auto;
    width: 2.25rem;
    height: 2.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text);
    background-color: var(--color-bg);
  }

  .ptl__body { display: flex; flex-direction: column; gap: var(--space-2); }
  .ptl__label { font-family: var(--font-heading); font-size: var(--text-lg); font-weight: var(--font-heading-weight); letter-spacing: var(--heading-letter-spacing, -0.02em); }
  .ptl__duration { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--color-muted); }
  .ptl__text { color: var(--color-muted); font-size: var(--text-sm); line-height: 1.65; max-width: 38ch; }
  .ptl__actions { margin-top: clamp(2.5rem, 5vw, 4rem); }

  @media (max-width: 989px) {
    /* Vertical: photo and text side by side, the rule running down the markers. */
    .ptl__steps { grid-template-columns: 1fr; gap: 0; }
    .ptl__step {
      display: grid;
      grid-template-columns: 4.5rem minmax(0, 1fr);
      grid-template-areas: "marker media" "marker body";
      column-gap: var(--space-4);
      padding-bottom: var(--space-8);
    }
    .ptl__media { grid-area: media; aspect-ratio: 3 / 2; }
    .ptl__step:not(:has(.ptl__media)) { grid-template-areas: "marker body"; }
    .ptl__body { grid-area: body; padding-top: var(--space-4); }
    .ptl__marker { grid-area: marker; padding: 0; align-items: flex-start; justify-content: center; }
    .ptl__marker::before,
    .ptl__marker::after { top: auto; height: auto; width: 1px; inset-inline: 50% auto; }
    .ptl__marker::before { display: none; }
    .ptl__marker::after { top: 2.75rem; bottom: calc(-1 * var(--space-8)); width: 1px; inset-inline-start: calc(50% - 0.5px); }
    .ptl__step:last-child .ptl__marker::after { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.process-timeline.name",
  "tag": "section",
  "class": "shopify-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.process-timeline.settings.eyebrow.label" },
    { "type": "text", "id": "heading", "label": "t:sections.process-timeline.settings.heading.label", "default": "From clay to table" },
    {
      "type": "select", "id": "heading_tag", "label": "t:sections.process-timeline.settings.heading_tag.label",
      "options": [
        { "value": "h2", "label": "t:sections.process-timeline.settings.heading_tag.options__1.label" },
        { "value": "h3", "label": "t:sections.process-timeline.settings.heading_tag.options__2.label" },
        { "value": "p", "label": "t:sections.process-timeline.settings.heading_tag.options__3.label" }
      ],
      "default": "h2"
    },
    { "type": "text", "id": "subtext", "label": "t:sections.process-timeline.settings.subtext.label" },
    { "type": "text", "id": "cta_label", "label": "t:sections.process-timeline.settings.cta_label.label" },
    { "type": "url", "id": "cta_url", "label": "t:sections.process-timeline.settings.cta_url.label" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.process-timeline.settings.color_scheme.label", "default": "background-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.process-timeline.settings.padding_top.label", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.process-timeline.settings.padding_bottom.label", "default": 96 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:sections.process-timeline.blocks.step.name",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:sections.process-timeline.blocks.step.settings.image.label" },
        { "type": "text", "id": "label", "label": "t:sections.process-timeline.blocks.step.settings.label.label", "default": "Throwing" },
        { "type": "text", "id": "duration", "label": "t:sections.process-timeline.blocks.step.settings.duration.label", "info": "t:sections.process-timeline.blocks.step.settings.duration.info" },
        { "type": "textarea", "id": "text", "label": "t:sections.process-timeline.blocks.step.settings.text.label", "default": "One sentence on what happens at this stage and why it takes the time it takes." }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.process-timeline.presets.name",
      "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" }, { "type": "step" } ]
    }
  ]
}
{% endschema %}
