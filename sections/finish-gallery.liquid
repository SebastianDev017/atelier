{%- comment -%}
  Finish gallery — every finish of one product, side by side, each with the photo
  that actually shows it. A shopper comparing oak against walnut should not have
  to click the variant picker four times and remember what they saw.

  The data is already on the product: the colour option linked to
  shopify.color-pattern gives the swatch, and the variant's own image gives the
  photograph. A finish with no photo of its own falls back to its swatch colour
  rather than repeating the same picture under four different names.

  On a product page it defaults to the product being viewed, so one instance in
  the product template serves every multi-finish product in the catalog.
{%- endcomment -%}
{%- liquid
  assign scheme = section.settings.color_scheme.id | default: 'background-1'
  assign heading_tag = section.settings.heading_tag | default: 'h2'

  assign target = section.settings.product
  if target == blank and product != blank
    assign target = product
  endif

  assign finish_option = nil
  for opt in target.options_with_values
    assign opt_key = opt.name | downcase | strip
    if section.settings.option_name != blank
      assign wanted = section.settings.option_name | downcase | strip
      if opt_key == wanted
        assign finish_option = opt
        break
      endif
    else
      for opt_value in opt.values
        if opt_value.swatch
          assign finish_option = opt
          break
        endif
      endfor
      if finish_option != nil
        break
      endif
    endif
  endfor
-%}

{%- if finish_option != nil -%}
  <style>
    #shopify-section-{{ section.id }} {
      --pt: {{ section.settings.padding_top }}px;
      --pb: {{ section.settings.padding_bottom }}px;
      --finish-columns: {{ section.settings.columns_desktop }};
    }
  </style>

  <div class="finishes color-scheme--{{ scheme }}">
    <div class="finishes__inner page-width">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <div class="finishes__head">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow" data-animate>{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <{{ heading_tag }} class="section-heading heading--lg" data-animate>{{ section.settings.heading | escape }}</{{ heading_tag }}>
          {%- endif -%}
          {%- if section.settings.show_option_name -%}
            <p class="caption finishes__count" data-animate data-animate-delay="2">
              {{- 'sections.finish-gallery.count' | t: count: finish_option.values.size, option: finish_option.name -}}
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <ul class="finishes__grid" role="list">
        {%- for value in finish_option.values -%}
          {%- liquid
            assign fin_variant = value.variant
            assign fin_media = fin_variant.featured_media | default: fin_variant.image
            assign fin_url = target.url
            if fin_variant != blank
              assign fin_url = fin_variant.url
            endif
          -%}
          <li class="finish" data-animate data-animate-delay="{{ forloop.index | modulo: 5 | plus: 1 }}">
            <a class="finish__link" href="{{ fin_url }}">
              <span class="finish__media">
                {%- if fin_media != blank -%}
                  {%- assign finish_alt = fin_media.alt | default: value.name -%}
                  {{
                    fin_media
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy', decoding: 'async',
                      widths: '250, 400, 600, 900',
                      sizes: '(min-width: 990px) 24vw, 45vw',
                      alt: finish_alt,
                      class: 'finish__img'
                  }}
                {%- elsif value.swatch.image != blank -%}
                  {{
                    value.swatch.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy', decoding: 'async',
                      widths: '250, 400, 600, 900',
                      sizes: '(min-width: 990px) 24vw, 45vw',
                      alt: value.name,
                      class: 'finish__img'
                  }}
                {%- elsif value.swatch.color != blank -%}
                  {%- comment -%} No photograph for this finish: show the colour itself rather than the wrong picture. {%- endcomment -%}
                  <span class="finish__fill" style="background-color: {{ value.swatch.color }};"></span>
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'finish__img placeholder' }}
                {%- endif -%}
              </span>
              <span class="finish__meta">
                {%- if value.swatch -%}
                  <span class="finish__dot" aria-hidden="true">{% render 'swatch', value: value %}</span>
                {%- endif -%}
                <span class="finish__name">{{ value.name | escape }}</span>
                {%- unless value.available -%}
                  <span class="finish__status">{{ 'products.sold_out' | t }}</span>
                {%- endunless -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- elsif request.design_mode -%}
  {%- comment -%} Nothing to compare: tell the merchant why, only in the editor. {%- endcomment -%}
  <div class="finishes color-scheme--{{ scheme }}">
    <div class="finishes__inner page-width">
      <p class="caption">{{ 'sections.finish-gallery.empty' | t }}</p>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .finishes { padding-block: var(--pt, 96px) var(--pb, 96px); }
  .finishes__head { margin-bottom: clamp(2rem, 4vw, 3rem); display: flex; flex-direction: column; gap: var(--space-2); }
  .finishes__grid {
    display: grid;
    grid-template-columns: repeat(var(--finish-columns, 4), minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
    list-style: none;
  }
  .finish__link { display: flex; flex-direction: column; gap: var(--space-3); text-decoration: none; color: inherit; }
  .finish__media { display: block; overflow: hidden; background-color: var(--color-subtle); border-radius: var(--image-radius, 0); }
  .finish__img, .finish__fill { display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
  .finish__img { transition: transform var(--duration-slow, 0.6s) var(--ease-editorial); }
  .finish__link:hover .finish__img { transform: scale(1.04); }
  .finish__link:focus-visible { outline: 2px solid var(--color-text); outline-offset: 4px; }
  .finish__meta { display: flex; align-items: center; gap: var(--space-2); }
  .finish__dot { display: inline-flex; flex: none; }
  .finish__dot .swatch { width: 14px; height: 14px; border-radius: 50%; display: block; box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12); background-size: cover; }
  .finish__name { font-size: var(--text-sm); }
  .finish__status { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--color-muted); }

  @media (max-width: 749px) { .finishes__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.finish-gallery.name",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    { "type": "product", "id": "product", "label": "t:sections.finish-gallery.settings.product.label", "info": "t:sections.finish-gallery.settings.product.info" },
    { "type": "text", "id": "option_name", "label": "t:sections.finish-gallery.settings.option_name.label", "info": "t:sections.finish-gallery.settings.option_name.info" },
    { "type": "text", "id": "eyebrow", "label": "t:sections.finish-gallery.settings.eyebrow.label" },
    { "type": "text", "id": "heading", "label": "t:sections.finish-gallery.settings.heading.label", "default": "Compare the finishes" },
    {
      "type": "select", "id": "heading_tag", "label": "t:sections.finish-gallery.settings.heading_tag.label",
      "options": [
        { "value": "h2", "label": "t:sections.finish-gallery.settings.heading_tag.options__1.label" },
        { "value": "h3", "label": "t:sections.finish-gallery.settings.heading_tag.options__2.label" },
        { "value": "p", "label": "t:sections.finish-gallery.settings.heading_tag.options__3.label" }
      ],
      "default": "h2"
    },
    { "type": "checkbox", "id": "show_option_name", "label": "t:sections.finish-gallery.settings.show_option_name.label", "default": true },
    {
      "type": "select", "id": "columns_desktop", "label": "t:sections.finish-gallery.settings.columns_desktop.label",
      "options": [
        { "value": "3", "label": "t:sections.finish-gallery.settings.columns_desktop.options__1.label" },
        { "value": "4", "label": "t:sections.finish-gallery.settings.columns_desktop.options__2.label" },
        { "value": "5", "label": "t:sections.finish-gallery.settings.columns_desktop.options__3.label" }
      ],
      "default": "4"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.finish-gallery.settings.color_scheme.label", "default": "background-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.finish-gallery.settings.padding_top.label", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.finish-gallery.settings.padding_bottom.label", "default": 96 }
  ],
  "presets": [ { "name": "t:sections.finish-gallery.presets.name" } ]
}
{% endschema %}
