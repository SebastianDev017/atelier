{%- comment -%}
  Video feature — one film, played on purpose.

  A pot being thrown is the one thing a photograph cannot do, and it is the
  clearest argument a studio has. So this section is a real player, not a
  muted wallpaper loop: the controls are the browser's or the platform's, and
  the person watching decides when it starts, whether it has sound and when
  it stops.

  Nothing third-party loads until they ask for it. A hosted video ships as a
  poster with metadata only; a YouTube or Vimeo film ships as a poster and a
  template, and the embed is built on the first click. That keeps an outside
  player off the critical path of a page that may never be watched, and it is
  also why the play control is a button rather than an overlay on the image.

  If the merchant turns on the quiet loop, the video still carries controls,
  so it can be paused and unmuted like any other.
{%- endcomment -%}
{%- liquid
  assign scheme = section.settings.color_scheme.id | default: 'background-1'
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign hosted = section.settings.video
  assign external = section.settings.video_url
  assign loop_quietly = section.settings.autoplay_muted
  assign has_video = false
  if hosted != blank or external != blank
    assign has_video = true
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;
    --vf-ratio: {% case section.settings.video_ratio %}{% when 'square' %}1 / 1{% when 'portrait' %}9 / 16{% when 'classic' %}4 / 3{% else %}16 / 9{% endcase %};
  }
</style>

<div class="vidfeat color-scheme--{{ scheme }}">
  <div class="vidfeat__inner {% if section.settings.full_width %}page-width--wide{% else %}page-width{% endif %}">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="vidfeat__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow" data-animate>{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <{{ heading_tag }} class="section-heading heading--lg vidfeat__heading" data-animate>
            {{ section.settings.heading | escape }}
          </{{ heading_tag }}>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="lead vidfeat__text" data-animate>{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if has_video -%}
      <div class="vidfeat__frame" data-vidfeat data-animate>
        {%- if hosted != blank -%}
          {%- comment -%}
            Shopify hosts it, so the browser's own controls are the right
            controls and the poster comes off the media itself.
          {%- endcomment -%}
          {%- if loop_quietly -%}
            {{
              hosted
              | video_tag:
                image_size: '1600x',
                controls: true,
                autoplay: true,
                loop: true,
                muted: true,
                playsinline: true,
                class: 'vidfeat__video'
            }}
          {%- else -%}
            {{
              hosted
              | video_tag:
                image_size: '1600x',
                controls: true,
                autoplay: false,
                loop: false,
                muted: false,
                playsinline: true,
                preload: 'metadata',
                class: 'vidfeat__video'
            }}
          {%- endif -%}
        {%- else -%}
          {%- liquid
            assign embed_title = section.settings.heading
            if embed_title == blank
              assign embed_title = 'sections.video-feature.player_title' | t
            endif
          -%}
          <button class="vidfeat__play" type="button" data-vidfeat-play>
            {%- if section.settings.poster != blank -%}
              {{
                section.settings.poster
                | image_url: width: 1800
                | image_tag:
                  loading: 'lazy',
                  decoding: 'async',
                  widths: '600, 900, 1200, 1500, 1800',
                  sizes: '(min-width: 750px) 90vw, 100vw',
                  alt: '',
                  class: 'vidfeat__poster'
              }}
            {%- endif -%}
            <span class="vidfeat__play-mark" aria-hidden="true">{% render 'icon', name: 'play' %}</span>
            <span class="vidfeat__play-label">{{ 'sections.video-feature.play' | t }}</span>
          </button>
          <template data-vidfeat-embed>
            {%- if external.type == 'youtube' -%}
              <iframe
                class="vidfeat__embed"
                src="https://www.youtube.com/embed/{{ external.id }}?autoplay=1&playsinline=1&rel=0"
                title="{{ embed_title | escape }}"
                allow="autoplay; encrypted-media; picture-in-picture"
                allowfullscreen
              ></iframe>
            {%- else -%}
              <iframe
                class="vidfeat__embed"
                src="https://player.vimeo.com/video/{{ external.id }}?autoplay=1&playsinline=1"
                title="{{ embed_title | escape }}"
                allow="autoplay; encrypted-media; picture-in-picture"
                allowfullscreen
              ></iframe>
            {%- endif -%}
          </template>
        {%- endif -%}
      </div>

      {%- if section.settings.caption != blank -%}
        <p class="caption vidfeat__caption">{{ section.settings.caption | escape }}</p>
      {%- endif -%}
    {%- else -%}
      <p class="caption">{{ 'sections.video-feature.onboarding' | t }}</p>
    {%- endif -%}
  </div>
</div>

<script src="{{ 'video-feature.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .vidfeat { padding-block: var(--pt, 96px) var(--pb, 96px); }
  .vidfeat__heading { margin-top: var(--space-2); }
  .vidfeat__text { max-width: 52ch; margin-top: var(--space-3); color: var(--color-muted); }
  .vidfeat__head + .vidfeat__frame { margin-top: var(--space-8); }

  .vidfeat__frame { position: relative; aspect-ratio: var(--vf-ratio, 16 / 9); background-color: var(--color-subtle); overflow: hidden; }
  .vidfeat__video,
  .vidfeat__embed { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; object-fit: cover; }

  /* The whole poster is the control, so the target is never in doubt, and it
     carries a written label as well as the glyph. */
  .vidfeat__play { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; background-color: var(--color-subtle); cursor: pointer; color: var(--color-text); }
  .vidfeat__poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .vidfeat__play-mark,
  .vidfeat__play-label { position: relative; z-index: 1; }
  .vidfeat__play-mark {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    margin: 0 auto;
    border-radius: 50%;
    background-color: var(--color-bg);
    color: var(--color-text);
    transition: transform var(--duration-base) var(--ease-editorial);
  }
  .vidfeat__play-mark .icon { width: 20px; height: 20px; }
  .vidfeat__play-label {
    display: block;
    margin-top: var(--space-3);
    padding: 0.35em 0.9em;
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .vidfeat__play-label { display: inline-block; }
  .vidfeat__play:hover .vidfeat__play-mark { transform: scale(1.06); }
  .vidfeat__play:focus-visible { outline: 2px solid var(--color-text); outline-offset: -4px; }

  .vidfeat__caption { margin-top: var(--space-4); max-width: 52ch; }

  @media (prefers-reduced-motion: reduce) {
    .vidfeat__play-mark { transition: none; }
    .vidfeat__play:hover .vidfeat__play-mark { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.video-feature.name",
  "tag": "section",
  "class": "shopify-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.video-feature.settings.eyebrow.label", "default": "In the studio" },
    { "type": "text", "id": "heading", "label": "t:sections.video-feature.settings.heading.label", "default": "Watch a piece take shape" },
    {
      "type": "select", "id": "heading_tag", "label": "t:sections.video-feature.settings.heading_tag.label",
      "options": [
        { "value": "h2", "label": "t:sections.video-feature.settings.heading_tag.options__1.label" },
        { "value": "h3", "label": "t:sections.video-feature.settings.heading_tag.options__2.label" },
        { "value": "p", "label": "t:sections.video-feature.settings.heading_tag.options__3.label" }
      ],
      "default": "h2"
    },
    { "type": "text", "id": "text", "label": "t:sections.video-feature.settings.text.label" },
    { "type": "video", "id": "video", "label": "t:sections.video-feature.settings.video.label", "info": "t:sections.video-feature.settings.video.info" },
    { "type": "video_url", "id": "video_url", "accept": ["youtube", "vimeo"], "label": "t:sections.video-feature.settings.video_url.label", "info": "t:sections.video-feature.settings.video_url.info" },
    { "type": "image_picker", "id": "poster", "label": "t:sections.video-feature.settings.poster.label", "info": "t:sections.video-feature.settings.poster.info" },
    {
      "type": "select", "id": "video_ratio", "label": "t:sections.video-feature.settings.video_ratio.label",
      "options": [
        { "value": "wide", "label": "t:sections.video-feature.settings.video_ratio.options__1.label" },
        { "value": "classic", "label": "t:sections.video-feature.settings.video_ratio.options__2.label" },
        { "value": "square", "label": "t:sections.video-feature.settings.video_ratio.options__3.label" },
        { "value": "portrait", "label": "t:sections.video-feature.settings.video_ratio.options__4.label" }
      ],
      "default": "wide"
    },
    { "type": "checkbox", "id": "full_width", "label": "t:sections.video-feature.settings.full_width.label", "default": false },
    { "type": "checkbox", "id": "autoplay_muted", "label": "t:sections.video-feature.settings.autoplay_muted.label", "info": "t:sections.video-feature.settings.autoplay_muted.info", "default": false },
    { "type": "text", "id": "caption", "label": "t:sections.video-feature.settings.caption.label" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.video-feature.settings.color_scheme.label", "default": "background-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.video-feature.settings.padding_top.label", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "t:sections.video-feature.settings.padding_bottom.label", "default": 96 }
  ],
  "presets": [{ "name": "t:sections.video-feature.presets.name" }]
}
{% endschema %}
