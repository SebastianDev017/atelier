{%- comment -%}
  Blog listing "main" section. Renders blog.title as the page heading and
  paginates blog.articles into the base .product-grid. Mirrors the structure
  of rich-text.liquid (gold standard): inline <style> carries instance values
  only, a color-scheme--* wrapper paints the background, {% stylesheet %} holds
  all component CSS with no Liquid, and data-animate drives the global reveal.
{%- endcomment -%}
{%- liquid
  assign scheme = section.settings.color_scheme.id | default: 'background-1'
  assign columns = section.settings.columns_desktop | plus: 0
  assign image_vw = 100 | divided_by: columns
  assign image_sizes = '(min-width: 750px) ' | append: image_vw | append: 'vw, 100vw'
  assign heading_tag = section.settings.heading_tag | default: 'h1'
  assign heading_size = section.settings.heading_size | default: 'lg'
-%}

<style>
  #shopify-section-{{ section.id }} {
    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;
    --grid-columns: {{ section.settings.columns_desktop }};
    --grid-columns-mobile: 1;
  }
</style>

<div class="blog color-scheme--{{ scheme }}">
  <div class="page-width">
    <header class="blog__head">
      <{{ heading_tag }} class="section-heading heading--{{ heading_size }}" data-animate>{{ blog.title | escape }}</{{ heading_tag }}>
    </header>

    {%- if section.settings.show_tag_filter and blog.all_tags.size > 0 -%}
      {%- comment -%}
        blog.all_tags, not blog.tags: the second one only knows about the view
        you are already in, so once a reader filters to one topic the rest of
        the list would vanish and there would be no way back except the browser
        button. The "all" link is the way out and is always first.
      {%- endcomment -%}
      <nav class="blog__filter" aria-label="{{ 'blog.tags' | t }}" data-animate>
        <ul class="blog__filter-list" role="list">
          <li>
            <a
              class="blog__filter-item{% if current_tags == blank %} is-current{% endif %}"
              href="{{ blog.url }}"
              {% if current_tags == blank %}aria-current="page"{% endif %}
            >{{ 'blog.all_articles' | t }}</a>
          </li>
          {%- for tag in blog.all_tags -%}
            {%- liquid
              assign is_current = false
              if current_tags contains tag
                assign is_current = true
              endif

              # The set of tags this link leads to: the current selection with
              # this one added, or -- if it is already on -- taken back out. A
              # chip is therefore a toggle, and two topics combine instead of
              # replacing each other. handleize is applied per tag, never to
              # the joined string, or the separator would be eaten.
              assign next_handles = ''
              for t in current_tags
                assign t_handle = t | handleize
                unless is_current and t == tag
                  assign next_handles = next_handles | append: t_handle | append: '+'
                endunless
              endfor
              unless is_current
                assign tag_handle = tag | handleize
                assign next_handles = next_handles | append: tag_handle
              endunless
              assign next_handles = next_handles | split: '+' | uniq | join: '+'

              if next_handles == blank
                assign tag_url = blog.url
              else
                assign tag_url = blog.url | append: '/tagged/' | append: next_handles
              endif
            -%}
            <li>
              <a
                class="blog__filter-item{% if is_current %} is-current{% endif %}"
                href="{{ tag_url }}"
                {% if is_current %}aria-current="page"{% endif %}
              >{{ tag | escape }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- paginate blog.articles by section.settings.posts_per_page -%}
      {%- comment -%}
        Two different kinds of nothing. A blog with no posts at all is a fresh
        install and just needs saying; a view that has filtered or paged down
        to nothing needs a way back out, because the reader got here on
        purpose and the tag row alone does not read as an exit.
      {%- endcomment -%}
      {%- if blog.articles.size == 0 -%}
        <div class="blog__empty">
          {%- if blog.articles_count == 0 -%}
            <p class="blog__empty-text">{{ 'sections.main-blog.onboarding' | t }}</p>
          {%- else -%}
            <p class="blog__empty-text">{{ 'sections.main-blog.no_results' | t }}</p>
            <a class="btn btn--outline" href="{{ blog.url }}">{{ 'blog.all_articles' | t }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="product-grid">
        {%- for article in blog.articles -%}
          {%- liquid
            assign delay = forloop.index | modulo: 5 | plus: 1
            assign img_alt = article.title | escape
          -%}
          <article class="blog__article" data-animate data-animate-delay="{{ delay }}">
            {%- if section.settings.show_image -%}
              <a class="blog__media-link" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
                <div class="media media--landscape blog__media">
                  {%- if article.image -%}
                    {{
                      article.image
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy', decoding: 'async',
                        widths: '300, 450, 600, 750, 900, 1200',
                        sizes: image_sizes,
                        alt: img_alt
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder' }}
                  {%- endif -%}
                </div>
              </a>
            {%- endif -%}

            <div class="blog__body">
              {%- liquid
                assign meta = ''
                assign meta_date = article.published_at | date: format: 'month_day_year'
                if section.settings.show_date and section.settings.show_author
                  assign meta = 'blog.article_metadata_html' | t: date: meta_date, author: article.author
                elsif section.settings.show_date
                  assign meta = meta_date
                elsif section.settings.show_author
                  assign meta = article.author
                endif
              -%}
              {%- if meta != blank or blog.comments_enabled? -%}
                {%- comment -%}
                  The comment count is blog post information the Theme Store
                  checklist expects to see, so it is not behind a setting -- it
                  follows blog.comments_enabled?, because a count is only true
                  information on a blog that actually takes comments.
                {%- endcomment -%}
                <p class="blog__meta eyebrow">
                  {{- meta -}}
                  {%- if blog.comments_enabled? -%}
                    {%- if meta != blank %} <span aria-hidden="true">&middot;</span> {% endif -%}
                    {{ 'blog.comments_count' | t: count: article.comments_count }}
                  {%- endif -%}
                </p>
              {%- endif -%}

              <h2 class="blog__article-title h4">
                <a class="blog__article-link" href="{{ article.url }}">{{ article.title | escape }}</a>
              </h2>

              {%- if section.settings.show_excerpt -%}
                {%- assign excerpt = article.excerpt_or_content | strip_html | truncatewords: 24 -%}
                {%- if excerpt != blank -%}
                  <p class="blog__excerpt">{{ excerpt }}</p>
                {%- endif -%}
              {%- endif -%}

              <a class="blog__read-more link-underline" href="{{ article.url }}">{{ 'blog.read_more' | t }}</a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</div>

{% stylesheet %}
  .blog { padding-block: var(--pt, var(--section-spacing)) var(--pb, var(--section-spacing)); }
  .blog__head { max-width: 46rem; margin-bottom: var(--space-12); }
  .blog__empty { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-5); max-width: 46rem; }
  .blog__empty-text { color: var(--color-muted); }

  .blog__filter { margin-top: calc(var(--space-12) * -1 + var(--space-6)); margin-bottom: var(--space-10); }
  /* A long tag list wraps; it never becomes a horizontal rail. A shop with
     thirty topics gets a few quiet rows, all of them reachable by tab, instead
     of twenty-six tags hidden off the right edge of a scroller. */
  .blog__filter-list { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); }
  .blog__filter-item {
    display: inline-flex;
    align-items: center;
    /* 24px is the smallest pointer target the Theme Store accepts. */
    min-height: 24px;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-editorial), border-color var(--duration-fast) var(--ease-editorial);
  }
  .blog__filter-item:hover { color: var(--color-text); border-color: var(--color-text); }
  .blog__filter-item.is-current { color: var(--color-bg); background-color: var(--color-text); border-color: var(--color-text); }
  .blog__filter-item:focus-visible { outline: 2px solid var(--color-text); outline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) {
    .blog__filter-item { transition: none; }
  }
  .blog__media-link { display: block; }
  .blog__media { margin-bottom: var(--space-5); }
  .blog__media img { transition: transform var(--duration-slow) var(--ease-editorial); }
  .blog__article:hover .blog__media img { transform: scale(1.04); }
  .blog__body { display: flex; flex-direction: column; gap: var(--space-3); }
  .blog__meta { margin-bottom: var(--space-1); }
  .blog__article-title { max-width: 28ch; overflow-wrap: break-word; }
  .blog__article-link:hover { text-decoration: underline; text-underline-offset: 0.2em; text-decoration-thickness: 1px; }
  .blog__excerpt { color: var(--color-muted); line-height: var(--leading-normal); max-width: 56ch; }
  .blog__read-more { margin-top: var(--space-2); }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main-blog.name",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.main-blog.settings.heading_tag.label",
      "info": "t:sections.main-blog.settings.heading_tag.info",
      "options": [
        { "value": "h1", "label": "t:sections.main-blog.settings.heading_tag.options__1.label" },
        { "value": "h2", "label": "t:sections.main-blog.settings.heading_tag.options__2.label" },
        { "value": "h3", "label": "t:sections.main-blog.settings.heading_tag.options__3.label" },
        { "value": "h4", "label": "t:sections.main-blog.settings.heading_tag.options__4.label" },
        { "value": "p", "label": "t:sections.main-blog.settings.heading_tag.options__5.label" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.main-blog.settings.heading_size.label",
      "info": "t:sections.main-blog.settings.heading_size.info",
      "options": [
        { "value": "display", "label": "t:sections.main-blog.settings.heading_size.options__1.label" },
        { "value": "xl", "label": "t:sections.main-blog.settings.heading_size.options__2.label" },
        { "value": "lg", "label": "t:sections.main-blog.settings.heading_size.options__3.label" },
        { "value": "md", "label": "t:sections.main-blog.settings.heading_size.options__4.label" },
        { "value": "sm", "label": "t:sections.main-blog.settings.heading_size.options__5.label" },
        { "value": "xs", "label": "t:sections.main-blog.settings.heading_size.options__6.label" },
        { "value": "body", "label": "t:sections.main-blog.settings.heading_size.options__7.label" }
      ],
      "default": "lg"
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "min": 6,
      "max": 24,
      "step": 3,
      "label": "t:sections.main-blog.settings.posts_per_page.label",
      "default": 9
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:sections.main-blog.settings.columns_desktop.label",
      "options": [
        { "value": "2", "label": "t:sections.main-blog.settings.columns_desktop.options__1.label" },
        { "value": "3", "label": "t:sections.main-blog.settings.columns_desktop.options__2.label" }
      ],
      "default": "3"
    },
    { "type": "checkbox", "id": "show_tag_filter", "label": "t:sections.main-blog.settings.show_tag_filter.label", "info": "t:sections.main-blog.settings.show_tag_filter.info", "default": true },
    { "type": "checkbox", "id": "show_image", "label": "t:sections.main-blog.settings.show_image.label", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "t:sections.main-blog.settings.show_date.label", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "t:sections.main-blog.settings.show_author.label", "default": false },
    { "type": "checkbox", "id": "show_excerpt", "label": "t:sections.main-blog.settings.show_excerpt.label", "default": true },
    {"type": "color_scheme", "id": "color_scheme", "label": "t:sections.main-blog.settings.color_scheme.label", "default": "background-1"},
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "t:sections.main-blog.settings.padding_top.label", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "t:sections.main-blog.settings.padding_bottom.label", "default": 96 }
  ]
}
{% endschema %}
