{%- liquid
  assign scheme = section.settings.color_scheme | default: 'cream'
  assign menu = section.settings.menu
-%}

{%- comment -%}
  Localization captured once and emitted at the position the merchant chooses
  (top: below the logo; bottom: below the sidebar icons). Native localization
  forms with submit buttons, enhanced by <localization-dropdown> for the
  open/close behaviour. A matching language/country selector also lives in the
  footer (sections/footer.liquid), so the picker is reachable from both places.

  Merchant setup — to offer additional languages:
    1. Shopify Admin → Settings → Languages → Add language (publish each one).
    2. Online Store → Themes → ⋯ → Edit default theme content to review
       translations (this theme ships en/es/fr/de/it locale files).
    3. Toggle "Show language selector" on in this section (and/or the footer).
  The selector renders only when the store has more than one published
  language, so it stays hidden until step 1 is done.
{%- endcomment -%}
{%- liquid
  assign country_form_id = 'HeaderCountryForm-' | append: section.id
  assign country_list_id = 'HeaderCountryList-' | append: section.id
  assign language_form_id = 'HeaderLanguageForm-' | append: section.id
  assign language_list_id = 'HeaderLanguageList-' | append: section.id
  comment
    Only treat a selector as renderable when it is enabled AND the store
    actually has more than one country / language to switch between — otherwise
    the wrapper would paint an empty bordered box with nothing to choose.
  endcomment
  assign loc_show_country = false
  if section.settings.show_country_selector and localization.available_countries.size > 1
    assign loc_show_country = true
  endif
  assign loc_show_language = false
  if section.settings.show_language_selector and localization.available_languages.size > 1
    assign loc_show_language = true
  endif
-%}
{%- capture localization_block -%}
  {%- if loc_show_country or loc_show_language -%}
    <localization-dropdown>
      <div class="sidebar-localization">
        {%- if loc_show_country -%}
          {%- form 'localization', id: country_form_id -%}
            <div class="localization-selector">
              <button type="button" class="localization-selector__btn" data-localization-trigger aria-haspopup="true" aria-expanded="false" aria-controls="{{ country_list_id }}">
                {{ localization.country.iso_code }}
                <svg class="icon icon--chevron-down" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <ul id="{{ country_list_id }}" class="localization-selector__list" aria-label="{{ 'localization.country_label' | t }}" hidden>
                {%- for country in localization.available_countries -%}
                  <li>
                    <button type="submit" name="country_code" value="{{ country.iso_code }}" class="localization-selector__option{% if country.iso_code == localization.country.iso_code %} is-active{% endif %}"{% if country.iso_code == localization.country.iso_code %} aria-current="true"{% endif %}>
                      {{ country.name }} ({{ country.currency.iso_code }})
                    </button>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endform -%}
        {%- endif -%}

        {%- if loc_show_language -%}
          {%- form 'localization', id: language_form_id -%}
            <div class="localization-selector">
              <button type="button" class="localization-selector__btn" data-localization-trigger aria-haspopup="true" aria-expanded="false" aria-controls="{{ language_list_id }}">
                {{ localization.language.iso_code | upcase }}
                <svg class="icon icon--chevron-down" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <ul id="{{ language_list_id }}" class="localization-selector__list" aria-label="{{ 'localization.language_label' | t }}" hidden>
                {%- for language in localization.available_languages -%}
                  <li>
                    <button type="submit" name="locale_code" value="{{ language.iso_code }}" class="localization-selector__option{% if language.iso_code == localization.language.iso_code %} is-active{% endif %}"{% if language.iso_code == localization.language.iso_code %} aria-current="true"{% endif %}>
                      {{ language.endonym_name }}
                    </button>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endform -%}
        {%- endif -%}
      </div>
    </localization-dropdown>
  {%- endif -%}
{%- endcapture -%}

{%- comment -%} Sticky + full-height column rules live on the section wrapper (the real grid item of .site-layout), using the raw style-tag pattern every other section uses. {%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} { grid-column: 1; }
  {%- comment -%}
    Width of the top-of-screen zones the floating mobile triggers cover, for the
    announcement bar to keep its message (and its controls) out of: menu on the
    inline-start side; cart -- plus the account entry when shown -- on the end.
    12 inset + 44 button + 12 gap = 68; with the account: 12 + 44 + 8 + 44 + 12.
  {%- endcomment -%}
  :root {
    --mobile-triggers-start: 68px;
    --mobile-triggers-end: {% if shop.customer_accounts_enabled and section.settings.show_account %}120px{% else %}68px{% endif %};
  }
  @media (min-width: 769px) {
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
      height: 100svh;
      overflow-y: auto;
      /* overflow-y: auto alone makes overflow-x compute to auto as well, so any
         sideways overflow in the column -- the Annex wordmark, 30px too wide for
         its 180px sidebar -- gave the sidebar a horizontal scrollbar, and on
         classic-scrollbar systems that bar's height then forced a vertical one
         too. The column scrolls vertically or not at all. */
      overflow-x: hidden;
      overscroll-behavior: contain;
      /* position:sticky creates a stacking context; without a z-index it sits
         below .site-main (a later grid item), which would trap the fixed
         search takeover behind page content. Lift the whole header context
         above main content, but keep it below the cart overlay (--z-overlay
         200) so an open cart still dims the sidebar. */
      z-index: var(--z-header);
    }
    {%- comment -%} SB3 -- the collapsed rail is exactly one screen tall; the column never scrolls in that state. {%- endcomment -%}
    html.sidebar-collapsed #shopify-section-{{ section.id }} { overflow-y: hidden; }
  }
</style>

<header-component
  class="sidebar color-scheme--{{ scheme }}{% if section.settings.show_border %} sidebar--bordered{% endif %}"
>
  {%- comment -%}
    Mobile-only trigger. Lives outside the sliding panel and is fixed to the
    top-left so it stays put while the panel translates off-canvas.
  {%- endcomment -%}
  <button
    type="button"
    class="sidebar__toggle header__icon-btn"
    data-menu-toggle
    aria-expanded="false"
    aria-controls="SidebarPanel-{{ section.id }}"
    aria-label="{{ 'accessibility.open_menu' | t }}"
  >
    {% render 'icon', name: 'menu' %}
  </button>

  {%- comment -%}
    Mobile-only cart trigger, fixed to the top-RIGHT corner (mirrors the menu
    toggle top-left). Outside the sliding panel so it stays put while the panel
    translates off-canvas. Opens the cart drawer via the shared [data-cart-toggle]
    handler; the badge updates through [data-cart-count] like the in-drawer cart.
  {%- endcomment -%}
  <a
    class="sidebar__cart-toggle header__icon-btn"
    href="{{ routes.cart_url }}"
    data-cart-toggle
    aria-label="{{ 'general.cart' | t }}"
  >
    {% render 'icon', name: 'cart' %}
    <span class="sidebar__cart-count{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-count aria-hidden="true">{{ cart.item_count }}</span>
  </a>

  {%- comment -%}
    B5 -- mobile-only account entry, pinned beside the mobile cart. The Theme
    Store requires <shopify-account> in the header "visible on both desktop and
    mobile"; at <=768px the sidebar's own instance lives inside the off-canvas
    drawer, so on a phone it only appeared after opening the menu. It cannot
    simply be repositioned: the drawer is transformed, so position: fixed inside
    it is relative to the drawer, not the viewport. This second instance sits
    outside the panel like the menu and cart triggers, and CSS shows exactly one
    of the two at any width.
  {%- endcomment -%}
  {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
    <shopify-account
      class="sidebar__account-toggle"
      {% if section.settings.customer_account_menu != blank %}menu="{{ section.settings.customer_account_menu.handle }}"{% endif %}
    >
      <a
        class="header__icon-btn"
        href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
        aria-label="{{ 'general.account' | t }}"
      >
        {% render 'icon', name: 'account' %}
      </a>
    </shopify-account>
  {%- endif -%}

  {%- comment -%}
    SB3 -- the collapsed rail (desktop only). Top to bottom: the favicon (the
    merchant's, else the theme's own triangle mark -- never the wordmark), a
    divider, the vertical "MENU" control that expands the sidebar again (the
    whole middle of the rail is that one button), a divider, then the space the
    sidebar's own cart / account / search row moves into when collapsed.
    --rail-actions sizes that space to the icons actually rendered. It comes
    BEFORE the panel in the DOM so the tab order runs favicon, MENU, cart,
    account, search -- the order on screen (the panel's hidden parts are
    skipped while collapsed, and the rail is skipped while expanded).
  {%- endcomment -%}
  {%- liquid
    assign rail_actions = 1
    if section.settings.show_search
      assign rail_actions = rail_actions | plus: 1
    endif
    if shop.customer_accounts_enabled and section.settings.show_account
      assign rail_actions = rail_actions | plus: 1
    endif
  -%}
  <div class="sidebar__rail" style="--rail-actions: {{ rail_actions }};" data-sidebar-rail>
    <a class="sidebar__rail-home" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if settings.favicon != blank -%}
        {{ settings.favicon | image_url: width: 64, height: 64 | image_tag: class: 'sidebar__rail-mark', width: 24, height: 24, alt: '', loading: 'lazy' }}
      {%- else -%}
        <svg class="sidebar__rail-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3.5 21.5 20h-19z" fill="currentColor"/></svg>
      {%- endif -%}
    </a>
    <span class="sidebar__rail-divider" aria-hidden="true"></span>
    <button
      type="button"
      class="sidebar__rail-menu"
      data-sidebar-expand
      aria-expanded="false"
      aria-controls="SidebarPanel-{{ section.id }}"
      aria-label="{{ 'accessibility.expand_sidebar' | t }}"
    >
      <span class="sidebar__rail-label" aria-hidden="true">{{ 'general.menu' | t }}</span>
      <span class="sidebar__chevron">{% render 'icon', name: 'chevron-left' %}</span>
    </button>
    <span class="sidebar__rail-divider" aria-hidden="true"></span>
    <span class="sidebar__rail-slot" aria-hidden="true"></span>
  </div>

  <div class="sidebar__panel" id="SidebarPanel-{{ section.id }}" data-menu-drawer>
    <div class="sidebar__head">
      {% render 'header-logo' %}
      {%- comment -%}
        SB1 -- the magnifier + "/" keycap that sat here (one link opening the
        command palette) is gone: the sidebar's search icon opens the same
        palette in both the expanded and the collapsed state, and announces the
        "/" shortcut through aria-keyshortcuts. This corner now holds the
        collapse toggle.
      {%- endcomment -%}
      {%- comment -%}
        SB2 -- collapses the desktop sidebar to the rail below. aria-expanded
        reports the navigation's state (true while this is visible); theme.js
        keeps it and the rail's expand control in sync. Desktop only: at <=768px
        the sidebar is the off-canvas drawer and this is hidden.
      {%- endcomment -%}
      <button
        type="button"
        class="sidebar__collapse header__icon-btn"
        data-sidebar-collapse
        aria-expanded="true"
        aria-controls="SidebarPanel-{{ section.id }}"
        aria-label="{{ 'accessibility.collapse_sidebar' | t }}"
      >
        <span class="sidebar__chevron">{% render 'icon', name: 'chevron-left' %}</span>
      </button>
      <button
        type="button"
        class="sidebar__close header__icon-btn"
        data-menu-close
        aria-label="{{ 'accessibility.close_menu' | t }}"
      >
        {% render 'icon', name: 'close' %}
      </button>
    </div>

    {%- if section.settings.localization_position == 'top' -%}{{ localization_block }}{%- endif -%}

    {%- if menu != blank -%}
      <nav class="sidebar__nav" aria-label="{{ 'general.menu' | t }}">
        <div class="sidebar__progress-track" aria-hidden="true"><div class="sidebar__progress-fill"></div></div>
        {% render 'header-menu', menu: menu, section_id: section.id %}
      </nav>
    {%- endif -%}

    <div class="sidebar__foot">
      {%- comment -%}
        SB3 -- cart, account, search: the order the collapsed rail stacks them
        in, top to bottom. It is the same DOM in both states (this row becomes
        the rail's icon column), so tab order always matches what is on screen
        and <shopify-account> is not instantiated a third time.
      {%- endcomment -%}
      <div class="sidebar__actions">
        <a
          class="header__icon-btn sidebar__cart"
          href="{{ routes.cart_url }}"
          data-cart-toggle
          aria-label="{{ 'general.cart' | t }}"
        >
          {% render 'icon', name: 'cart' %}
          <span
            class="sidebar__cart-count{% if cart.item_count == 0 %} is-empty{% endif %}"
            data-cart-count
            aria-hidden="true"
          >{{ cart.item_count }}</span>
          <span class="visually-hidden" data-cart-count-text aria-live="polite">{{ 'cart.item_count' | t: count: cart.item_count }}</span>
        </a>

        {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
          {%- comment -%}
            <shopify-account> is the platform component: it resolves the logged-in
            vs logged-out destination itself and picks up customer-account features
            without the theme tracking them. The inner <a> is the required fallback
            content, so this still works before the component upgrades. This row is
            inside .sidebar__panel, which is the off-canvas drawer at <=768px, so
            one instance serves both the desktop sidebar and the mobile header.

            B5: `menu` is the documented attribute -- it points the account sheet at
            the same menu customer accounts use, so links a merchant adds there
            (Orders, Profile, anything else) show in the sheet too.
          {%- endcomment -%}
          <shopify-account
            class="sidebar__account-wrap"
            {% if section.settings.customer_account_menu != blank %}menu="{{ section.settings.customer_account_menu.handle }}"{% endif %}
          >
            <a
              class="header__icon-btn sidebar__account"
              href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
              aria-label="{{ 'general.account' | t }}"
            >
              {% render 'icon', name: 'account' %}
            </a>
          </shopify-account>
        {%- endif -%}

        {%- if section.settings.show_search -%}
          {%- comment -%}
            Opens the command palette (search-palette.js, [data-search-palette-open])
            -- the same one "/" opens, which is why it carries aria-keyshortcuts.
            [data-search-toggle] is the fallback: with the palette section
            disabled, header-component opens the search takeover below instead.
          {%- endcomment -%}
          <button
            type="button"
            class="header__icon-btn sidebar__search-btn"
            data-search-toggle
            data-search-palette-open
            aria-keyshortcuts="/"
            aria-expanded="false"
            aria-controls="SearchModal-{{ section.id }}"
            aria-label="{{ 'general.search' | t }}"
          >
            {% render 'icon', name: 'search' %}
          </button>
        {%- endif -%}
      </div>

      {%- unless section.settings.localization_position == 'top' -%}{{ localization_block }}{%- endunless -%}
    </div>
  </div>

  {%- comment -%} Search modal — slides down as a top sheet, mutually exclusive with the menu {%- endcomment -%}
  {%- if section.settings.show_search -%}
    <div class="sidebar__search" id="SearchModal-{{ section.id }}" data-search-modal>
      <div class="sidebar__search-inner">
        {% render 'predictive-search', id: section.id %}
        <button
          type="button"
          class="header__icon-btn sidebar__search-close"
          data-menu-close
          aria-label="{{ 'accessibility.close_search' | t }}"
        >
          {% render 'icon', name: 'close' %}
        </button>
      </div>
    </div>
  {%- endif -%}

  <div class="overlay sidebar__overlay" data-header-overlay tabindex="-1"></div>
</header-component>

{%- if section.settings.show_search -%}
  <script src="{{ 'search.js' | asset_url }}" defer></script>
{%- endif -%}

{% stylesheet %}
  /* ---------- Sidebar shell ---------- */
  .sidebar {
    display: block;
    min-height: 100%;
    background-color: var(--color-bg);
    color: var(--color-text);
  }

  .sidebar__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    min-height: 100svh;
    padding: 20px var(--sidebar-pad, 28px);
    background-color: var(--color-bg);
  }

  .sidebar__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    /* The text wordmark below sizes itself against this row's width (cqi). */
    container-type: inline-size;
  }
  /* Only a TEXT wordmark may wrap the row: when it and the collapse toggle
     cannot share it, the toggle drops under the name instead of being pushed
     out of the column. An image logo keeps the no-wrap row it always had -- it
     shrinks beside the toggle (wrapping let a 320px logo take the whole row on
     the demo store). */
  .sidebar__head:has(.header__logo-text) { flex-wrap: wrap; }

  .sidebar__nav { flex: 1 1 auto; position: relative; padding-left: var(--space-4); }
  /* Real-time scroll-progress line down the nav (GSAP initScrollProgress). */
  .sidebar__progress-track {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-border);
  }
  .sidebar__progress-fill {
    position: absolute;
    inset: 0;
    background: var(--color-text);
    transform: scaleY(0);
    transform-origin: top center;
  }

  /* ---------- Sidebar index navigation ---------- */
  .sidebar-nav__list { display: flex; flex-direction: column; gap: var(--space-5); }
  .nav-link {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    color: var(--color-text);
    transition: color var(--duration-fast) var(--ease-editorial);
  }
  .nav-link:hover { color: var(--color-accent-local); }
  .nav-link::after {
    content: '';
    display: block;
    height: 1px;
    width: 0;
    background-color: currentColor;
    transition: width 0.6s cubic-bezier(0.25, 0.1, 0, 1);
  }
  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after { width: 100%; }
  .nav-link__text {
    font-size: 11px;
    letter-spacing: 0.12em;
    /* Honour the uppercase_nav setting. --uppercase-nav was declared in
       css-variables and base.css but read nowhere, so the toggle -- and the
       Maison preset's uppercase_nav: false -- could never take effect. */
    text-transform: var(--uppercase-nav, uppercase);
    line-height: 1.2;
  }

  .sidebar-nav__sub {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-1);
    padding-left: var(--space-4); /* 16px hierarchy indent relative to parent */
  }
  .sidebar-nav__sublink {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 2px;
    min-height: 32px;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-muted);
    transition: color var(--duration-fast) var(--ease-editorial);
  }
  /* Underline-on-hover, mirroring the main .nav-link animation. */
  .sidebar-nav__sublink::after {
    content: '';
    display: block;
    height: 1px;
    width: 0;
    background-color: currentColor;
    transition: width 0.5s cubic-bezier(0.25, 0.1, 0, 1);
  }
  .sidebar-nav__sublink:hover,
  .sidebar-nav__sublink[aria-current="page"] { color: var(--color-text); }
  .sidebar-nav__sublink:hover::after,
  .sidebar-nav__sublink[aria-current="page"]::after { width: 100%; }

  /* Level 3 — grandchild links nested under a level-2 link: deeper indent, smaller, fainter. */
  .sidebar-nav__sub--level-3 {
    margin-top: 2px;
    padding-left: var(--space-8); /* 32px hierarchy indent relative to parent */
  }
  .sidebar-nav__sublink--level-3 {
    font-size: var(--text-xs);
    opacity: 0.85;
  }

  .sidebar__foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-top: var(--space-6);
  }
  .sidebar--bordered .sidebar__foot { border-top: 1px solid var(--color-border); }

  .sidebar__account-wrap { display: inline-flex; }
  /* B5 -- the account sheet (sign in / create account, the email field and its
     errors, the Orders / Profile links) is Shopify's own UI in a shadow root, so
     no theme selector reaches it; it rendered white, black, system sans, 12px
     corners and a navy accent, whatever the theme. These are the documented
     styling hooks. Page-level colours on purpose (--color-background, not a
     section scheme's --color-bg): the sheet opens over the page, not inside the
     sidebar, and a dark sidebar scheme must not turn it dark. The Shop sign-in
     button inside it is Shop-branded and stays as Shopify draws it. */
  shopify-account {
    --shopify-account-color-background: var(--color-background, #FAF7F2);
    --shopify-account-color-text: var(--color-foreground, #2C1810);
    --shopify-account-color-accent: var(--color-button, var(--color-foreground, #2C1810));
    --shopify-account-color-accent-text: var(--color-button-text, var(--color-background, #FAF7F2));
    /* not derived from color-text: the email field and its label stayed pure black */
    --shopify-account-color-control-text: var(--color-foreground, #2C1810);
    --shopify-account-color-text-subdued: var(--color-muted, #766356);
    --shopify-account-font-body: var(--font-body);
    --shopify-account-font-body-weight: var(--font-body-weight, 400);
    --shopify-account-font-heading: var(--font-heading);
    --shopify-account-font-heading-weight: var(--font-heading-weight, 400);
    --shopify-account-radius-base: var(--radius-inputs, 0px);
    --shopify-account-radius-input: var(--radius-inputs, 0px);
    --shopify-account-radius-button: var(--radius-none, 0);
    --shopify-account-radius-button-small: var(--radius-none, 0);
    --shopify-account-radius-dialog: var(--radius-none, 0);
  }
  .sidebar__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-inline-start: -10px;
  }

  /* ---------- Logo ---------- */
  /* H1 -- the logo is the link home and had no hover state whatsoever. */
  .header__logo { display: inline-flex; align-items: center; line-height: 1; transition: opacity var(--duration-fast) var(--ease-editorial), color var(--duration-fast) var(--ease-editorial); }
  .header__logo:hover { opacity: 0.7; }
  .header__logo:hover .header__logo-text { color: var(--color-accent-local); }
  .header__logo { min-width: 0; max-width: 100%; }
  .header__logo-text {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    /* Never wider than its column: at most --text-lg, less when the longest word
       (--logo-chars) would not fit at ~0.95em per character -- the advance of a
       wide uppercase serif with this tracking (Libre Baskerville measured 0.91).
       It only ever shrinks when there is no room, so a 220px sidebar keeps the
       full size. Annex (180px, uppercase) was 153px wide in a 123px column.
       Floor 14px: an 18-letter single word would otherwise have been set at 7px.
       A name that cannot fit even at the floor breaks onto a second line
       (overflow-wrap: anywhere) rather than being clipped at the column edge. */
    font-size: max(0.875rem, min(var(--text-lg), calc(100cqi / (var(--logo-chars, 8) * 0.95))));
    overflow-wrap: anywhere;
    letter-spacing: var(--tracking-wide);
    text-transform: var(--uppercase-headings);
  }
  .header__logo img { width: var(--logo-width, 150px); height: auto; }

  /* ---------- Cart count ---------- */
  .sidebar__cart { position: relative; }
  .sidebar__cart-count {
    position: absolute;
    top: 4px;
    right: 2px;
    min-width: 1.05rem;
    height: 1.05rem;
    padding: 0 0.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-text);
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 1;
  }
  .sidebar__cart-count.is-empty { display: none; }

  /* ---------- Localization selectors ---------- */
  .sidebar-localization {
    padding: 1rem 0;
    border-top: 1px solid var(--color-border, #E5DDD0);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .localization-selector { position: relative; }
  .localization-selector__btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted, #A0826D);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .localization-selector__btn:hover { color: var(--color-text, #2C1810); }
  .localization-selector__btn .icon { width: 12px; height: 12px; }
  .localization-selector__list {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 0;
    background-color: var(--color-bg, #FAF7F2);
    border: 1px solid var(--color-border, #E5DDD0);
    min-width: 160px;
    padding: 0.5rem 0;
    z-index: 100;
  }
  /* When the selector sits at the TOP of the sidebar (a direct child of the
     panel, not inside the foot), the upward dropup is clipped by the top edge of
     the sidebar/viewport — open it DOWNWARD instead so every option and the full
     border stay visible. When it lives at the bottom (inside the foot) it keeps
     opening upward. The footer selector uses .footer-localization__list and is
     unaffected. */
  .sidebar__panel > localization-dropdown .localization-selector__list {
    top: calc(100% + 0.5rem);
    bottom: auto;
  }
  .localization-selector__list[hidden] { display: none; }
  .localization-selector__option {
    display: block;
    width: 100%;
    padding: 0.4rem 0.875rem;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--color-text, #2C1810);
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .localization-selector__option:hover { background-color: var(--color-bg-secondary, #F0EAE0); }
  .localization-selector__option.is-active { font-weight: 600; }

  /* ---------- Mobile trigger + close (hidden on desktop) ---------- */
  .sidebar__toggle,
  .sidebar__cart-toggle,
  .sidebar__account-toggle,
  .sidebar__close { display: none; }

  /* ---------- Search full-screen takeover ----------
     Sits above the sidebar and everything else (but below the custom cursor
     at z 99997 so the cursor stays visible). Opaque ground, centred input. */
  .sidebar__search {
    position: fixed;
    inset: 0;
    z-index: 9990;
    background-color: var(--color-bg, #FAF7F2);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 6rem;
    padding-inline: var(--page-margin, 1.5rem);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.5rem);
    transition: opacity var(--duration-base) var(--ease-editorial),
                transform var(--duration-base) var(--ease-editorial),
                visibility var(--duration-base);
  }
  .sidebar.header--search-open .sidebar__search { opacity: 1; visibility: visible; transform: translateY(0); }
  .sidebar__search-inner {
    width: min(640px, 100%);
    max-width: 640px;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .sidebar__search-inner predictive-search { flex: 1; }
  /* Editorial search field: large serif input on the open canvas. */
  .sidebar__search .search__input {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    padding-block: var(--space-4);
  }
  .sidebar__search-close {
    position: absolute;
    top: 2rem;
    right: var(--page-margin, 1.5rem);
  }

  /* ---------- Overlay ---------- */
  .sidebar__overlay { z-index: var(--z-overlay); }
  .sidebar.header--menu-open .sidebar__overlay,
  .sidebar.header--search-open .sidebar__overlay { opacity: 1; visibility: visible; }

  /* ---------- Desktop divider ----------
     The sticky and full-height rules are applied to the section wrapper
     element in the style block at the top of this file, so they sit on the
     real grid column. .sidebar fills that column (min-height:100%), so its
     right border spans the full height. */
  @media (min-width: 769px) {
    .sidebar--bordered { border-right: 1px solid var(--color-border); }

    /* Nav block stays LEFT-aligned (no horizontal/text centering). It is kept
       content-height (flex:0 so its left line spans only the items) and is
       vertically centered in the space between the language selector and the
       bottom icon row via auto block margins — the free space distributes
       evenly above and below it. The foot's auto top-margin is cleared here so
       the nav's auto margins (not the foot's) take the free space; the icon row
       still rests at the bottom. Logo, language selector, dividers and the icon
       row are untouched. */
    .sidebar__nav { flex: 0 0 auto; margin-top: auto; margin-bottom: auto; }
    .sidebar__foot { margin-top: 0; }
  }

  /* ---------- SB2-SB7: retractable sidebar (desktop only) ----------
     Two classes on <html>, both set before first paint from localStorage
     (layout/theme.liquid): sidebar-collapsed is what the sidebar LOOKS like
     (these rules), sidebar-rail is how wide it IS (base.css swaps
     --sidebar-width to --sidebar-rail-width, and the grid column, the sticky
     add-to-cart bar and the recently-viewed pill follow). Here: the expanded
     content fades out, the rail fades in, and the cart / account / search row
     is repositioned as the rail's icon column.
     theme.js animates the width (GSAP when AnimSettings.ui allows it) and the
     chevrons; these fades are plain CSS and go instant under reduced motion
     (below) and under the anim_disable_all switch (base.css). */
  .sidebar__collapse,
  .sidebar__rail { display: none; }

  @media (min-width: 769px) {
    .sidebar { position: relative; }
    .sidebar--bordered { --sidebar-border: 1px; }
    /* The panel keeps its expanded width while the column animates, so the logo
       and the nav slide under the column's clip edge instead of re-wrapping on
       every frame. */
    .sidebar__panel { width: calc(var(--sidebar-width-expanded, var(--sidebar-width)) - var(--sidebar-border, 0px)); }

    /* SB2 -- the toggle takes the head's end corner. Negative margins keep the
       44px target from making the row taller than the wordmark. */
    .sidebar__collapse {
      display: inline-flex;
      flex: none;
      margin-block: -10px;
      margin-inline: auto -12px;
      color: var(--color-muted);
    }
    .sidebar__collapse:hover { color: var(--color-text); }
    .sidebar__chevron { display: inline-flex; transition: transform 0.3s var(--ease-editorial); }
    .sidebar__chevron .icon { width: 16px; height: 16px; }
    html.sidebar-collapsed .sidebar__chevron { transform: rotate(180deg); }
    /* GSAP owns the rotation while it runs; a CSS transition on the same
       property would fight it. */
    html.sidebar-gsap .sidebar__chevron { transition: none; }
    [dir="rtl"] .sidebar__chevron { scale: -1 1; }

    /* SB3 -- the rail. It sits over the panel's left edge and is exactly one
       screen tall. */
    .sidebar__rail {
      display: flex;
      flex-direction: column;
      align-items: center;
      position: absolute;
      inset-block: 0;
      inset-inline-start: 0;
      z-index: 1;
      width: var(--sidebar-rail-width, 64px);
      padding-block: 20px;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.2s var(--ease-editorial), visibility 0s linear 0.2s;
    }
    .sidebar__rail-home {
      display: inline-flex;
      flex: none;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      color: var(--color-text);
      transition: opacity var(--duration-fast) var(--ease-editorial);
    }
    .sidebar__rail-home:hover { opacity: 0.7; }
    .sidebar__rail-mark { width: 24px; height: 24px; object-fit: contain; }
    .sidebar__rail-divider {
      display: block;
      flex: none;
      width: 24px;
      height: 1px;
      margin-block: var(--space-4);
      background-color: var(--color-border);
    }
    /* The whole middle of the rail is the one expand control. */
    .sidebar__rail-menu {
      display: flex;
      flex: 1 1 auto;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      width: 100%;
      min-height: 96px;
      padding: 0;
      background: none;
      border: 0;
      color: var(--color-text);
      cursor: pointer;
      transition: color var(--duration-fast) var(--ease-editorial);
    }
    .sidebar__rail-menu:hover { color: var(--color-accent-local); }
    .sidebar__rail-menu:focus-visible { outline-offset: -4px; }
    /* "MENU" is a horizontal string turned a quarter turn with a transform.
       rotate(90deg) -- a clockwise quarter turn in CSS -- stacks it M-E-N-U
       from the top; the brief asks for U-N-E-M top to bottom (read upward,
       like a spine), which is the counter-clockwise turn. The block margins
       give the turned word the height the transform does not claim in layout. */
    .sidebar__rail-label {
      display: block;
      margin-block: 1.8em;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.24em;
      line-height: 1;
      text-transform: uppercase;
      white-space: nowrap;
      transform: rotate(-90deg);
    }
    .sidebar__rail-slot {
      display: block;
      flex: none;
      height: calc(var(--rail-actions, 3) * 44px + (var(--rail-actions, 3) - 1) * var(--space-2));
    }

    /* Expanded content: fades back in (a beat after the column starts to grow).
       Every selector here ends in a class or tag on purpose: html.sidebar-
       collapsed flips at the start of the motion, and a bare :not() at the end
       of a selector would make that one class change restyle the whole page. */
    .sidebar__head,
    .sidebar__nav,
    .sidebar__panel > localization-dropdown,
    .sidebar__foot > localization-dropdown {
      transition: opacity 0.25s var(--ease-editorial) 0.1s, visibility 0s;
    }

    /* ---- collapsed ---- */
    html.sidebar-collapsed .sidebar { height: 100svh; overflow: hidden; }
    html.sidebar-collapsed .sidebar__rail {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.25s var(--ease-editorial) 0.1s, visibility 0s;
    }
    html.sidebar-collapsed .sidebar__head,
    html.sidebar-collapsed .sidebar__nav,
    html.sidebar-collapsed .sidebar__panel > localization-dropdown,
    html.sidebar-collapsed .sidebar__foot > localization-dropdown {
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.15s var(--ease-editorial), visibility 0s linear 0.15s;
    }
    html.sidebar-collapsed .sidebar__foot { border-top-color: transparent; }
    /* The same cart / account / search row, restacked in the rail's slot. */
    html.sidebar-collapsed .sidebar__actions {
      position: absolute;
      z-index: 2;
      inset-inline-start: 0;
      bottom: 20px;
      width: var(--sidebar-rail-width, 64px);
      flex-direction: column;
      gap: var(--space-2);
      margin: 0;
    }
    /* The row cannot glide into a column, so it fades in on every toggle. */
    html.sidebar-animating .sidebar__actions { animation: sidebar-actions-in 0.3s var(--ease-editorial) both; }
    @keyframes sidebar-actions-in { from { opacity: 0; } to { opacity: 1; } }
  }
  @media (min-width: 769px) and (prefers-reduced-motion: reduce) {
    .sidebar__chevron,
    .sidebar__rail,
    html.sidebar-collapsed .sidebar__rail,
    .sidebar__head,
    .sidebar__nav,
    .sidebar__panel > localization-dropdown,
    .sidebar__foot > localization-dropdown,
    html.sidebar-collapsed .sidebar__head,
    html.sidebar-collapsed .sidebar__nav,
    html.sidebar-collapsed .sidebar__panel > localization-dropdown,
    html.sidebar-collapsed .sidebar__foot > localization-dropdown { transition: none; }
    html.sidebar-animating .sidebar__actions { animation: none; }
  }

  /* ---------- Mobile: off-canvas drawer ---------- */
  @media (max-width: 768px) {
    .sidebar { display: contents; }

    .sidebar__toggle {
      display: inline-flex;
      position: fixed;
      top: var(--space-3);
      left: var(--space-3);
      z-index: var(--z-header);
      /* Use the scheme-resolved tokens (which carry fallbacks) so the button
         keeps a solid background even when the brand color settings are nil. */
      background-color: var(--color-bg);
      color: var(--color-text);
      /* Measured at 375px: the button's fill IS --color-bg, so on every light
         section it sat at 1.01-1.10:1 against its own backdrop, and the 1px
         --color-border ring (12% ink) was invisible. --color-border-strong
         (50% ink) puts the control's BOUNDARY at ~3.3:1, which is what WCAG
         1.4.11 actually asks of a UI component; the fill already clears 5.9:1
         wherever the backdrop is an image. The soft shadow makes it read as
         floating rather than painted on.

         Deliberately NOT a translucent fill + backdrop-filter: blur(). The
         fill is already fully opaque, and 85%-opacity cream over a cream page
         is still cream -- blurring a flat backdrop changes nothing measurable.
         The problem was never transparency, it was that two near-identical
         creams meet with no boundary. */
      box-shadow: 0 0 0 1px var(--color-border-strong),
                  0 2px 8px color-mix(in srgb, var(--color-text) 12%, transparent);
    }
    /* Cart trigger mirrors the menu toggle, pinned to the opposite (right) corner. */
    .sidebar__cart-toggle {
      display: inline-flex;
      position: fixed;
      top: var(--space-3);
      right: var(--space-3);
      z-index: var(--z-header);
      background-color: var(--color-bg);
      color: var(--color-text);
      /* Measured at 375px: the button's fill IS --color-bg, so on every light
         section it sat at 1.01-1.10:1 against its own backdrop, and the 1px
         --color-border ring (12% ink) was invisible. --color-border-strong
         (50% ink) puts the control's BOUNDARY at ~3.3:1, which is what WCAG
         1.4.11 actually asks of a UI component; the fill already clears 5.9:1
         wherever the backdrop is an image. The soft shadow makes it read as
         floating rather than painted on.

         Deliberately NOT a translucent fill + backdrop-filter: blur(). The
         fill is already fully opaque, and 85%-opacity cream over a cream page
         is still cream -- blurring a flat backdrop changes nothing measurable.
         The problem was never transparency, it was that two near-identical
         creams meet with no boundary. */
      box-shadow: 0 0 0 1px var(--color-border-strong),
                  0 2px 8px color-mix(in srgb, var(--color-text) 12%, transparent);
    }
    /* B5 -- account entry in the mobile bar, left of the cart. Logical
       inset-inline-end so it mirrors itself under dir="rtl". The drawer's own
       instance is hidden at this width so a phone never shows two avatars. */
    .sidebar__account-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: fixed;
      top: var(--space-3);
      inset-inline-end: calc(var(--space-3) + 44px + var(--space-2));
      z-index: var(--z-header);
      width: 44px;
      height: 44px;
      background-color: var(--color-bg);
      color: var(--color-text);
      box-shadow: 0 0 0 1px var(--color-border-strong),
                  0 2px 8px color-mix(in srgb, var(--color-text) 12%, transparent);
    }
    .sidebar__panel .sidebar__account-wrap { display: none; }
    .sidebar__close { display: inline-flex; }

    .sidebar__panel {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      /* Full-screen drawer on mobile with a solid scheme background. */
      width: 100%;
      z-index: var(--z-drawer);
      overflow-y: auto;
      transform: translateX(-100%);
      /* Translated off-screen is still focusable: without this a keyboard user
         tabs through the whole invisible menu before reaching page content. */
      visibility: hidden;
      pointer-events: none;
      transition: transform var(--duration-base) var(--ease-editorial), visibility 0s linear var(--duration-base);
    }
    .sidebar.header--menu-open .sidebar__panel {
      transform: translateX(0);
      visibility: visible;
      pointer-events: auto;
      transition: transform var(--duration-base) var(--ease-editorial), visibility 0s;
    }

    /* Meet the 44px touch-target minimum in the off-canvas drawer */
    .nav-link,
    .sidebar-nav__sublink { min-height: 44px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.header.name",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.header.settings.menu.label",
      "default": "main-menu",
      "info": "t:sections.header.settings.menu.info"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:sections.header.settings.show_search.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "t:sections.header.settings.show_account.label",
      "default": true
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:sections.header.settings.customer_account_menu.label",
      "info": "t:sections.header.settings.customer_account_menu.info",
      "default": "customer-account-main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "t:sections.header.settings.show_border.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.header.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "t:sections.header.settings.show_country_selector.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_language_selector",
      "label": "t:sections.header.settings.show_language_selector.label",
      "default": true
    },
    {
      "type": "select",
      "id": "localization_position",
      "label": "t:sections.header.settings.localization_position.label",
      "options": [
        { "value": "bottom", "label": "t:sections.header.settings.localization_position.options__1.label" },
        { "value": "top", "label": "t:sections.header.settings.localization_position.options__2.label" }
      ],
      "default": "bottom"
    },
    {
      "type": "header",
      "content": "t:sections.header.settings.header__2.content"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.header.settings.color_scheme.label",
      "options": [
        { "value": "cream", "label": "t:sections.header.settings.color_scheme.options__1.label" },
        { "value": "parchment", "label": "t:sections.header.settings.color_scheme.options__2.label" },
        { "value": "linen", "label": "t:sections.header.settings.color_scheme.options__3.label" },
        { "value": "white", "label": "t:sections.header.settings.color_scheme.options__4.label" },
        { "value": "invert", "label": "t:sections.header.settings.color_scheme.options__5.label" }
      ],
      "default": "cream"
    }
  ]
}
{% endschema %}
