<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {%- comment -%} meta-tags emits <meta charset> — it must stay within the first 1024 bytes. {%- endcomment -%}
    {% render 'meta-tags' %}

    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>


    {%- if settings.body_font.system? == false -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endif -%}

    {% if settings.favicon %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {% endif %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    {%- comment -%}
      css-variables must render after base.css: both declare :root, so the
      later one wins. Rendering it first let base.css overwrite the settings.
    {%- endcomment -%}
    {% render 'css-variables' %}


    {{ content_for_header }}
  </head>

  <body class="template-password color-scheme--background-1">
    <main id="main-content">
      {{ content_for_layout }}
    </main>

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
