<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {%- comment -%}
      meta-tags emits <meta charset> first. It must stay at the very top of
      <head>: browsers only honour the encoding declaration inside the first
      1024 bytes, and the css-variables {% style %} block below is larger
      than that on its own.
    {%- endcomment -%}
    {% render 'meta-tags' %}

    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
      /* SB5 -- the retractable sidebar's state, applied before first paint so a
         collapsed sidebar never flashes open. Desktop CSS reads the class; the
         mobile drawer ignores it. Same storage pattern as the collection view. */
      try { if (localStorage.getItem('contour-sidebar-collapsed') === '1') document.documentElement.classList.add('sidebar-collapsed', 'sidebar-rail'); } catch (e) {}
    </script>
    {%- comment -%} <body> carries data-* flags (smooth-scroll, custom-cursor, hover-swap) consumed by theme.js (STEP 4). {%- endcomment -%}

    {%- if settings.body_font.system? == false -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endif -%}

    <meta name="referrer" content="strict-origin-when-cross-origin">

    {%- comment -%}
      Always emit a favicon link so the browser never falls back to requesting
      /favicon.ico (a 404 there logs a console error and costs a Lighthouse
      Best-Practices point). Uses the merchant favicon when set, else an inline
      SVG mark so there is always a real icon.
    {%- endcomment -%}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%E2%96%B2%3C/text%3E%3C/svg%3E">
    {%- endif -%}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    {%- comment -%}
      css-variables MUST render after base.css. Both declare :root, so they
      have equal specificity and the later one wins — rendering it first let
      base.css's own defaults silently overwrite every merchant setting
      (fonts, page width, sidebar width, spacing, casing, scales).
    {%- endcomment -%}
    {% render 'css-variables' %}

    {%- if settings.enable_view_transitions -%}
      <style>
        @view-transition { navigation: auto; }
        ::view-transition-old(root) { animation: 200ms ease both atelier-vt-out; }
        ::view-transition-new(root) { animation: 250ms ease both atelier-vt-in; }
        @keyframes atelier-vt-out { to { opacity: 0; } }
        @keyframes atelier-vt-in { from { opacity: 0; } }
        /* Fallback for browsers without cross-document View Transitions (page-transitions.js). */
        html.is-leaving { opacity: 0; transition: opacity 0.26s ease; }
        @media (prefers-reduced-motion: reduce) {
          ::view-transition-old(root),
          ::view-transition-new(root) { animation: none; }
          html.is-leaving { opacity: 1; transition: none; }
        }
      </style>
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body
    class="template-{{ request.page_type | handle }}"
    data-scroll-animations="{{ settings.enable_scroll_animations }}"
    data-smooth-scroll="{{ settings.enable_smooth_scroll }}"
    data-anim-disable-all="{{ settings.anim_disable_all }}"
    data-custom-cursor="{{ settings.enable_custom_cursor }}"
    data-hover-swap="{{ settings.enable_hover_image_swap }}"
    data-button-style="{{ settings.button_style }}"
  >
    {% render 'loader' %}

    <a class="skip-link" href="#main-content">{{ 'general.skip_to_content' | t }}</a>

    <div class="site-layout">
      {% sections 'header-group' %}

      <div class="site-main">
        {% sections 'announcement-group' %}

        <main id="main-content" tabindex="-1">
          {{ content_for_layout }}
        </main>

        {% sections 'footer-group' %}
      </div>
    </div>

    {%- if settings.cart_type == 'drawer' -%}
      {% render 'cart-drawer' %}
    {%- endif -%}

    {% section 'search-palette' %}

    {%- comment -%} Render unless explicitly disabled: the setting is nil on a fresh/GitHub-synced theme (not in settings_data), and `{% if nil %}` would hide the cursor by default. `!= false` shows it by default while still honouring an explicit off. {%- endcomment -%}
    {%- if settings.enable_custom_cursor -%}{% render 'cursor' %}{%- endif -%}

    {% render 'scroll-top' %}

    {% render 'recently-viewed' %}

    {%- comment -%}
      First script on the page: every other one reads window.AnimSettings to
      decide whether its motion runs, so it has to exist before any of them.
      Deferred like the rest, so <body> (and its data-* flags) is parsed by the
      time this executes.
    {%- endcomment -%}
    <script src="{{ 'anim-settings.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'cart.js' | asset_url }}" defer></script>
    <script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
    {%- comment -%}
      GSAP 3.13 motion stack — self-hosted (the Theme Store disallows external
      script CDNs). Deferred scripts execute in document order, so gsap-init
      always runs after the libraries it registers.

      The two plugins load only where they are used, rather than on every page:

        SplitText — gsap-animations.js initSplitText, which targets [data-split].
                    That attribute appears in editorial-feature, featured-product,
                    maker-spotlight and related-products.
        Flip      — theme.js FacetForm (facets render on collection and search)
                    and collection-view.js (the collection grid/list toggle).
                    bundle.js was checked and uses neither.

      Every consumer is guarded (`window.Flip &&`, `if (!window.SplitText) return`),
      so on a template where a plugin is absent the effect degrades to an instant
      swap instead of erroring. A merchant who adds one of the [data-split]
      sections to another template loses the line reveal, not the content.
    {%- endcomment -%}
    <script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
    <script src="{{ 'scrolltrigger.min.js' | asset_url }}" defer></script>
    {%- if template.name == 'index' or template.name == 'product' -%}
      <script src="{{ 'splittext.min.js' | asset_url }}" defer></script>
    {%- endif -%}
    {%- if template.name == 'collection' or template.name == 'search' -%}
      <script src="{{ 'flip.min.js' | asset_url }}" defer></script>
    {%- endif -%}
    <script src="{{ 'gsap-init.js' | asset_url }}" defer></script>
    {%- comment -%}
      After gsap-init.js: cursor.js drives the dot with gsap.quickTo, so gsap must
      already be parsed. Emitted only when the setting is on, so the default
      install (enable_custom_cursor: false) ships none of it.
    {%- endcomment -%}
    {%- if settings.enable_custom_cursor -%}<script src="{{ 'cursor.js' | asset_url }}" defer></script>{%- endif -%}
    <script src="{{ 'gsap-animations.js' | asset_url }}" defer></script>
    <script src="{{ 'search-palette.js' | asset_url }}" defer></script>
    {%- comment -%} Drives the main-collection grid/list toggle. main-collection is a main-* section with no preset, so it can only appear here. {%- endcomment -%}
    {%- if template.name == 'collection' -%}<script src="{{ 'collection-view.js' | asset_url }}" defer></script>{%- endif -%}
    <script src="{{ 'press-marquee.js' | asset_url }}" defer></script>
    <script src="{{ 'recently-viewed.js' | asset_url }}" defer></script>
    <script src="{{ 'featured-product.js' | asset_url }}" defer></script>
    {%- if template.name == 'product' -%}<script src="{{ 'pickup-availability.js' | asset_url }}" defer></script>{%- endif -%}
    <script src="{{ 'bundle.js' | asset_url }}" defer></script>
    <script src="{{ 'collection-recs.js' | asset_url }}" defer></script>
    {%- if settings.enable_view_transitions -%}<script src="{{ 'page-transitions.js' | asset_url }}" defer></script>{%- endif -%}
  </body>
</html>
