<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {%- comment -%}
      meta-tags emits <meta charset> first. It must stay at the very top of
      <head>: browsers only honour the encoding declaration inside the first
      1024 bytes, and the css-variables {% style %} block below is larger
      than that on its own.
    {%- endcomment -%}
    {% render 'meta-tags' %}

    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
      /* SB5 -- the retractable sidebar's state, applied before first paint so a
         collapsed sidebar never flashes open. Desktop CSS reads the class; the
         mobile drawer ignores it. Same storage pattern as the collection view. */
      try { if (localStorage.getItem('contour-sidebar-collapsed') === '1') document.documentElement.classList.add('sidebar-collapsed', 'sidebar-rail'); } catch (e) {}
      {%- if settings.enable_view_transitions %}
      /* A native page transition is skipped when the other page does not opt in
         (Shopify's checkout, for one); its promises then reject and Chrome
         reports them as uncaught. They are handled here, in <head>, because
         pagereveal fires at the page's first rendering opportunity, before the
         theme's scripts (loaded after the first paint) exist. */
      if (window.CSS && CSS.supports && CSS.supports('selector(::view-transition)')) {
        var settleViewTransition = function (e) {
          var vt = e.viewTransition; if (!vt) return;
          ['ready', 'finished', 'updateCallbackDone'].forEach(function (k) { if (vt[k] && vt[k].catch) vt[k].catch(function () {}); });
        };
        window.addEventListener('pageswap', settleViewTransition);
        window.addEventListener('pagereveal', settleViewTransition);
      }
      {%- endif %}
    </script>
    {%- comment -%} <body> carries data-* flags (smooth-scroll, custom-cursor, hover-swap) consumed by theme.js (STEP 4). {%- endcomment -%}

    {%- if settings.body_font.system? == false -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endif -%}

    <meta name="referrer" content="strict-origin-when-cross-origin">

    {%- comment -%}
      Always emit a favicon link so the browser never falls back to requesting
      /favicon.ico (a 404 there logs a console error and costs a Lighthouse
      Best-Practices point). Uses the merchant favicon when set, else an inline
      SVG mark so there is always a real icon.
    {%- endcomment -%}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%E2%96%B2%3C/text%3E%3C/svg%3E">
    {%- endif -%}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'base-components.css' | asset_url | stylesheet_tag }}

    {%- comment -%}
      css-variables MUST render after base.css. Both declare :root, so they
      have equal specificity and the later one wins — rendering it first let
      base.css's own defaults silently overwrite every merchant setting
      (fonts, page width, sidebar width, spacing, casing, scales).
    {%- endcomment -%}
    {% render 'css-variables' %}

    {%- if settings.enable_view_transitions -%}
      <style>
        @view-transition { navigation: auto; }
        ::view-transition-old(root) { animation: 200ms ease both atelier-vt-out; }
        ::view-transition-new(root) { animation: 250ms ease both atelier-vt-in; }
        @keyframes atelier-vt-out { to { opacity: 0; } }
        @keyframes atelier-vt-in { from { opacity: 0; } }
        /* Fallback for browsers without cross-document View Transitions (page-transitions.js). */
        html.is-leaving { opacity: 0; transition: opacity 0.26s ease; }
        @media (prefers-reduced-motion: reduce) {
          ::view-transition-old(root),
          ::view-transition-new(root) { animation: none; }
          html.is-leaving { opacity: 1; transition: none; }
        }
      </style>
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body
    class="template-{{ request.page_type | handle }}"
    data-scroll-animations="{{ settings.enable_scroll_animations }}"
    data-smooth-scroll="{{ settings.enable_smooth_scroll }}"
    data-anim-disable-all="{{ settings.anim_disable_all }}"
    data-custom-cursor="{{ settings.enable_custom_cursor }}"
    data-hover-swap="{{ settings.enable_hover_image_swap }}"
    data-button-style="{{ settings.button_style }}"
  >
    {%- comment -%}
      The first-visit loading screen is opt-in. It covers the whole page until it
      fades, which Shopify's performance guidance names the single most
      impactful animation-related LCP issue ("Don't hide the LCP image behind
      animations"). Measured with Lighthouse mobile on the live product pages:
      when the HTML arrives quickly, the first paint waited for the loader to
      fade, 2.43 s against 1.52 s without it. The master animation switch turns
      it off too.
    {%- endcomment -%}
    {%- if settings.enable_loading_screen and settings.anim_disable_all != true -%}
      {% render 'loader' %}
    {%- endif -%}

    {%- comment -%} Wrapped in a nav landmark: as a bare child of <body> it was the one bit of content outside every landmark (axe: region). Still the first focusable element on the page. {%- endcomment -%}
    <nav class="skip-nav" aria-label="{{ 'general.skip_to_content' | t }}">
      <a class="skip-link" href="#main-content">{{ 'general.skip_to_content' | t }}</a>
    </nav>

    <div class="site-layout">
      {% sections 'header-group' %}

      <div class="site-main">
        {% sections 'announcement-group' %}

        <main id="main-content" tabindex="-1">
          {{ content_for_layout }}
        </main>

        {% sections 'footer-group' %}
      </div>
    </div>

    {%- if settings.cart_type == 'drawer' -%}
      {% render 'cart-drawer' %}
    {%- endif -%}
    {%- if settings.card_quick_buy != false -%}{% render 'quick-buy-modal' %}{%- endif -%}

    {% section 'search-palette' %}

    {%- comment -%} Render unless explicitly disabled: the setting is nil on a fresh/GitHub-synced theme (not in settings_data), and `{% if nil %}` would hide the cursor by default. `!= false` shows it by default while still honouring an explicit off. {%- endcomment -%}
    {%- if settings.enable_custom_cursor -%}{% render 'cursor' %}{%- endif -%}

    {% render 'scroll-top' %}

    {% render 'recently-viewed' %}

    {%- comment -%}
      The theme's JavaScript loads AFTER the first contentful paint.

      Every script here used to be a deferred tag, and deferred scripts run
      before DOMContentLoaded. When the HTML arrives in one burst (a fast
      connection, the condition Shopify's benchmark is most likely to see),
      Chrome then paints only after all of them have run, and Lighthouse's
      mobile simulation counts every request and script evaluation that ends
      before the observed paint toward LCP: the same page scored about 90 when
      it painted mid-parse and 60-70 when it painted after the scripts. Nothing
      here is needed to paint the page -- forms, links and <details> work
      without it, and gsap-animations.js leaves content that is already on
      screen as it is -- so it is requested once the first contentful paint is
      in, in the same order (ordered dynamic scripts, async = false).

      The order matters: anim-settings.js first (every other file reads
      window.AnimSettings); the GSAP libraries before gsap-init.js, which
      registers them; gsap-init.js before cursor.js (gsap.quickTo) and
      gsap-animations.js. Scripts a section queued with the script-after-paint
      snippet (search.js in the header, ...) load first, as their deferred tags
      did. The plugins load only where they are used: SplitText for
      [data-split] (index and product templates), Flip for facets and the grid
      toggle (collection and search). Every consumer is guarded, so where one is
      absent the effect degrades to an instant swap.

      Fallbacks: a browser without paint timing starts after the first frame
      following DOMContentLoaded; a page that never paints (a background tab)
      starts after 3 s. In the theme editor every script is a plain deferred tag,
      as before, so editor events always find their listeners.
    {%- endcomment -%}
    {%- liquid
      assign theme_scripts = 'anim-settings.js,theme.js,cart.js,tooltip.js,tabs.js,compare-slider.js,horizontal-scroll-nav.js,collection-showcase.js,product-card.js,product.js'
      if settings.card_quick_buy != false
        assign theme_scripts = theme_scripts | append: ',quick-buy.js'
      endif
      assign theme_scripts = theme_scripts | append: ',lenis.min.js,gsap.min.js,scrolltrigger.min.js'
      if template.name == 'index' or template.name == 'product'
        assign theme_scripts = theme_scripts | append: ',splittext.min.js'
      endif
      if template.name == 'collection' or template.name == 'search'
        assign theme_scripts = theme_scripts | append: ',flip.min.js'
      endif
      assign theme_scripts = theme_scripts | append: ',gsap-init.js'
      if settings.enable_custom_cursor
        assign theme_scripts = theme_scripts | append: ',cursor.js'
      endif
      assign theme_scripts = theme_scripts | append: ',gsap-animations.js,search-palette.js'
      if template.name == 'collection'
        assign theme_scripts = theme_scripts | append: ',collection-view.js'
      endif
      assign theme_scripts = theme_scripts | append: ',recently-viewed.js,featured-product.js'
      if template.name == 'product'
        assign theme_scripts = theme_scripts | append: ',pickup-availability.js'
      endif
      assign theme_scripts = theme_scripts | append: ',bundle.js,collection-recs.js'
      if settings.enable_view_transitions
        assign theme_scripts = theme_scripts | append: ',page-transitions.js'
      endif
      assign theme_scripts = theme_scripts | split: ','
    -%}
    {%- if request.design_mode -%}
      {%- for theme_script in theme_scripts -%}
        <script src="{{ theme_script | asset_url }}" defer></script>
      {%- endfor -%}
    {%- else -%}
      <script>
        (function () {
          var scripts = [{%- for theme_script in theme_scripts -%}{{ theme_script | asset_url | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}];
          var started = false;
          function add(src) {
            var el = document.createElement('script');
            el.src = src;
            el.async = false;
            document.body.appendChild(el);
          }
          function start() {
            if (started) return;
            started = true;
            var queued = Array.isArray(window.ThemeScriptQueue) ? window.ThemeScriptQueue : [];
            queued.concat(scripts).forEach(add);
            window.ThemeScriptQueue = { push: add };
          }
          var paintTiming = window.PerformanceObserver && PerformanceObserver.supportedEntryTypes && PerformanceObserver.supportedEntryTypes.indexOf('paint') !== -1;
          if (paintTiming) {
            new PerformanceObserver(function (list, observer) {
              if (list.getEntriesByName('first-contentful-paint').length) { observer.disconnect(); start(); }
            }).observe({ type: 'paint', buffered: true });
          } else {
            var afterFrame = function () { requestAnimationFrame(function () { setTimeout(start, 0); }); };
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', afterFrame);
            else afterFrame();
          }
          setTimeout(start, 3000);
        })();
      </script>
    {%- endif -%}
  </body>
</html>
